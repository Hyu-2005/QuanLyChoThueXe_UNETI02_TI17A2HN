@* Partial này nhận List<double> và render SVG *@

<style>
    /* ============================================================
       DASHBOARD BASE
       ============================================================ */
    .db-hero,
    .db-stats,
    .db-grid {
        max-width: 1480px;
        margin-left: auto;
        margin-right: auto;
    }

    /* ============================================================
       HERO SECTION
       ============================================================ */
    .db-hero { margin-bottom: 24px; }
    .db-hero-grid {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        gap: 32px;
        align-items: center;
        padding: 20px 28px;
        background: linear-gradient(135deg, #eff6ff 0%, #f5f3ff 100%);
        border-radius: 20px;
        border: 1px solid #e0e7ff;
        min-height: 140px;
    }
