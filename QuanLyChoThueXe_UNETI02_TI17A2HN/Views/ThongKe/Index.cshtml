@*
    Index.cshtml - Dashboard tong quan
    Họ và tên: Duong Lam Huy
    Mã sinh viên: 23103100120
    Nội dung thực hiện: Dashboard hiển thị tổng quan hệ thống
    Module: Module 5 - Tính tiền, Thanh toán, Lịch sử, Thống kê
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.ThongKe.DashboardVM
@{
    ViewData["Title"] = "Dashboard";
    var now = DateTime.Now;
}

<style>
    .dashboard-shell {
        background: #f5f7fa;
        min-height: 100vh;
        padding: 28px 0 40px;
    }
    .dashboard-wrap {
        max-width: 1480px;
        margin: 0 auto;
        padding: 0 28px;
    }

    /* ============ HEADER ============ */
    .db-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 28px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e5e7eb;
    }
    .db-header .greeting {
        font-size: 13px;
        color: #64748b;
        font-weight: 500;
        margin-bottom: 4px;
    }
    .db-header h1 {
        font-size: 28px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.6px;
        margin: 0;
    }
    .db-header .sub {
        font-size: 14px;
        color: #64748b;
        margin: 6px 0 0 0;
    }
    .db-header .actions {
        display: flex;
        gap: 10px;
    }
    .db-header .actions a {
        padding: 10px 20px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: all .15s;
    }
    .db-header .actions .btn-outline {
        background: #fff;
        border: 1px solid #d1d5db;
        color: #334155;
    }
    .db-header .actions .btn-outline:hover {
        border-color: #9ca3af;
        background: #f9fafb;
        color: #111827;
    }
    .db-header .actions .btn-primary {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: #fff;
        border: none;
        box-shadow: 0 4px 12px rgba(59,130,246,.25);
    }
    .db-header .actions .btn-primary:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(59,130,246,.35);
        color: #fff;
    }

    /* ============ SECTION TITLE ============ */
    .section-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 32px 0 16px 0;
    }
    .section-head:first-of-type { margin-top: 0; }
    .section-head .icon {
        width: 8px;
        height: 24px;
        background: linear-gradient(180deg, #1e3a8a 0%, #3b82f6 100%);
        border-radius: 4px;
    }
    .section-head h6 {
        font-size: 15px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.2px;
        margin: 0;
    }
    .section-head .badge {
        font-size: 11px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 999px;
        background: #eff6ff;
        color: #1d4ed8;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    /* ============ STAT GRID ============ */
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 8px;
    }
    .stat-grid.cols-3 { grid-template-columns: repeat(3, 1fr); }

    .stat-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 22px 24px;
        position: relative;
        overflow: hidden;
        transition: all .2s;
    }
    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px rgba(15,23,42,.08);
    }
    .stat-card::before {
        content: "";
        position: absolute;
        top: 0; left: 0;
        width: 4px;
        height: 100%;
    }
    .stat-card.blue::before { background: linear-gradient(180deg, #1e3a8a, #3b82f6); }
    .stat-card.green::before { background: linear-gradient(180deg, #059669, #10b981); }
    .stat-card.amber::before { background: linear-gradient(180deg, #b45309, #f59e0b); }
    .stat-card.red::before { background: linear-gradient(180deg, #b91c1c, #ef4444); }
    .stat-card.purple::before { background: linear-gradient(180deg, #6d28d9, #8b5cf6); }
    .stat-card.cyan::before { background: linear-gradient(180deg, #0e7490, #06b6d4); }
    .stat-card.slate::before { background: linear-gradient(180deg, #475569, #94a3b8); }

    .stat-card .lbl {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .8px;
        color: #64748b;
        margin-bottom: 10px;
    }
    .stat-card .num {
        font-size: 32px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1;
        letter-spacing: -1px;
        font-variant-numeric: tabular-nums;
    }
    .stat-card.blue .num { color: #1d4ed8; }
    .stat-card.green .num { color: #059669; }
    .stat-card.amber .num { color: #b45309; }
    .stat-card.red .num { color: #b91c1c; }
    .stat-card.purple .num { color: #6d28d9; }
    .stat-card.cyan .num { color: #0e7490; }

    .stat-card .sub {
        font-size: 12px;
        color: #94a3b8;
        margin-top: 8px;
        font-weight: 500;
    }
    .stat-card .unit {
        font-size: 14px;
        font-weight: 600;
        color: #94a3b8;
        margin-left: 4px;
        letter-spacing: 0;
    }

    /* ============ DOANH THU CARD ============ */
    .revenue-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 16px;
        margin-bottom: 8px;
    }
    .revenue-hero {
        background: linear-gradient(135deg, #064e3b 0%, #059669 50%, #10b981 100%);
        border-radius: 16px;
        padding: 32px 36px;
        color: #fff;
        position: relative;
        overflow: hidden;
    }
    .revenue-hero::before {
        content: "";
        position: absolute;
        top: -80px; right: -80px;
        width: 260px; height: 260px;
        background: rgba(255,255,255,.08);
        border-radius: 50%;
    }
    .revenue-hero::after {
        content: "";
        position: absolute;
        bottom: -60px; left: -40px;
        width: 180px; height: 180px;
        background: rgba(255,255,255,.05);
        border-radius: 50%;
    }
    .revenue-hero .lbl {
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        opacity: .85;
        margin-bottom: 12px;
        position: relative;
        z-index: 1;
    }
    .revenue-hero .val {
        font-size: 44px;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -2px;
        font-variant-numeric: tabular-nums;
        position: relative;
        z-index: 1;
    }
    .revenue-hero .val .unit {
        font-size: 18px;
        font-weight: 600;
        letter-spacing: 0;
        opacity: .85;
        margin-left: 8px;
    }
    .revenue-hero .note {
        font-size: 13px;
        opacity: .85;
        margin-top: 12px;
        position: relative;
        z-index: 1;
    }

    .mini-stat {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 26px 24px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        transition: all .2s;
    }
    .mini-stat:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px rgba(15,23,42,.08);
    }
    .mini-stat .lbl {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .8px;
        color: #64748b;
        margin-bottom: 12px;
    }
    .mini-stat .num {
        font-size: 34px;
        font-weight: 800;
        color: #0f172a;
        line-height: 1;
        letter-spacing: -1px;
        font-variant-numeric: tabular-nums;
    }
    .mini-stat.blue .num { color: #1d4ed8; }
    .mini-stat.purple .num { color: #6d28d9; }
    .mini-stat .icon-circle {
        width: 36px; height: 36px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 14px;
        font-size: 15px;
        font-weight: 800;
    }
    .mini-stat.blue .icon-circle {
        background: #dbeafe; color: #1d4ed8;
    }
    .mini-stat.purple .icon-circle {
        background: #ede9fe; color: #6d28d9;
    }
    .mini-stat .sub {
        font-size: 12px;
        color: #94a3b8;
        margin-top: 8px;
    }

    /* ============ ALERT CARDS ============ */
    .alert-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 8px;
    }
    .alert-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
    }
    .alert-card .alert-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 22px;
        border-bottom: 1px solid #f1f5f9;
    }
    .alert-card .alert-head .title-wrap {
        display: flex;
        align-items: center;
        gap: 12px;
    }
    .alert-card .alert-head .circle {
        width: 36px; height: 36px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        font-weight: 800;
        flex-shrink: 0;
    }
    .alert-card.warn .circle { background: #fef3c7; color: #92400e; }
    .alert-card.danger .circle { background: #fee2e2; color: #991b1b; }
    .alert-card .alert-head .title {
        font-size: 14px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }
    .alert-card .alert-head .subtitle {
        font-size: 12px;
        color: #94a3b8;
        margin-top: 2px;
    }
    .alert-card .count-badge {
        font-size: 12px;
        font-weight: 700;
        padding: 6px 14px;
        border-radius: 999px;
        white-space: nowrap;
    }
    .alert-card.warn .count-badge {
        background: #fef3c7;
        color: #92400e;
    }
    .alert-card.danger .count-badge {
        background: #fee2e2;
        color: #991b1b;
    }
    .alert-card .count-badge.ok {
        background: #dcfce7;
        color: #166534;
    }

    .alert-list {
        padding: 8px 0;
        max-height: 380px;
        overflow-y: auto;
    }
    .alert-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 22px;
        border-bottom: 1px solid #f8fafc;
        transition: background .15s;
    }
    .alert-item:last-child { border-bottom: none; }
    .alert-item:hover { background: #fafbfc; }
    .alert-item .info { flex: 1; min-width: 0; }
    .alert-item .order-code {
        font-size: 11px;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: .3px;
        margin-bottom: 2px;
    }
    .alert-item .customer {
        font-size: 14px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 2px;
    }
    .alert-item .car-info {
        font-size: 12px;
        color: #64748b;
    }
    .alert-item .time-block {
        text-align: right;
        flex-shrink: 0;
        margin-left: 16px;
    }
    .alert-item .time {
        font-size: 13px;
        font-weight: 700;
        color: #0f172a;
        font-variant-numeric: tabular-nums;
    }
    .alert-card.warn .alert-item .time { color: #b45309; }
    .alert-card.danger .alert-item .time { color: #b91c1c; }
    .alert-item .time-note {
        font-size: 11px;
        color: #94a3b8;
        margin-top: 2px;
    }
    .alert-card.warn .alert-item .time-note { color: #92400e; font-weight: 600; }
    .alert-card.danger .alert-item .time-note { color: #991b1b; font-weight: 600; }

    .alert-empty {
        padding: 56px 24px;
        text-align: center;
    }
    .alert-empty .check {
        width: 56px; height: 56px;
        border-radius: 50%;
        background: #dcfce7;
        color: #166534;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 800;
        margin-bottom: 12px;
    }
    .alert-empty .msg {
        font-size: 14px;
        color: #64748b;
        font-weight: 500;
    }

    /* ============ RESPONSIVE ============ */
    @@media (max-width: 992px) {
        .stat-grid,
        .stat-grid.cols-3 { grid-template-columns: repeat(2, 1fr); }
        .revenue-grid { grid-template-columns: 1fr; }
        .alert-grid { grid-template-columns: 1fr; }
    }

    @@media (max-width: 576px) {
        .stat-grid,
        .stat-grid.cols-3 { grid-template-columns: 1fr; }
        .db-header { flex-direction: column; align-items: flex-start; gap: 16px; }
        .revenue-hero .val { font-size: 32px; }
    }
</style>

<div class="dashboard-shell">
    <div class="dashboard-wrap">

        <!-- HEADER -->
        <div class="db-header">
            <div>
                <div class="greeting">Xin chào, chúc một ngày tốt lành</div>
                <h1>Dashboard</h1>
                <p class="sub">
                    Cập nhật lúc @now.ToString("HH:mm - dd/MM/yyyy") ·
                    Tổng quan hoạt động hệ thống
                </p>
            </div>
            <div class="actions">
                <a asp-action="ChiTiet" class="btn-outline">
                    Thống kê chi tiết →
                </a>
                <a asp-controller="DatXe" asp-action="Index" class="btn-primary">
                    Đơn đặt xe
                </a>
            </div>
        </div>

        <!-- TINH TRANG XE -->
        <div class="section-head">
            <div class="icon"></div>
            <h6>Tình trạng xe</h6>
            <span class="badge">@Model.TongSoXe xe</span>
        </div>

        <div class="stat-grid">
            <div class="stat-card blue">
                <div class="lbl">Tổng số xe</div>
                <div class="num">@Model.TongSoXe</div>
                <div class="sub">Toàn bộ đội xe</div>
            </div>
            <div class="stat-card green">
                <div class="lbl">Sẵn sàng cho thuê</div>
                <div class="num">@Model.XeSanSang</div>
                <div class="sub">
                    @((Model.TongSoXe > 0 ? (Model.XeSanSang * 100.0 / Model.TongSoXe).ToString("N0") : "0"))% đội xe
                </div>
            </div>
            <div class="stat-card amber">
                <div class="lbl">Đang cho thuê</div>
                <div class="num">@Model.XeDangThue</div>
                <div class="sub">Đang phục vụ khách</div>
            </div>
            <div class="stat-card red">
                <div class="lbl">Bảo dưỡng / Ngừng</div>
                <div class="num">@(Model.XeBaoDuong + Model.XeNgung)</div>
                <div class="sub">@Model.XeBaoDuong BD · @Model.XeNgung ngừng</div>
            </div>
        </div>

        <!-- TINH TRANG DON -->
        <div class="section-head">
            <div class="icon"></div>
            <h6>Tình trạng đơn đặt xe</h6>
        </div>

        <div class="stat-grid">
            <div class="stat-card amber">
                <div class="lbl">Chờ duyệt</div>
                <div class="num">@Model.DonChoDuyet</div>
                <div class="sub">Cần xử lý</div>
            </div>
            <div class="stat-card blue">
                <div class="lbl">Đã duyệt</div>
                <div class="num">@Model.DonDaDuyet</div>
                <div class="sub">Chờ bàn giao</div>
            </div>
            <div class="stat-card purple">
                <div class="lbl">Đang thuê</div>
                <div class="num">@Model.DonDangThue</div>
                <div class="sub">Khách đang sử dụng</div>
            </div>
            <div class="stat-card cyan">
                <div class="lbl">Chờ thanh toán</div>
                <div class="num">@Model.DonChoThanhToan</div>
                <div class="sub">Cần thu tiền</div>
            </div>
            <div class="stat-card green">
                <div class="lbl">Hoàn thành</div>
                <div class="num">@Model.DonHoanThanh</div>
                <div class="sub">Đã tất toán</div>
            </div>
            <div class="stat-card slate">
                <div class="lbl">Đã hủy</div>
                <div class="num">@Model.DonDaHuy</div>
                <div class="sub">Khách tự hủy</div>
            </div>
            <div class="stat-card slate">
                <div class="lbl">Từ chối</div>
                <div class="num">@Model.DonTuChoi</div>
                <div class="sub">Nhân viên từ chối</div>
            </div>
            <div class="stat-card blue">
                <div class="lbl">Lượt nhận xe hôm nay</div>
                <div class="num">@Model.LuotNhanXeHomNay</div>
                <div class="sub">@now.ToString("dd/MM/yyyy")</div>
            </div>
        </div>

        <!-- DOANH THU -->
        <div class="section-head">
            <div class="icon"></div>
            <h6>Doanh thu</h6>
            <span class="badge">Tháng @now.Month/@now.Year</span>
        </div>

        <div class="revenue-grid">
            <div class="revenue-hero">
                <div class="lbl">Doanh thu tháng này</div>
                <div class="val">
                    @Model.DoanhThuThangNay.ToString("N0")<span class="unit">đ</span>
                </div>
                <div class="note">
                    Tổng doanh thu từ các đơn đã thanh toán trong tháng
                </div>
            </div>

            <div class="mini-stat blue">
                <div class="icon-circle">H</div>
                <div class="lbl">Doanh thu hôm nay</div>
                <div class="num">@Model.DoanhThuHomNay.ToString("N0")</div>
                <div class="sub">VNĐ · @now.ToString("dd/MM/yyyy")</div>
            </div>

            <div class="mini-stat purple">
                <div class="icon-circle">T</div>
                <div class="lbl">Lượt trả xe hôm nay</div>
                <div class="num">@Model.LuotTraXeHomNay</div>
                <div class="sub">Khách trả xe trong ngày</div>
            </div>
        </div>

        <!-- CANH BAO -->
        <div class="section-head">
            <div class="icon"></div>
            <h6>Cảnh báo cần xử lý</h6>
        </div>

        <div class="alert-grid">

            <!-- Don sap den gio nhan -->
            <div class="alert-card warn">
                <div class="alert-head">
                    <div class="title-wrap">
                        <div class="circle">!</div>
                        <div>
                            <p class="title">Đơn sắp đến giờ nhận</p>
                            <div class="subtitle">Trong vòng 24 giờ tới</div>
                        </div>
                    </div>
                    @if (Model.DonSapDenGioNhan.Any())
                    {
                        <span class="count-badge">@Model.DonSapDenGioNhan.Count đơn</span>
                    }
                    else
                    {
                        <span class="count-badge ok">Không có</span>
                    }
                </div>

                @if (Model.DonSapDenGioNhan.Any())
                {
                    <div class="alert-list">
                        @foreach (var don in Model.DonSapDenGioNhan)
                        {
                            var conLai = (don.ThoiGianNhanDuKien - DateTime.Now).TotalHours;

                            <div class="alert-item">
                                <div class="info">
                                    <div class="order-code">Đơn #@don.MaDatXe</div>
                                    <div class="customer">@don.KhachHang?.HoTen</div>
                                    <div class="car-info">
                                        @don.Xe?.TenXe · @don.Xe?.BienSo
                                    </div>
                                </div>
                                <div class="time-block">
                                    <div class="time">
                                        @don.ThoiGianNhanDuKien.ToString("HH:mm dd/MM")
                                    </div>
                                    <div class="time-note">
                                        Còn @conLai.ToString("N1") giờ
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert-empty">
                        <div class="check">✓</div>
                        <div class="msg">Không có đơn nào sắp đến giờ nhận</div>
                    </div>
                }
            </div>

            <!-- Don qua gio tra -->
            <div class="alert-card danger">
                <div class="alert-head">
                    <div class="title-wrap">
                        <div class="circle">!</div>
                        <div>
                            <p class="title">Đơn quá giờ trả</p>
                            <div class="subtitle">Cần liên hệ khách hàng</div>
                        </div>
                    </div>
                    @if (Model.DonQuaGioTra.Any())
                    {
                        <span class="count-badge">@Model.DonQuaGioTra.Count đơn</span>
                    }
                    else
                    {
                        <span class="count-badge ok">Không có</span>
                    }
                </div>

                @if (Model.DonQuaGioTra.Any())
                {
                    <div class="alert-list">
                        @foreach (var don in Model.DonQuaGioTra)
                        {
                            var gioTre = (DateTime.Now - don.ThoiGianTraDuKien).TotalHours;

                            <div class="alert-item">
                                <div class="info">
                                    <div class="order-code">Đơn #@don.MaDatXe</div>
                                    <div class="customer">@don.KhachHang?.HoTen</div>
                                    <div class="car-info">
                                        @don.Xe?.TenXe · @don.Xe?.BienSo
                                    </div>
                                </div>
                                <div class="time-block">
                                    <div class="time">
                                        @don.ThoiGianTraDuKien.ToString("HH:mm dd/MM")
                                    </div>
                                    <div class="time-note">
                                        Trễ @gioTre.ToString("N1") giờ
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="alert-empty">
