    @@media (max-width: 768px) {
        .db-greeting { font-size: 22px; }
        .db-stats { grid-template-columns: 1fr; }
        .db-grid { grid-template-columns: 1fr; }
        .db-card-revenue,
        .db-card-top { grid-column: span 1; }
        .db-action { min-width: auto; }
        .db-top-list { grid-template-columns: repeat(2, 1fr); }
    }
</style>

@section Scripts {
    <script>
        // ============================================================
        // REVENUE CHART
        // ============================================================
        var revenueCtx = document.getElementById('revenueChart').getContext('2d');
        var gradBar = revenueCtx.createLinearGradient(0, 0, 0, 280);
        gradBar.addColorStop(0, '#3b82f6');
        gradBar.addColorStop(1, '#60a5fa');

        var labels = @Html.Raw(JsonSerializer.Serialize(
            Model.DoanhThu7Ngay.Select(x => x.Ngay.ToString("dd/MM")).ToList()
        ));
        var dataRev = @Html.Raw(JsonSerializer.Serialize(
            Model.DoanhThu7Ngay.Select(x => x.DoanhThu).ToList()
        ));
        var dataDon = @Html.Raw(JsonSerializer.Serialize(
            Model.DoanhThu7Ngay.Select(x => x.SoDon).ToList()
        ));

        new Chart(revenueCtx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        type: 'bar',
                        label: 'Doanh thu (VNĐ)',
                        data: dataRev,
                        backgroundColor: gradBar,
                        borderRadius: 8,
                        barPercentage: 0.55,
                        yAxisID: 'y',
                        order: 2
                    },
                    {
                        type: 'line',
                        label: 'Số đơn thuê',
                        data: dataDon,
                        borderColor: '#8b5cf6',
                        backgroundColor: 'transparent',
                        borderWidth: 3,
                        tension: 0.4,
                        pointBackgroundColor: '#8b5cf6',
                        pointBorderColor: '#fff',
                        pointBorderWidth: 2,
                        pointRadius: 5,
                        yAxisID: 'y1',
                        order: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: {
                        position: 'top',
                        align: 'end',
                        labels: {
                            padding: 16,
                            font: { size: 12, weight: '600' },
                            color: '#475569',
                            usePointStyle: true,
                            pointStyle: 'circle',
                            boxWidth: 8,
                            boxHeight: 8                        }
                    },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        padding: 12,
                        cornerRadius: 8,
                        callbacks: {
                            label: function (ctx) {
                                if (ctx.dataset.yAxisID === 'y') {
                                    return ctx.dataset.label + ': ' +
                                        new Intl.NumberFormat('vi-VN').format(ctx.parsed.y) + ' đ';
                                }
                                return ctx.dataset.label + ': ' + ctx.parsed.y;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        position: 'left',
                        ticks: {
                            color: '#94a3b8',
                            font: { size: 11 },
                            callback: function (v) {
                                return new Intl.NumberFormat('vi-VN', {
                                    notation: 'compact', compactDisplay: 'short'
                                }).format(v);
                            }
                        },
                        grid: { color: '#f1f5f9', drawBorder: false }
                    },
                    y1: {
                        beginAtZero: true,
                        position: 'right',
                        ticks: { color: '#94a3b8', font: { size: 11 }, stepSize: 1 },
                        grid: { display: false }
                    },
                    x: {
                        ticks: { color: '#94a3b8', font: { size: 11 } },
                        grid: { display: false }
                    }
                }
            }
        });

        // ============================================================
        // STATUS CHART - Donut
        // ============================================================
        var statusCtx = document.getElementById('statusChart').getContext('2d');
        new Chart(statusCtx, {
            type: 'doughnut',
            data: {
                labels: ['Sẵn sàng', 'Đang thuê', 'Bảo dưỡng / Ngừng'],
                datasets: [{
                    data: [
                        @Model.XeSanSang,
                        @Model.XeDangThue,
                        @(Model.XeBaoDuong + Model.XeNgung)
                    ],
                    backgroundColor: ['#10b981', '#f59e0b', '#ef4444'],
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '72%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        padding: 10,
                        cornerRadius: 6
                    }
                }
            }
        });
    </script>
}