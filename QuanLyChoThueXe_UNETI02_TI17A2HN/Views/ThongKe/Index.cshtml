@*
    Index.cshtml - Dashboard thống kê
    Sinh viên thực hiện: Dương Lâm Huy - 23103100120
    Nội dung: Dashboard hiện đại, dùng 100% dữ liệu thực từ DashboardVM
    Module: Module 5 - Tính tiền, Thanh toán, Lịch sử, Thống kê
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.ThongKe.DashboardVM
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    var now = DateTime.Now;

    // Tính % thay đổi (fallback về 0 nếu mẫu = 0)
    int TinhPhanTram(int hienTai, int truoc)
        => truoc == 0 ? 0 : (int)Math.Round((hienTai - truoc) * 100.0 / truoc);
}

<!-- ============================================================ -->
<!-- HERO SECTION                                                  -->
<!-- ============================================================ -->
<section class="db-hero">
    <div class="db-hero-grid">

        <!-- LEFT: Greeting -->
        <div class="db-hero-left">
            <h1 class="db-greeting">
                Xin chào! <span class="wave">👋</span>
            </h1>
            <p class="db-hero-sub">Chúc bạn có một ngày làm việc hiệu quả!</p>
            <div class="db-hero-date">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="18" rx="2" />
                    <line x1="16" y1="2" x2="16" y2="6" />
                    <line x1="8" y1="2" x2="8" y2="6" />
                    <line x1="3" y1="10" x2="21" y2="10" />
                </svg>
                <span>@now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</span>
                <span class="dot">·</span>
                <span>@now.ToString("HH:mm")</span>
            </div>
        </div>

        <!-- CENTER: Hero Car -->
        <div class="db-hero-car">
            <img src="https://images.unsplash.com/photo-1621007947382-bb3c3994e3fb?w=800&q=80"
                 alt="Xe cho thuê" />
        </div>

        <!-- RIGHT: Actions -->
        <div class="db-hero-actions">
            <a asp-action="XuatPdf"
               asp-route-tuNgay="@(new DateTime(now.Year, 1, 1).ToString("yyyy-MM-dd"))"
               asp-route-denNgay="@now.ToString("yyyy-MM-dd")"
               class="db-action db-action-red">
                <div class="db-action-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                    </svg>
                </div>
                <div class="db-action-text">
                    <div class="db-action-title">Xuất PDF</div>
                    <div class="db-action-sub">Báo cáo nhanh</div>
                </div>
            </a>

            <a asp-action="ChiTiet" class="db-action db-action-white">
                <div class="db-action-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="20" x2="18" y2="10" />
                        <line x1="12" y1="20" x2="12" y2="4" />
                        <line x1="6" y1="20" x2="6" y2="14" />
                    </svg>
                </div>
                <div class="db-action-text">
                    <div class="db-action-title">Thống kê chi tiết</div>
                    <div class="db-action-sub">Xem báo cáo</div>
                </div>
            </a>

            <a asp-controller="DatXe" asp-action="Index" class="db-action db-action-blue">
                <div class="db-action-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 17h14M5 17v-4l2-5h10l2 5v4M5 17v3h2v-3m10 0v3h2v-3" />
                    </svg>
                </div>
                <div class="db-action-text">
                    <div class="db-action-title">Đơn đặt xe</div>
                    <div class="db-action-sub">Tạo đơn mới</div>
                </div>
            </a>
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- STAT CARDS ROW (4 thẻ với sparkline từ dữ liệu 7 ngày)        -->
<!-- ============================================================ -->
<section class="db-stats">

    <!-- Card 1: Tổng số xe -->
    <div class="db-stat db-stat-blue">
        <div class="db-stat-head">
            <div class="db-stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 17h14M5 17v-4l2-5h10l2 5v4M5 17v3h2v-3m10 0v3h2v-3" />
                    <circle cx="7.5" cy="14.5" r="1" />
                    <circle cx="16.5" cy="14.5" r="1" />
                </svg>
            </div>
            <div class="db-stat-label">TỔNG SỐ XE</div>
        </div>
        <div class="db-stat-body">
            <div class="db-stat-value">@Model.TongSoXe</div>
            @{
                var pctXe = TinhPhanTram(Model.TongSoXe, Model.TongSoXeThangTruoc);
            }
            <div class="db-stat-trend @(pctXe > 0 ? "db-trend-up" : pctXe < 0 ? "db-trend-down" : "db-trend-flat")">
                @if (pctXe > 0)
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15" />
                    </svg>
                }
                else if (pctXe < 0)
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                }
                else
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                }
                <span>@(pctXe >= 0 ? "+" : "")@pctXe%</span>
                <span class="db-stat-trend-label">so với tháng trước</span>
            </div>
        </div>
        <div class="db-stat-sparkline">
            @await Html.PartialAsync("_Sparkline", Model.DoanhThu7Ngay.Select(x => (double)x.SoDon).ToList())
        </div>
    </div>

    <!-- Card 2: Sẵn sàng -->
    <div class="db-stat db-stat-green">
        <div class="db-stat-head">
            <div class="db-stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12" />
                </svg>
            </div>
            <div class="db-stat-label">SẴN SÀNG CHO THUÊ</div>
        </div>
        <div class="db-stat-body">
            <div class="db-stat-value">@Model.XeSanSang</div>
            @{
                var pctSanSang = TinhPhanTram(Model.XeSanSang, Model.XeSanSangThangTruoc);
            }
            <div class="db-stat-trend @(pctSanSang > 0 ? "db-trend-up" : pctSanSang < 0 ? "db-trend-down" : "db-trend-flat")">
                @if (pctSanSang > 0)
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15" />
                    </svg>
                }
                else if (pctSanSang < 0)
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                }
                else
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                }
                <span>@(pctSanSang >= 0 ? "+" : "")@pctSanSang%</span>
                <span class="db-stat-trend-label">so với tháng trước</span>
            </div>
        </div>
        <div class="db-stat-sparkline">
            @await Html.PartialAsync("_Sparkline", Model.DoanhThu7Ngay.Select(x => (double)x.DoanhThu).ToList())
        </div>
    </div>

    <!-- Card 3: Đang cho thuê -->
    <div class="db-stat db-stat-amber">
        <div class="db-stat-head">
            <div class="db-stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
            </div>
            <div class="db-stat-label">ĐANG CHO THUÊ</div>
        </div>
        <div class="db-stat-body">
            <div class="db-stat-value">@Model.XeDangThue</div>
            @{
                var pctDangThue = TinhPhanTram(Model.XeDangThue, Model.XeDangThueThangTruoc);
            }
            <div class="db-stat-trend @(pctDangThue > 0 ? "db-trend-up" : pctDangThue < 0 ? "db-trend-down" : "db-trend-flat")">
                @if (pctDangThue > 0)
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="18 15 12 9 6 15" />
                    </svg>
                }
                else if (pctDangThue < 0)
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="6 9 12 15 18 9" />
                    </svg>
                }
                else
                {
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12" />
                    </svg>
                }
                <span>@(pctDangThue >= 0 ? "+" : "")@pctDangThue%</span>
                <span class="db-stat-trend-label">so với tháng trước</span>
            </div>
        </div>
        <div class="db-stat-sparkline">
            @await Html.PartialAsync("_Sparkline", Model.DoanhThu7Ngay.Select(x => (double)x.SoDon).ToList())
        </div>
    </div>

    <!-- Card 4: Bảo dưỡng / Ngừng -->
    <div class="db-stat db-stat-red">
        <div class="db-stat-head">
            <div class="db-stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10" />
                    <line x1="12" y1="8" x2="12" y2="12" />
                    <line x1="12" y1="16" x2="12.01" y2="16" />
                </svg>
            </div>
            <div class="db-stat-label">BẢO DƯỠNG / NGỪNG</div>
        </div>
        <div class="db-stat-body">
            <div class="db-stat-value">@(Model.XeBaoDuong + Model.XeNgung)</div>
            <div class="db-stat-trend db-trend-flat">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none"
                     stroke="currentColor" stroke-width="2.5"
                     stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12" />
                </svg>
                <span>@Model.XeBaoDuong BD</span>
                <span class="db-stat-trend-label">@Model.XeNgung ngừng</span>
            </div>
        </div>
        <div class="db-stat-sparkline">
            @await Html.PartialAsync("_Sparkline", Model.DoanhThu7Ngay.Select(x => (double)x.SoDon).ToList())
        </div>
    </div>
</section>

<!-- ============================================================ -->
<!-- MAIN GRID                                                     -->
<!-- ============================================================ -->
<section class="db-grid">

    <!-- Revenue Chart -->
    <div class="db-card db-card-revenue">
        <div class="db-card-head">
            <div class="db-card-title-wrap">
                <div class="db-card-title-icon db-icon-blue">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="1" x2="12" y2="23" />
                        <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" />
                    </svg>
                </div>
                <h3 class="db-card-title">Doanh thu 7 ngày gần nhất</h3>
            </div>
        </div>
        <div class="db-card-body">
            <canvas id="revenueChart"></canvas>
        </div>
    </div>

    <!-- Tình trạng xe - Donut -->
    <div class="db-card db-card-status">
        <div class="db-card-head">
            <div class="db-card-title-wrap">
                <div class="db-card-title-icon db-icon-green">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10" />
                    </svg>
                </div>
                <h3 class="db-card-title">Tình trạng xe</h3>
            </div>
        </div>
        <div class="db-card-body db-status-body">
            <div class="db-donut-wrap">
                <canvas id="statusChart"></canvas>
                <div class="db-donut-center">
                    <div class="db-donut-value">@Model.TongSoXe</div>
                    <div class="db-donut-label">Tổng số xe</div>
                </div>
            </div>
            <div class="db-legend">
                <div class="db-legend-item">
                    <span class="db-legend-dot" style="background:#10b981;"></span>
                    <span class="db-legend-label">Sẵn sàng</span>
                    <span class="db-legend-value">@Model.XeSanSang</span>
                    <span class="db-legend-pct">@(Model.TongSoXe > 0 ? Model.XeSanSang * 100 / Model.TongSoXe : 0)%</span>
                </div>
                <div class="db-legend-item">
                    <span class="db-legend-dot" style="background:#f59e0b;"></span>
                    <span class="db-legend-label">Đang thuê</span>
                    <span class="db-legend-value">@Model.XeDangThue</span>
                    <span class="db-legend-pct">@(Model.TongSoXe > 0 ? Model.XeDangThue * 100 / Model.TongSoXe : 0)%</span>
                </div>
                <div class="db-legend-item">
                    <span class="db-legend-dot" style="background:#ef4444;"></span>
                    <span class="db-legend-label">Bảo dưỡng / Ngừng</span>
                    <span class="db-legend-value">@(Model.XeBaoDuong + Model.XeNgung)</span>
                    <span class="db-legend-pct">@(Model.TongSoXe > 0 ? (Model.XeBaoDuong + Model.XeNgung) * 100 / Model.TongSoXe : 0)%</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Hoạt động gần đây -->
    <div class="db-card db-card-activity">
        <div class="db-card-head">
            <div class="db-card-title-wrap">
                <div class="db-card-title-icon db-icon-purple">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="22 12 18 12 15 21 9 3 6 12 2 12" />
                    </svg>
                </div>
                <h3 class="db-card-title">Hoạt động gần đây</h3>
            </div>
            <a asp-controller="DatXe" asp-action="Index" class="db-card-link">Xem tất cả →</a>
        </div>
        <div class="db-card-body db-activity-list">

            @if (Model.HoatDongGanDay.Any())
            {
                foreach (var hd in Model.HoatDongGanDay)
                {
                    var cls = hd.Loai switch
                    {
                        "don-moi" => "db-icon-green",
                        "tra-xe" => "db-icon-blue",
                        "bao-duong" => "db-icon-amber",
                        "thanh-toan" => "db-icon-red",
                        _ => "db-icon-purple"
                    };

                    <div class="db-activity-item">
                        <div class="db-activity-icon @cls">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                @if (hd.Loai == "don-moi")
                                {
                                    <polyline points="20 6 9 17 4 12" />
                                }
                                else if (hd.Loai == "tra-xe")
                                {
                                    <path d="M9 11l3 3L22 4" />
                                    <path d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11" />
                                }
                                else if (hd.Loai == "thanh-toan")
                                {
                                    <rect x="2" y="6" width="20" height="12" rx="2" />
                                    <line x1="2" y1="10" x2="22" y2="10" />
                                }
                                else
                                {
                                    <circle cx="12" cy="12" r="10" />
                                    <line x1="12" y1="8" x2="12" y2="12" />
                                }
                            </svg>
                        </div>
                        <div class="db-activity-content">
                            <div class="db-activity-title">@hd.TieuDe</div>
                            <div class="db-activity-sub">@hd.MoTa</div>
                        </div>
                        <div class="db-activity-time">@hd.ThoiGian.ToString("HH:mm")</div>
                    </div>
                }
            }
            else
            {
                <div class="db-empty">Chưa có hoạt động nào</div>
            }

        </div>
    </div>

    <!-- Top 5 xe được thuê nhiều nhất -->
    <div class="db-card db-card-top">
        <div class="db-card-head">
            <div class="db-card-title-wrap">
                <div class="db-card-title-icon db-icon-red">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 2s4 6 4 10a4 4 0 11-8 0c0-4 4-10 4-10z" />
                    </svg>
                </div>
                <h3 class="db-card-title">Top 5 xe được thuê nhiều nhất</h3>
            </div>
            <a asp-controller="Xe" asp-action="Index" class="db-card-link">Xem tất cả →</a>
        </div>
        <div class="db-card-body db-top-list">

            @if (Model.TopXeThueNhieu.Any())
            {
                var rank = 0;
                foreach (var xe in Model.TopXeThueNhieu)
                {
                    rank++;
                    var rankCls = rank switch
                    {
                        1 => "db-rank-1",
                        2 => "db-rank-2",
                        3 => "db-rank-3",
                        _ => ""
                    };

                    <div class="db-top-item">
                        <div class="db-top-rank @rankCls">@rank</div>
                        <div class="db-top-img">
                            <img src="@(string.IsNullOrEmpty(xe.AnhXe) ? "/images/xe/default.jpg" : xe.AnhXe)"
                                 alt="@xe.TenXe" />
                        </div>
                        <div class="db-top-info">
                            <div class="db-top-name">@xe.TenXe</div>
                            <div class="db-top-count">@xe.SoLanThue lượt thuê</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="db-empty">Chưa có dữ liệu</div>
            }

        </div>
    </div>

    <!-- Cảnh báo cần xử lý -->
    <div class="db-card db-card-alerts">
        <div class="db-card-head">
            <div class="db-card-title-wrap">
                <div class="db-card-title-icon db-icon-amber">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" />
                        <line x1="12" y1="9" x2="12" y2="13" />
                        <line x1="12" y1="17" x2="12.01" y2="17" />
                    </svg>
                </div>
                <h3 class="db-card-title">Cảnh báo cần xử lý</h3>
            </div>
        </div>
        <div class="db-card-body db-alert-list">

            <!-- Đơn sắp đến giờ nhận -->
            <div class="db-alert-item db-alert-warn">
                <div class="db-alert-head">
                    <span class="db-alert-badge">@Model.DonSapDenGioNhan.Count</span>
                    <span class="db-alert-title">Đơn sắp đến giờ nhận</span>
                </div>
                @if (Model.DonSapDenGioNhan.Any())
                {
                    <ul class="db-alert-list-items">
                        @foreach (var don in Model.DonSapDenGioNhan.Take(3))
                        {
                            <li>
                                <strong>#@don.MaDatXe</strong> · @don.KhachHang?.HoTen · @don.Xe?.BienSo
                                <span class="db-alert-time">@don.ThoiGianNhanDuKien.ToString("HH:mm dd/MM")</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="db-alert-empty">✓ Không có</div>
                }
            </div>

            <!-- Đơn quá giờ trả -->
            <div class="db-alert-item db-alert-danger">
                <div class="db-alert-head">
                    <span class="db-alert-badge">@Model.DonQuaGioTra.Count</span>
                    <span class="db-alert-title">Đơn quá giờ trả</span>
                </div>
                @if (Model.DonQuaGioTra.Any())
                {
                    <ul class="db-alert-list-items">
                        @foreach (var don in Model.DonQuaGioTra.Take(3))
                        {
                            <li>
                                <strong>#@don.MaDatXe</strong> · @don.KhachHang?.HoTen · @don.Xe?.BienSo
                                <span class="db-alert-time">@don.ThoiGianTraDuKien.ToString("HH:mm dd/MM")</span>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="db-alert-empty">✓ Không có</div>
                }
            </div>

        </div>
    </div>

</section>

