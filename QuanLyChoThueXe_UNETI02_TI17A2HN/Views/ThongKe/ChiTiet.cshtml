@*
    ChiTiet.cshtml - Thống kê chi tiết
    Sinh viên thực hiện: Duong Lam Huy - 23103100120
    Nội dung: Thống kê chi tiết + biểu đồ + nút Xuất PDF
    Module: Module 5 - Tính tiền, Thanh toán, Lịch sử, Thống kê
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.ThongKe.ThongKeVM
@{
    ViewData["Title"] = "Thống kê chi tiết";
}

<style>
    .stat-shell { background: #f5f7fa; min-height: 100vh; padding: 28px 0 40px; }
    .stat-wrap { max-width: 1480px; margin: 0 auto; padding: 0 28px; }

    .stat-header {
        display: flex; justify-content: space-between; align-items: flex-end;
        margin-bottom: 24px; padding-bottom: 20px; border-bottom: 1px solid #e5e7eb;
        flex-wrap: wrap; gap: 16px;
    }
    .stat-header .back {
        font-size: 13px; color: #64748b; text-decoration: none;
        display: inline-flex; align-items: center; gap: 4px; margin-bottom: 8px;
    }
    .stat-header .back:hover { color: #1d4ed8; }
    .stat-header h1 {
        font-size: 28px; font-weight: 800; color: #0f172a;
        letter-spacing: -0.6px; margin: 0 0 6px 0;
    }
    .stat-header .sub { font-size: 14px; color: #64748b; margin: 0; }
    .stat-header .sub strong { color: #1d4ed8; font-weight: 700; }

    /* ===== NÚT XUẤT PDF ===== */
    .btn-export-pdf {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 11px 22px;
        background: linear-gradient(135deg, #b91c1c 0%, #dc2626 100%);
        color: #fff;
        border: none; border-radius: 10px;
        font-size: 13px; font-weight: 700;
        text-decoration: none;
        box-shadow: 0 4px 12px rgba(220,38,38,.25);
        transition: all .2s;
        white-space: nowrap;
    }
    .btn-export-pdf:hover {
        color: #fff;
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(220,38,38,.4);
    }
    .btn-export-pdf .icon { font-size: 16px; }

    .filter-box {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 14px;
        padding: 20px 24px; margin-bottom: 24px;
        display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap;
    }
    .filter-box .form-group { flex: 1; min-width: 180px; }
    .filter-box .form-label {
        font-size: 11px; font-weight: 700; text-transform: uppercase;
        letter-spacing: .5px; color: #64748b; margin-bottom: 6px; display: block;
    }
    .filter-box .form-control {
        border-radius: 8px; border-color: #d1d5db;
        font-size: 14px; height: 42px; width: 100%;
    }
    .filter-box .form-control:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,.12); }
    .filter-box .btn-group { display: flex; gap: 8px; }
    .filter-box .btn { height: 42px; padding: 0 20px; border-radius: 8px; font-size: 13px; font-weight: 700; }
    .filter-box .btn-primary {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        border: none; box-shadow: 0 4px 12px rgba(59,130,246,.25);
    }
    .filter-box .btn-primary:hover { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(59,130,246,.35); }

    .summary-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-bottom: 32px; }
    .summary-card {
        background: #fff; border: 1px solid #e5e7eb; border-radius: 14px;
        padding: 22px 24px; position: relative; overflow: hidden; transition: all .2s;
    }
    .summary-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(15,23,42,.08); }
    .summary-card::before { content: ""; position: absolute; top: 0; left: 0; width: 4px; height: 100%; }
    .summary-card.blue::before { background: linear-gradient(180deg, #1e3a8a, #3b82f6); }
    .summary-card.green::before { background: linear-gradient(180deg, #059669, #10b981); }
    .summary-card.amber::before { background: linear-gradient(180deg, #b45309, #f59e0b); }
    .summary-card.red::before { background: linear-gradient(180deg, #b91c1c, #ef4444); }
    .summary-card.purple::before { background: linear-gradient(180deg, #6d28d9, #8b5cf6); }

    .summary-card .lbl { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .8px; color: #64748b; margin-bottom: 10px; }
    .summary-card .num { font-size: 26px; font-weight: 800; color: #0f172a; line-height: 1; letter-spacing: -0.6px; font-variant-numeric: tabular-nums; }
    .summary-card.blue .num { color: #1d4ed8; }
    .summary-card.green .num { color: #059669; }
    .summary-card.amber .num { color: #b45309; }
    .summary-card.red .num { color: #b91c1c; }
    .summary-card.purple .num { color: #6d28d9; }
    .summary-card .sub { font-size: 12px; color: #94a3b8; margin-top: 8px; }

    .section-head { display: flex; align-items: center; gap: 12px; margin: 32px 0 16px 0; }
    .section-head .icon { width: 8px; height: 24px; background: linear-gradient(180deg, #1e3a8a 0%, #3b82f6 100%); border-radius: 4px; }
    .section-head h6 { font-size: 15px; font-weight: 800; color: #0f172a; letter-spacing: -0.2px; margin: 0; }
    .section-head .count {
        font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 999px;
        background: #eff6ff; color: #1d4ed8; text-transform: uppercase; letter-spacing: .3px;
    }

    .chart-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
    .chart-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; overflow: hidden; }
    .chart-header {
        display: flex; justify-content: space-between; align-items: center;
        padding: 18px 22px; border-bottom: 1px solid #f1f5f9;
    }
    .chart-header h6 { font-size: 14px; font-weight: 700; color: #0f172a; margin: 0; }
    .chart-badge {
        font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .5px;
        padding: 4px 10px; border-radius: 999px; background: #eff6ff; color: #1d4ed8;
    }
    .chart-body { padding: 20px 22px; height: 300px; position: relative; }

    .data-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; overflow: hidden; margin-bottom: 12px; }
    .data-card table { margin: 0; font-size: 14px; }
    .data-card thead th {
        background: #f9fafb; font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .5px; color: #475569;
        padding: 14px 20px; border-bottom: 1px solid #e5e7eb; white-space: nowrap;
    }
    .data-card tbody td {
        padding: 16px 20px; border-bottom: 1px solid #f1f5f9; vertical-align: middle;
    }
    .data-card tbody tr:last-child td { border-bottom: none; }
    .data-card tbody tr:hover { background: #fafbfc; }

    .rank-badge {
        display: inline-flex; align-items: center; justify-content: center;
        width: 30px; height: 30px; border-radius: 8px;
        background: #f1f5f9; color: #64748b; font-weight: 800; font-size: 13px;
    }
    .rank-badge.gold { background: linear-gradient(135deg, #fbbf24 0%, #f59e0b 100%); color: #fff; box-shadow: 0 3px 8px rgba(245,158,11,.35); }
    .rank-badge.silver { background: linear-gradient(135deg, #cbd5e1 0%, #94a3b8 100%); color: #fff; box-shadow: 0 3px 8px rgba(148,163,184,.35); }
    .rank-badge.bronze { background: linear-gradient(135deg, #fb923c 0%, #ea580c 100%); color: #fff; box-shadow: 0 3px 8px rgba(234,88,12,.3); }

    .plate-tag {
        display: inline-block; background: #f1f5f9; border: 1px solid #e2e8f0;
        font-weight: 700; font-size: 12px; color: #0f172a;
        padding: 4px 10px; border-radius: 6px; font-variant-numeric: tabular-nums;
    }
    .money { font-variant-numeric: tabular-nums; font-weight: 700; color: #1d4ed8; }

    .empty-cell { padding: 60px 20px !important; text-align: center; color: #94a3b8; font-size: 14px; }

    @@media (max-width: 992px) {
        .summary-grid { grid-template-columns: repeat(2, 1fr); }
        .chart-grid { grid-template-columns: 1fr; }
    }
    @@media (max-width: 576px) {
        .summary-grid { grid-template-columns: 1fr; }
        .stat-header { flex-direction: column; align-items: flex-start; }
    }
</style>

<div class="stat-shell">
    <div class="stat-wrap">

        <!-- HEADER + NÚT XUẤT PDF -->
        <div class="stat-header">
            <div>
                <a asp-action="Index" class="back">← Quay lại Dashboard</a>
                <h1>Thống kê chi tiết</h1>
                <p class="sub">
                    Kỳ báo cáo:
                    <strong>@Model.TuNgay.ToString("dd/MM/yyyy")</strong>
                    –
                    <strong>@Model.DenNgay.ToString("dd/MM/yyyy")</strong>
                </p>
            </div>

            <a asp-action="XuatPdf"
               asp-route-tuNgay="@Model.TuNgay.ToString("yyyy-MM-dd")"
               asp-route-denNgay="@Model.DenNgay.ToString("yyyy-MM-dd")"
               class="btn-export-pdf">
                <span class="icon">📄</span>
                Xuất PDF
            </a>
        </div>

        <!-- FILTER -->
        <div class="filter-box">
            <form method="get" asp-action="ChiTiet" style="display: contents;">
                <div class="form-group">
                    <label class="form-label">Từ ngày</label>
                    <input type="date" name="tuNgay" value="@Model.TuNgay.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="form-group">
                    <label class="form-label">Đến ngày</label>
                    <input type="date" name="denNgay" value="@Model.DenNgay.ToString("yyyy-MM-dd")" class="form-control" />
                </div>
                <div class="btn-group">
                    <a asp-action="ChiTiet" class="btn btn-outline-secondary">Xóa lọc</a>
                    <button type="submit" class="btn btn-primary">Áp dụng</button>
                </div>
            </form>
        </div>

        <!-- SUMMARY -->
        <div class="summary-grid">
            <div class="summary-card blue">
                <div class="lbl">Tổng số đơn</div>
                <div class="num">@Model.TongSoDon</div>
                <div class="sub">Trong kỳ báo cáo</div>
            </div>
            <div class="summary-card green">
                <div class="lbl">Tổng doanh thu</div>
                <div class="num">@Model.TongDoanhThu.ToString("N0")</div>
                <div class="sub">VNĐ</div>
            </div>
            <div class="summary-card amber">
                <div class="lbl">Tổng phụ phí</div>
                <div class="num">@Model.TongPhuPhi.ToString("N0")</div>
                <div class="sub">VNĐ</div>
            </div>
            <div class="summary-card red">
                <div class="lbl">Tỷ lệ hủy / từ chối</div>
                <div class="num">@Model.TyLeHuy.ToString("N2")%</div>
                <div class="sub">@Model.SoDonHuy hủy · @Model.SoDonTuChoi từ chối</div>
            </div>
            <div class="summary-card purple">
                <div class="lbl">Tỷ lệ khai thác</div>
                <div class="num">@Model.TyLeKhaiThac.ToString("N2")%</div>
                <div class="sub">TB @Model.ThoiLuongThueTrungBinh ngày/đơn</div>
            </div>
        </div>

        <!-- BIEU DO -->
        <div class="section-head">
            <div class="icon"></div>
            <h6>Phân tích tổng quan</h6>
        </div>

        <div class="chart-grid">
            <div class="chart-card">
                <div class="chart-header">
                    <h6>Số lượt thuê theo loại xe</h6>
                    <span class="chart-badge">Bar Chart</span>
                </div>
                <div class="chart-body">
                    <canvas id="loaiXeChart"></canvas>
                </div>
            </div>

            <div class="chart-card">
                <div class="chart-header">
                    <h6>Doanh thu theo hãng xe</h6>
                    <span class="chart-badge">Pie Chart</span>
                </div>
                <div class="chart-body">
                    <canvas id="hangXeChart"></canvas>
                </div>
            </div>
        </div>

        <div class="chart-card" style="margin-bottom: 32px;">
            <div class="chart-header">
                <h6>Doanh thu 7 ngày gần nhất</h6>
                <span class="chart-badge">Line Chart</span>
            </div>
            <div class="chart-body" style="height: 280px;">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- TOP XE -->
        <div class="section-head">
            <div class="icon"></div>
            <h6>Top xe được thuê nhiều nhất</h6>
            <span class="count">@Model.TopXeThueNhieu.Count xe</span>
        </div>

        <div class="data-card">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:70px">Hạng</th>
                            <th>Biển số</th>
                            <th>Tên xe</th>
                            <th>Loại xe</th>
                            <th class="text-end">Số lần thuê</th>
                            <th class="text-end">Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopXeThueNhieu.Any())
                        {
                            int idx = 0;
                            foreach (var item in Model.TopXeThueNhieu)
                            {
                                idx++;
                                var rankClass = idx switch { 1 => "gold", 2 => "silver", 3 => "bronze", _ => "" };
                                <tr>
                                    <td><span class="rank-badge @rankClass">@idx</span></td>
                                    <td><span class="plate-tag">@item.BienSo</span></td>
                                    <td><strong>@item.TenXe</strong></td>
                                    <td class="text-muted">@item.TenLoaiXe</td>
                                    <td class="text-end"><strong style="font-size:15px">@item.SoLanThue</strong></td>
                                    <td class="text-end"><span class="money">@item.DoanhThu.ToString("N0") đ</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="empty-cell">Chưa có dữ liệu</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- THEO LOAI XE -->
        <div class="section-head">
            <div class="icon"></div>
            <h6>Thống kê theo loại xe</h6>
            <span class="count">@Model.ThongKeTheoLoaiXe.Count loại</span>
        </div>

        <div class="data-card">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Loại xe</th>
                            <th class="text-end">Số lần thuê</th>
                            <th class="text-end">Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ThongKeTheoLoaiXe.Any())
                        {
                            foreach (var item in Model.ThongKeTheoLoaiXe)
                            {
                                <tr>
                                    <td><strong>@item.TenLoaiXe</strong></td>
                                    <td class="text-end"><strong style="font-size:15px">@item.SoLanThue</strong></td>
                                    <td class="text-end"><span class="money">@item.DoanhThu.ToString("N0") đ</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="empty-cell">Chưa có dữ liệu</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- THEO HANG XE -->
        <div class="section-head">
            <div class="icon"></div>
            <h6>Thống kê theo hãng xe</h6>
            <span class="count">@Model.ThongKeTheoHangXe.Count hãng</span>
        </div>

        <div class="data-card">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Hãng xe</th>
                            <th class="text-end">Số lần thuê</th>
                            <th class="text-end">Doanh thu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ThongKeTheoHangXe.Any())
                        {
                            foreach (var item in Model.ThongKeTheoHangXe)
                            {
                                <tr>
                                    <td><strong>@item.TenHangXe</strong></td>
                                    <td class="text-end"><strong style="font-size:15px">@item.SoLanThue</strong></td>
                                    <td class="text-end"><span class="money">@item.DoanhThu.ToString("N0") đ</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="empty-cell">Chưa có dữ liệu</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TOP KHACH HANG -->
        <div class="section-head">
            <div class="icon"></div>
            <h6>Top khách hàng thuê nhiều nhất</h6>
            <span class="count">@Model.TopKhachHang.Count khách</span>
        </div>

        <div class="data-card">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:70px">Hạng</th>
                            <th>Khách hàng</th>
                            <th>Số điện thoại</th>
                            <th class="text-end">Số lần thuê</th>
                            <th class="text-end">Tổng chi tiêu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.TopKhachHang.Any())
                        {
                            int idx = 0;
                            foreach (var item in Model.TopKhachHang)
                            {
                                idx++;
                                var rankClass = idx switch { 1 => "gold", 2 => "silver", 3 => "bronze", _ => "" };
                                <tr>
                                    <td><span class="rank-badge @rankClass">@idx</span></td>
                                    <td><strong>@item.HoTen</strong></td>
                                    <td class="text-muted">@item.SoDienThoai</td>
                                    <td class="text-end"><strong style="font-size:15px">@item.SoLanThue</strong></td>
                                    <td class="text-end"><span class="money">@item.TongChiTieu.ToString("N0") đ</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="empty-cell">Chưa có dữ liệu</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- PHU PHI THEO LOAI -->
        <div class="section-head">
            <div class="icon"></div>
            <h6>Tổng phụ phí theo loại</h6>
        </div>

        <div class="data-card">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Loại phí</th>
                            <th class="text-end">Số lần phát sinh</th>
                            <th class="text-end">Tổng tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.PhuPhiTheoLoai)
                        {
                            <tr>
                                <td><strong>@item.LoaiPhi</strong></td>
                                <td class="text-end"><strong style="font-size:15px">@item.SoLan</strong></td>
                                <td class="text-end"><span class="money">@item.TongTien.ToString("N0") đ</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // ============ BIEU DO COT: SO LAN THUE THEO LOAI XE ============
        var loaiXeLabels = [
            @foreach (var item in Model.ThongKeTheoLoaiXe)
            {
                @: '@item.TenLoaiXe',
            }
        ];

        var loaiXeData = [
            @foreach (var item in Model.ThongKeTheoLoaiXe)
            {
                @: @item.SoLanThue,
            }
        ];

        new Chart(document.getElementById('loaiXeChart'), {
            type: 'bar',
            data: {
                labels: loaiXeLabels,
                datasets: [{
                    label: 'Số lượt thuê',
                    data: loaiXeData,
                    backgroundColor: [
                        'rgba(59,130,246,.85)',
                        'rgba(16,185,129,.85)',
                        'rgba(245,158,11,.85)',
                        'rgba(139,92,246,.85)',
                        'rgba(6,182,212,.85)'
                    ],
                    borderColor: ['#1d4ed8', '#059669', '#b45309', '#6d28d9', '#0e7490'],
                    borderWidth: 2,
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        padding: 12,
                        callbacks: {
                            label: function(ctx) { return 'Số lượt thuê: ' + ctx.parsed.y; }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, color: '#94a3b8' },
                        grid: { color: '#f1f5f9', drawBorder: false }
                    },
                    x: {
                        ticks: { color: '#64748b', font: { size: 11 } },
                        grid: { display: false }
                    }
                }
            }
        });

        // ============ BIEU DO TRON: DOANH THU THEO HANG XE ============
        var hangXeLabels = [
            @foreach (var item in Model.ThongKeTheoHangXe)
            {
                @: '@item.TenHangXe',
            }
        ];

        var hangXeData = [
            @foreach (var item in Model.ThongKeTheoHangXe)
            {
                @: @item.DoanhThu,
            }
        ];

        new Chart(document.getElementById('hangXeChart'), {
            type: 'pie',
            data: {
                labels: hangXeLabels,
                datasets: [{
                    data: hangXeData,
                    backgroundColor: ['#1d4ed8', '#10b981', '#f59e0b', '#8b5cf6', '#06b6d4'],
                    borderWidth: 3,
                    borderColor: '#fff',
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: {
                            padding: 14,
                            font: { size: 12 },
                            usePointStyle: true,
                            pointStyle: 'circle'
                        }
                    },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        padding: 12,
                        callbacks: {
                            label: function(ctx) {
                                var total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                                var percent = total > 0 ? (ctx.parsed / total * 100).toFixed(1) : 0;
                                return ctx.label + ': ' + new Intl.NumberFormat('vi-VN').format(ctx.parsed) + ' đ (' + percent + '%)';
                            }
                        }
                    }
                }
            }
        });

        // ============ BIEU DO DUONG: DOANH THU 7 NGAY ============
        var revenueLabels = [
            @foreach (var item in Model.DoanhThu7Ngay)
            {
                @: '@item.Ngay.ToString("dd/MM")',
            }
        ];

        var revenueData = [
            @foreach (var item in Model.DoanhThu7Ngay)
            {
                @: @item.DoanhThu,
            }
        ];

        var ctxRev = document.getElementById('revenueChart').getContext('2d');
        var gradRev = ctxRev.createLinearGradient(0, 0, 0, 280);
        gradRev.addColorStop(0, 'rgba(16,185,129,.4)');
        gradRev.addColorStop(1, 'rgba(16,185,129,.02)');

        new Chart(ctxRev, {
            type: 'line',
            data: {
                labels: revenueLabels,
                datasets: [{
                    label: 'Doanh thu',
                    data: revenueData,
                    borderColor: '#059669',
                    backgroundColor: gradRev,
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#059669',
                    pointBorderColor: '#fff',
                    pointBorderWidth: 2,
                    pointRadius: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0f172a',
                        padding: 12,
                        callbacks: {
                            label: function(ctx) {
                                return new Intl.NumberFormat('vi-VN').format(ctx.parsed.y) + ' đ';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(v) {
                                return new Intl.NumberFormat('vi-VN', { notation: 'compact', compactDisplay: 'short' }).format(v);
                            },
                            color: '#94a3b8'
                        },
                        grid: { color: '#f1f5f9', drawBorder: false }
                    },
                    x: {
                        ticks: { color: '#94a3b8' },
                        grid: { display: false }
                    }
                }
            }
        });
    </script>
}