@* [VIRELLO] Bảng màu CSS đã chuyển sang giao diện VIRELLO - Vũ Tiến Đạt (SV3) *@
@*
    LichSu.cshtml - lich su thue cua khach hang
    sinh vien thuc hien: Duong Lam Huy - 23103100120
    module 5 - tinh tien, thanh toan, lich su va thong ke
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.KhachHang.LichSuThueVM
@{
    ViewData["Title"] = "Lịch sử thuê";
    var kh = Model.KhachHang;
    int stt = 0;
}

<style>
    .page-shell { background: #000000; min-height: 100vh; padding: 32px 0; }
    .page-wrap { max-width: 1400px; margin: 0 auto; padding: 0 24px; }

    .page-head {
        margin-bottom: 24px;
        padding-bottom: 20px;
        border-bottom: 1px solid rgba(255,255,255,.1);
    }
    .page-head .back {
        font-size: 13px; color: #94a3b8; text-decoration: none;
        display: inline-block; margin-bottom: 8px;
    }
    .page-head .back:hover { color: #E50914; }
    .page-head h1 {
        font-size: 26px; font-weight: 800; color: #ffffff;
        letter-spacing: -0.4px; margin: 0 0 4px 0;
    }
    .page-head .sub { font-size: 14px; color: #94a3b8; margin: 0; }

    .stat-strip {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }
    .stat-card {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        padding: 18px 20px;
        border-left: 4px solid #E50914;
    }
    .stat-card.green { border-left-color: #10b981; }
    .stat-card.red { border-left-color: #ef4444; }
    .stat-card.blue { border-left-color: #E50914; }
    .stat-card.amber { border-left-color: #f59e0b; }
    .stat-card .lbl {
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .5px;
        color: #94a3b8; margin-bottom: 6px;
    }
    .stat-card .num {
        font-size: 22px; font-weight: 800;
        color: #ffffff; line-height: 1;
    }

    .kh-info-card {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        padding: 20px 24px;
        margin-bottom: 24px;
    }
    .kh-info-card h6 {
        font-size: 12px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 1.2px;
        color: #94a3b8; margin: 0 0 14px 0;
    }
    .kh-info-row {
        display: flex; gap: 24px;
        font-size: 14px;
    }
    .kh-info-row .item .lbl {
        font-size: 11px; color: #71717a;
        text-transform: uppercase; letter-spacing: .3px;
    }
    .kh-info-row .item .val {
        font-weight: 700; color: #ffffff;
        margin-top: 2px;
    }

    .data-card {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        overflow: hidden;
    }
    .data-card .card-head {
        display: flex; justify-content: space-between; align-items: center;
        padding: 18px 22px;
        border-bottom: 1px solid rgba(255,255,255,.06);
    }
    .data-card .card-head .title {
        font-size: 14px; font-weight: 700; color: #ffffff; margin: 0;
    }
    .data-card .card-head .count {
        font-size: 12px; color: #94a3b8;
        background: #1c1c1c;
        padding: 4px 12px; border-radius: 999px;
        font-weight: 600;
    }
    .data-card table { margin: 0; font-size: 14px; }
    .data-card thead th {
        background: #1c1c1c;
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .5px;
        color: #cbd5e1; padding: 14px 16px;
        border-bottom: 1px solid rgba(255,255,255,.1);
        white-space: nowrap;
    }
    .data-card tbody td {
        padding: 16px;
        border-bottom: 1px solid rgba(255,255,255,.06);
        vertical-align: middle;
    }
    .data-card tbody tr:last-child td { border-bottom: none; }

    .xe-cell { display: flex; align-items: center; gap: 10px; }
    .xe-thumb {
        width: 56px; height: 44px;
        object-fit: cover; border-radius: 0;
        border: 1px solid rgba(255,255,255,.1);
        flex-shrink: 0;
    }
    .xe-name {
        font-weight: 700; color: #ffffff;
        font-size: 13px; margin-bottom: 2px;
    }
    .xe-plate {
        display: inline-block;
        background: #1c1c1c;
        border: 1px solid rgba(255,255,255,.1);
        font-size: 11px; font-weight: 700;
        padding: 2px 8px;
        border-radius: 0;
        font-variant-numeric: tabular-nums;
    }

    .money { font-variant-numeric: tabular-nums; font-weight: 600; color: #ffffff; }
    .money.primary { color: #E50914; font-weight: 700; }

    .status-pill {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 11px; font-weight: 700;
        letter-spacing: .3px;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .status-pill.cho-duyet { background: rgba(245,158,11,.15); color: #fcd34d; }
    .status-pill.da-duyet { background: rgba(59,130,246,.20); color: #93c5fd; }
    .status-pill.da-ban-giao { background: rgba(6,182,212,.15); color: #67e8f9; }
    .status-pill.dang-thue { background: rgba(99,102,241,.18); color: #a5b4fc; }
    .status-pill.cho-thanh-toan { background: rgba(245,158,11,.28); color: #fcd34d; }
    .status-pill.hoan-thanh { background: rgba(34,197,94,.15); color: #86efac; }
    .status-pill.tu-choi { background: rgba(239,68,68,.15); color: #fca5a5; }
    .status-pill.da-huy { background: #1c1c1c; color: #94a3b8; }

    .action-cell {
        display: flex; justify-content: flex-end; gap: 6px;
    }
    .btn-clean {
        display: inline-flex;
        align-items: center; justify-content: center;
        padding: 7px 14px;
        font-size: 13px; font-weight: 600;
        border-radius: 0;
        border: 1px solid rgba(255,255,255,.2);
        background: #121212; color: #cbd5e1;
        text-decoration: none;
        transition: all .15s;
        line-height: 1; white-space: nowrap;
        min-height: 34px;
    }
    .btn-clean:hover { border-color: rgba(255,255,255,.3); background: #1c1c1c; color: #ffffff; }

    .empty-state {
        padding: 72px 24px; text-align: center; color: #71717a;
    }
    .empty-state .big {
        font-size: 42px; font-weight: 700;
        color: #3f3f46; letter-spacing: 4px;
    }
    .empty-state .msg { font-size: 15px; margin-top: 8px; }
</style>

<div class="page-shell">
    <div class="page-wrap">

        <div class="page-head">
            <a asp-action="Index" class="back">← Quay lại danh sách khách hàng</a>
            <h1>Lịch sử thuê xe</h1>
            <p class="sub">Toàn bộ lịch sử thuê xe của khách hàng</p>
        </div>

        <!-- THONG TIN KHACH HANG -->
        <div class="kh-info-card">
            <h6>Thông tin khách hàng</h6>
            <div class="kh-info-row">
                <div class="item">
                    <div class="lbl">Họ tên</div>
                    <div class="val">@kh.HoTen</div>
                </div>
                <div class="item">
                    <div class="lbl">Số điện thoại</div>
                    <div class="val">@kh.SoDienThoai</div>
                </div>
                <div class="item">
                    <div class="lbl">Email</div>
                    <div class="val">@(string.IsNullOrEmpty(kh.Email) ? "-" : kh.Email)</div>
                </div>
                <div class="item">
                    <div class="lbl">Số GPLX</div>
                    <div class="val">@(string.IsNullOrEmpty(kh.SoGiayPhepLaiXe) ? "-" : kh.SoGiayPhepLaiXe)</div>
                </div>
                <div class="item">
                    <div class="lbl">Địa chỉ</div>
                    <div class="val">@(string.IsNullOrEmpty(kh.DiaChi) ? "-" : kh.DiaChi)</div>
                </div>
            </div>
        </div>

        <!-- STATS -->
        <div class="stat-strip">
            <div class="stat-card blue">
                <div class="lbl">Tổng số đơn</div>
                <div class="num">@Model.TongSoDon</div>
            </div>
            <div class="stat-card green">
                <div class="lbl">Đơn hoàn thành</div>
                <div class="num">@Model.SoDonHoanThanh</div>
            </div>
            <div class="stat-card red">
                <div class="lbl">Đơn hủy / từ chối</div>
                <div class="num">@Model.SoDonHuy</div>
            </div>
            <div class="stat-card amber">
                <div class="lbl">Tổng phụ phí</div>
                <div class="num">@Model.TongPhuPhi.ToString("N0")</div>
            </div>
            <div class="stat-card green">
                <div class="lbl">Tổng chi tiêu</div>
                <div class="num">@Model.TongChiTieu.ToString("N0")</div>
            </div>
        </div>

        <!-- DANH SACH DON -->
        <div class="data-card">
            <div class="card-head">
                <h6 class="title">Danh sách đơn thuê</h6>
                <span class="count">@Model.DanhSachDon.Count đơn</span>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:56px">STT</th>
                            <th>Xe</th>
                            <th>Thời gian nhận</th>
                            <th>Thời gian trả</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Phụ phí</th>
                            <th>Trạng thái</th>
                            <th class="text-end" style="width:100px">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSachDon.Any())
                        {
                            foreach (var don in Model.DanhSachDon)
                            {
                                stt++;
                                var statusClass = don.TrangThai switch
                                {
                                    "Chờ duyệt" => "cho-duyet",
                                    "Đã duyệt" => "da-duyet",
                                    "Đã bàn giao" => "da-ban-giao",
                                    "Đang thuê" => "dang-thue",
                                    "Chờ thanh toán" => "cho-thanh-toan",
                                    "Hoàn thành" => "hoan-thanh",
                                    "Từ chối" => "tu-choi",
                                    "Đã hủy" => "da-huy",
                                    _ => "da-huy"
                                };

                                <tr>
                                    <td class="text-muted">@stt</td>

                                    <td>
                                        <div class="xe-cell">
                                            <img src="@(string.IsNullOrEmpty(don.Xe?.AnhXe) ? "/images/xe/default.jpg" : don.Xe.AnhXe)"
                                                 class="xe-thumb" alt="@don.Xe?.TenXe" />
                                            <div>
                                                <div class="xe-name">@don.Xe?.TenXe</div>
                                                <span class="xe-plate">@don.Xe?.BienSo</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="text-muted">
                                        @don.ThoiGianNhanDuKien.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td class="text-muted">
                                        @don.ThoiGianTraDuKien.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td class="text-end">
                                        <span class="money">@don.DonGiaApDung.ToString("N0") đ</span>
                                    </td>

                                    <td class="text-end">
                                        <span class="money">
                                            @(don.TraXe?.TongPhuPhi.ToString("N0") ?? "0") đ
                                        </span>
                                    </td>

                                    <td>
                                        <span class="status-pill @statusClass">@don.TrangThai</span>
                                    </td>

                                    <td>
                                        <div class="action-cell">
                                            <a asp-controller="DatXe" asp-action="Details"
                                               asp-route-id="@don.MaDatXe"
                                               class="btn-clean">Xem</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="empty-state">
                                        <div class="big">— — —</div>
                                        <div class="msg">Khách hàng chưa có đơn thuê nào</div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>