@* [VIRELLO] *@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Entities.DatXe
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants
@{
    ViewData["Title"] = "Chi tiết đơn đặt xe";

    var statusClass = Model.TrangThai switch
    {
        TrangThaiDatXe.ChoDuyet => "cho-duyet",
        TrangThaiDatXe.DaDuyet => "da-duyet",
        TrangThaiDatXe.DaBanGiao => "da-ban-giao",
        TrangThaiDatXe.DangThue => "dang-thue",
        TrangThaiDatXe.ChoThanhToan => "cho-thanh-toan",
        TrangThaiDatXe.HoanThanh => "hoan-thanh",
        TrangThaiDatXe.TuChoi => "tu-choi",
        TrangThaiDatXe.DaHuy => "da-huy",
        _ => "da-huy"
    };

    var vaiTro = Context.Session.GetString("VaiTro");
    var laKhachHang = vaiTro == "KhachHang";
    var coTheHuy = Model.TrangThai == TrangThaiDatXe.ChoDuyet || Model.TrangThai == TrangThaiDatXe.DaDuyet;

    var soNgay = Math.Max(1, (int)Math.Ceiling((Model.ThoiGianTraDuKien - Model.ThoiGianNhanDuKien).TotalDays));
    var tienThueDuKien = soNgay * Model.DonGiaApDung;

    // Lấy dữ liệu GPS để chuẩn bị hiển thị
    var lichSuGPS = ViewBag.LichSuDiChuyen as List<QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Entities.LichSuDiChuyen>;
    double? viDoBanGiao = Model.BanGiaoXe?.ViDoBanGiao;
    double? kinhDoBanGiao = Model.BanGiaoXe?.KinhDoBanGiao;
}

<style>
    .detail-shell { background: #000000; min-height: 100vh; padding: 32px 0; }
    .detail-wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }

    .detail-head {
        display: flex; justify-content: space-between; align-items: flex-end;
        margin-bottom: 28px; padding-bottom: 20px;
        border-bottom: 1px solid rgba(255,255,255,.1);
    }
    .detail-head .back { font-size: 13px; color: #94a3b8; text-decoration: none; display: inline-block; margin-bottom: 8px; }
    .detail-head .back:hover { color: #E50914; }
    .detail-head h1 { font-size: 26px; font-weight: 800; color: #ffffff; letter-spacing: -0.4px; margin: 0 0 8px 0; }
    .id-chip { display: inline-block; background: rgba(99,102,241,.18); color: #a5b4fc; font-weight: 700; font-size: 13px; padding: 4px 12px; border-radius: 0; margin-right: 8px; vertical-align: middle; }

    .status-pill { display: inline-block; padding: 6px 14px; border-radius: 999px; font-size: 12px; font-weight: 700; letter-spacing: .3px; text-transform: uppercase; }
    .status-pill.cho-duyet { background: rgba(245,158,11,.15); color: #fcd34d; }
    .status-pill.da-duyet { background: rgba(59,130,246,.20); color: #93c5fd; }
    .status-pill.da-ban-giao { background: rgba(6,182,212,.15); color: #67e8f9; }
    .status-pill.dang-thue { background: rgba(99,102,241,.18); color: #a5b4fc; }
    .status-pill.cho-thanh-toan { background: rgba(245,158,11,.28); color: #fcd34d; }
    .status-pill.hoan-thanh { background: rgba(34,197,94,.15); color: #86efac; }
    .status-pill.tu-choi { background: rgba(239,68,68,.15); color: #fca5a5; }
    .status-pill.da-huy { background: #1c1c1c; color: #94a3b8; }

    .info-card { background: #121212; border: 1px solid rgba(255,255,255,.1); border-radius: 0; padding: 26px 30px; height: 100%; }
    .info-card .title { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.2px; color: #94a3b8; margin: 0 0 20px 0; }
    .info-row { display: flex; justify-content: space-between; padding: 13px 0; border-bottom: 1px solid rgba(255,255,255,.06); font-size: 14px; }
    .info-row:last-child { border-bottom: none; }
    .info-row .lbl { color: #94a3b8; }
    .info-row .val { font-weight: 600; color: #ffffff; text-align: right; font-variant-numeric: tabular-nums; }

    .xe-hero { background: linear-gradient(135deg, #1c1c1c 0%, #0a0a0a 100%); color: #fff; border-radius: 0; padding: 24px 28px; margin-bottom: 20px; display: flex; align-items: center; gap: 20px; }
    .xe-hero img { width: 120px; height: 90px; object-fit: cover; border-radius: 0; border: 2px solid rgba(255,255,255,.3); flex-shrink: 0; }
    .xe-hero .info { flex: 1; }
    .xe-hero h3 { font-size: 22px; font-weight: 800; letter-spacing: -.4px; margin: 0 0 6px 0; }
    .xe-hero .plate { display: inline-block; background: rgba(255,255,255,.18); border: 1px solid rgba(255,255,255,.25); font-size: 13px; font-weight: 700; padding: 4px 12px; border-radius: 0; font-variant-numeric: tabular-nums; }

    .money { font-variant-numeric: tabular-nums; font-weight: 600; color: #ffffff; }
    .price-tile { background: #0a0a0a; border-radius: 0; padding: 20px 22px; text-align: center; border: 1px solid rgba(255,255,255,.1); }
    .price-tile .lbl { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; color: #94a3b8; margin-bottom: 10px; }
    .price-tile .val { font-size: 22px; font-weight: 800; letter-spacing: -.5px; font-variant-numeric: tabular-nums; }
    .price-tile.blue  { background: rgba(59,130,246,.15); border-color: rgba(59,130,246,.35); }
    .price-tile.blue  .val { color: #93c5fd; }
    .price-tile.amber { background: rgba(245,158,11,.10); border-color: rgba(245,158,11,.35); }
    .price-tile.amber .val { color: #fbbf24; }
    .price-tile.green { background: rgba(34,197,94,.10); border-color: rgba(34,197,94,.35); }
    .price-tile.green .val { color: #86efac; }
    
    /* Timeline lộ trình GPS */
    .timeline { position: relative; padding-left: 30px; }
    .timeline::before { content: ''; position: absolute; left: 10px; top: 0; bottom: 0; width: 2px; background: rgba(239,68,68,.3); }
    .timeline-item { position: relative; margin-bottom: 20px; }
    .timeline-item::before { content: ''; position: absolute; left: -24px; top: 4px; width: 10px; height: 10px; border-radius: 50%; background: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,.2); }
    .timeline-item.start::before { background: #10b981; box-shadow: 0 0 0 3px rgba(16,185,129,.2); }
    .timeline-time { font-size: 12px; color: #94a3b8; margin-bottom: 2px; }
    .timeline-text { font-size: 14px; color: #ffffff; font-weight: 600; }
</style>

<div class="detail-shell">
    <div class="detail-wrap">
        <!-- HEADER -->
        <div class="detail-head">
            <div>
                <a asp-action="DonCuaToi" class="back">← Quay lại danh sách</a>
                <h1>Đơn đặt xe <span class="id-chip">#@Model.MaDatXe</span></h1>
                <div><span class="status-pill @statusClass">@Model.TrangThai</span></div>
            </div>

            <div class="d-flex gap-2 flex-wrap justify-content-end">
                @if (coTheHuy) { <form asp-action="Huy" asp-route-id="@Model.MaDatXe" method="post" class="m-0"> @Html.AntiForgeryToken() <button type="submit" class="btn btn-outline-danger px-4 py-2 fw-semibold" style="border-radius:0" onclick="return confirm('Bạn có chắc muốn hủy đơn này?')">Hủy đơn</button> </form> }

                @if (!laKhachHang && Model.TrangThai == TrangThaiDatXe.ChoDuyet)
                {
                    <form asp-action="Duyet" asp-route-id="@Model.MaDatXe" method="post" class="m-0"> @Html.AntiForgeryToken() <button type="submit" class="btn btn-success px-4 py-2 fw-semibold text-white" style="border-radius:0" onclick="return confirm('Xác nhận duyệt đơn này?')">Duyệt đơn</button> </form>
                    <form asp-action="TuChoi" asp-route-id="@Model.MaDatXe" id="formTuChoi" method="post" class="m-0"> @Html.AntiForgeryToken() <input type="hidden" name="lyDoTuChoi" id="inputLyDo" value="" /> <button type="button" class="btn btn-danger px-4 py-2 fw-semibold text-white" style="border-radius:0" onclick="tuChoiDon()">Từ chối</button> </form>
                }

                @if (!laKhachHang && Model.TrangThai == TrangThaiDatXe.DaDuyet) { <a asp-controller="BanGiaoXe" asp-action="Index" asp-route-id="@Model.MaDatXe" class="btn btn-primary px-4 py-2 fw-semibold text-white" style="border-radius:0">Bàn giao xe</a> }
                @if (!laKhachHang && Model.TrangThai == TrangThaiDatXe.DangThue) { <a asp-controller="TraXe" asp-action="Index" asp-route-id="@Model.MaDatXe" class="btn btn-warning px-4 py-2 fw-semibold" style="border-radius:0">Nhận trả xe</a> }
                @if (!laKhachHang && Model.TrangThai == TrangThaiDatXe.ChoThanhToan) { <a asp-controller="ThanhToan" asp-action="ThanhToan" asp-route-id="@Model.MaDatXe" class="btn btn-success px-4 py-2 fw-semibold text-white" style="border-radius:0">Tiến hành Thanh toán</a> }

                @if (Model.BanGiaoXe != null || Model.TrangThai == TrangThaiDatXe.DangThue || Model.TrangThai == TrangThaiDatXe.ChoThanhToan || Model.TrangThai == TrangThaiDatXe.HoanThanh)
                {
                    <a asp-controller="BanGiaoXe" asp-action="BienBanDienTu" asp-route-id="@Model.MaDatXe" class="btn btn-outline-info px-3 py-2 fw-semibold" style="border-radius:0">Biên bản & Mã QR Bàn giao</a>
                }

                @if (!laKhachHang && Model.TrangThai == TrangThaiDatXe.DangThue)
                {
                    <button type="button" class="btn btn-info px-4 py-2 fw-semibold text-white" data-bs-toggle="modal" data-bs-target="#trackingModal" style="border-radius:0"><i class="fa-solid fa-map-location-dot"></i> Xem lộ trình GPS</button>
                    <form asp-controller="GPS" asp-action="GiaLapDiChuyen" method="post" class="d-inline m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maDatXe" value="@Model.MaDatXe" />
                        <button type="submit" class="btn btn-warning px-3 py-2 fw-semibold" style="border-radius:0" title="Bấm để giả lập xe chạy thêm 1 điểm"><i class="fa-solid fa-satellite-dish"></i> Giả lập xe chạy</button>
                    </form>
                }
            </div>
        </div>

        <!-- XE HERO -->
        @if (Model.Xe != null)
        {
            <div class="xe-hero">
                <img src="@(string.IsNullOrEmpty(Model.Xe.AnhXe) ? "/images/xe/default.jpg" : Model.Xe.AnhXe)" alt="@Model.Xe.TenXe" />
                <div class="info">
                    <h3>@Model.Xe.TenXe</h3>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="plate">@Model.Xe.BienSo</span>
                        <span class="plate">@Model.Xe.SoCho chỗ</span>
                        <span class="plate">@(Model.Xe.LoaiXe?.TenLoaiXe ?? "-")</span>
                    </div>
                </div>
            </div>
        }

        <!-- THÔNG TIN -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="info-card">
                    <h6 class="title">Thông tin khách hàng</h6>
                    <div class="info-row"><span class="lbl">Họ tên</span><span class="val">@Model.KhachHang?.HoTen</span></div>
                    <div class="info-row"><span class="lbl">Số điện thoại</span><span class="val">@Model.KhachHang?.SoDienThoai</span></div>
                    <div class="info-row"><span class="lbl">Email</span><span class="val">@(string.IsNullOrEmpty(Model.KhachHang?.Email) ? "—" : Model.KhachHang.Email)</span></div>
                    <div class="info-row"><span class="lbl">Địa chỉ</span><span class="val">@(string.IsNullOrEmpty(Model.KhachHang?.DiaChi) ? "—" : Model.KhachHang.DiaChi)</span></div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-card">
                    <h6 class="title">Thông tin thuê xe</h6>
                    <div class="info-row"><span class="lbl">Ngày đặt</span><span class="val">@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</span></div>
                    <div class="info-row"><span class="lbl">Thời gian nhận</span><span class="val">@Model.ThoiGianNhanDuKien.ToString("dd/MM/yyyy HH:mm")</span></div>
                    <div class="info-row"><span class="lbl">Thời gian trả</span><span class="val">@Model.ThoiGianTraDuKien.ToString("dd/MM/yyyy HH:mm")</span></div>
                    <div class="info-row"><span class="lbl">Địa điểm nhận</span><span class="val">@Model.DiaDiemNhan</span></div>
                    <div class="info-row"><span class="lbl">Địa điểm trả</span><span class="val">@Model.DiaDiemTra</span></div>
                </div>
            </div>
        </div>

        <!-- CHI PHÍ -->
        <div class="row g-4 mb-4">
            <div class="col-md-3"><div class="price-tile blue"><div class="lbl">Đơn giá ngày</div><div class="val">@Model.DonGiaApDung.ToString("N0")</div></div></div>
            <div class="col-md-3"><div class="price-tile blue"><div class="lbl">Số ngày thuê</div><div class="val">@soNgay ngày</div></div></div>
            <div class="col-md-3"><div class="price-tile blue"><div class="lbl">Tiền thuê dự kiến</div><div class="val">@tienThueDuKien.ToString("N0")</div></div></div>
            <div class="col-md-3"><div class="price-tile amber"><div class="lbl">Tiền cọc</div><div class="val">@Model.TienCoc.ToString("N0")</div></div></div>
        </div>

        <!-- GHI CHÚ -->
        @if (!string.IsNullOrEmpty(Model.GhiChu) || !string.IsNullOrEmpty(Model.LyDoTuChoi))
        {
            <div class="row g-4">
                @if (!string.IsNullOrEmpty(Model.GhiChu)) { <div class="col-md-6"><div class="info-card"><h6 class="title">Ghi chú</h6><div class="p-3 bg-light rounded">@Model.GhiChu</div></div></div> }
                @if (!string.IsNullOrEmpty(Model.LyDoTuChoi)) { <div class="col-md-6"><div class="info-card"><h6 class="title">Lý do từ chối</h6><div class="p-3 rounded" style="background:rgba(239,68,68,.15);color:#fca5a5">@Model.LyDoTuChoi</div></div></div> }
            </div>
        }
    </div>
</div>

<!-- MODAL BẢN ĐỒ LỘ TRÌNH GPS (DÙNG IFRAME GOOGLE MAPS) -->
<div class="modal fade" id="trackingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="background: #121212; border: 1px solid rgba(255,255,255,.1); border-radius: 0;">
            <div class="modal-header border-0">
                <h5 class="modal-title text-white"><i class="fa-solid fa-map-location-dot text-info"></i> Lộ trình xe #@Model.MaDatXe</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    <!-- Cột trái: Timeline các điểm di chuyển -->
                    <div class="col-md-4" style="max-height: 500px; overflow-y: auto;">
                        <h6 class="text-white fw-bold mb-4">Nhật ký di chuyển</h6>
                        
                        <div class="timeline">
                            <!-- Điểm bàn giao -->
                            @if (viDoBanGiao.HasValue && kinhDoBanGiao.HasValue)
                            {
                                <div class="timeline-item start">
                                    <div class="timeline-time">@(Model.BanGiaoXe?.ThoiGianBanGiao.ToString("HH:mm - dd/MM/yyyy"))</div>
                                    <div class="timeline-text text-success">Bàn giao xe</div>
                                    <div class="mt-2">
                                        <a href="https://maps.google.com/maps?q=@viDoBanGiao,@kinhDoBanGiao" target="_blank" class="btn btn-sm btn-outline-success">Xem trên Maps</a>
                                    </div>
                                </div>
                            }

                            <!-- Các điểm di chuyển -->
                            @if (lichSuGPS != null && lichSuGPS.Any())
                            {
                                foreach (var item in lichSuGPS)
                                {
                                    <div class="timeline-item">
                                        <div class="timeline-time">@item.ThoiGian.ToString("HH:mm - dd/MM/yyyy")</div>
                                        <div class="timeline-text">Xe di chuyển</div>
                                        <div class="mt-2">
                                            <a href="https://maps.google.com/maps?q=@item.ViDo,@item.KinhDo" target="_blank" class="btn btn-sm btn-outline-danger">Xem trên Maps</a>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="text-muted small mt-3">Chưa có dữ liệu di chuyển.</div>
                            }
                        </div>
                    </div>

                    <!-- Cột phải: Bản đồ lớn (Iframe Google Maps) -->
                    <div class="col-md-8">
                        @if (viDoBanGiao.HasValue && kinhDoBanGiao.HasValue)
                        {
                            <div class="google-map-wrapper h-100" style="min-height: 500px; border-radius: 8px; overflow: hidden; border: 1px solid rgba(255,255,255,.1);">
                                <iframe 
                                    src="https://maps.google.com/maps?q=@viDoBanGiao,@kinhDoBanGiao&hl=vi&z=15&output=embed" 
                                    width="100%" 
                                    height="100%" 
                                    style="border:0;" 
                                    allowfullscreen="" 
                                    loading="lazy" 
                                    referrerpolicy="no-referrer-when-downgrade">
                                </iframe>
                            </div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                Không có dữ liệu vị trí bàn giao ban đầu.
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function tuChoiDon() {
            var lyDo = prompt('Vui lòng nhập lý do từ chối đơn này:');
            if (lyDo != null && lyDo.trim() !== '') {
                document.getElementById('inputLyDo').value = lyDo;
                document.getElementById('formTuChoi').submit();
            } else if (lyDo != null) {
                alert('Bạn phải nhập lý do từ chối!');
            }
        }
    </script>
}