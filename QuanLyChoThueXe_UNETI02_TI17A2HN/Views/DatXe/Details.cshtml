@* 
   File: Views/DatXe/Details.cshtml
   Noi dung: Chi tiet don dat xe
   Sinh vien thuc hien: Vu Tien Dat - 23103100119 - SV3
   Module: Module 3 - Khach hang, Tim xe trong va Dat xe
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Entities.DatXe
@{
    ViewData["Title"] = "Chi tiết đơn đặt xe";

    var statusClass = Model.TrangThai switch
    {
        "Chờ duyệt" => "cho-duyet",
        "Đã duyệt" => "da-duyet",
        "Đã bàn giao" => "da-ban-giao",
        "Đang thuê" => "dang-thue",
        "Chờ thanh toán" => "cho-thanh-toan",
        "Hoàn thành" => "hoan-thanh",
        "Từ chối" => "tu-choi",
        "Đã hủy" => "da-huy",
        _ => "da-huy"
    };

    var vaiTro = Context.Session.GetString("VaiTro");
    var laKhachHang = vaiTro == "KhachHang";
    var coTheHuy = Model.TrangThai == "Chờ duyệt" || Model.TrangThai == "Đã duyệt";

    var soNgay = Math.Max(1, (int)Math.Ceiling((Model.ThoiGianTraDuKien - Model.ThoiGianNhanDuKien).TotalDays));
    var tienThueDuKien = soNgay * Model.DonGiaApDung;
}

<style>
    .detail-shell { background: #f5f7fa; min-height: 100vh; padding: 32px 0; }
    .detail-wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }

    .detail-head {
        display: flex; justify-content: space-between; align-items: flex-end;
        margin-bottom: 28px; padding-bottom: 20px;
        border-bottom: 1px solid #e5e7eb;
    }
    .detail-head .back {
        font-size: 13px; color: #64748b; text-decoration: none;
        display: inline-block; margin-bottom: 8px;
    }
    .detail-head .back:hover { color: #1d4ed8; }
    .detail-head h1 {
        font-size: 26px; font-weight: 800; color: #0f172a;
        letter-spacing: -0.4px; margin: 0 0 8px 0;
    }
    .id-chip {
        display: inline-block;
        background: #e0e7ff; color: #3730a3;
        font-weight: 700; font-size: 13px;
        padding: 4px 12px; border-radius: 8px;
        margin-right: 8px; vertical-align: middle;
    }

    .status-pill {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 12px; font-weight: 700;
        letter-spacing: .3px;
        text-transform: uppercase;
    }
    .status-pill.cho-duyet { background: #fef3c7; color: #92400e; }
    .status-pill.da-duyet { background: #dbeafe; color: #1e40af; }
    .status-pill.da-ban-giao { background: #cffafe; color: #155e75; }
    .status-pill.dang-thue { background: #e0e7ff; color: #3730a3; }
    .status-pill.cho-thanh-toan { background: #fde68a; color: #78350f; }
    .status-pill.hoan-thanh { background: #dcfce7; color: #166534; }
    .status-pill.tu-choi { background: #fee2e2; color: #991b1b; }
    .status-pill.da-huy { background: #f1f5f9; color: #64748b; }

    .info-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 26px 30px;
        height: 100%;
    }
    .info-card .title {
        font-size: 12px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 1.2px;
        color: #64748b; margin: 0 0 20px 0;
    }
    .info-row {
        display: flex; justify-content: space-between;
        padding: 13px 0; border-bottom: 1px solid #f1f5f9;
        font-size: 14px;
    }
    .info-row:last-child { border-bottom: none; }
    .info-row .lbl { color: #64748b; }
    .info-row .val {
        font-weight: 600; color: #0f172a; text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .xe-hero {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: #fff;
        border-radius: 14px;
        padding: 24px 28px;
        margin-bottom: 20px;
        display: flex; align-items: center; gap: 20px;
    }
    .xe-hero img {
        width: 120px; height: 90px;
        object-fit: cover;
        border-radius: 10px;
        border: 2px solid rgba(255,255,255,.3);
        flex-shrink: 0;
    }
    .xe-hero .info { flex: 1; }
    .xe-hero h3 {
        font-size: 22px; font-weight: 800;
        letter-spacing: -.4px; margin: 0 0 6px 0;
    }
    .xe-hero .plate {
        display: inline-block;
        background: rgba(255,255,255,.18);
        border: 1px solid rgba(255,255,255,.25);
        font-size: 13px; font-weight: 700;
        padding: 4px 12px; border-radius: 8px;
        font-variant-numeric: tabular-nums;
    }

    .money {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        color: #0f172a;
    }
    .money.primary { color: #1d4ed8; font-size: 16px; font-weight: 800; }
    .money .unit { font-size: 11px; font-weight: 500; color: #94a3b8; margin-left: 2px; }

    .price-tile {
        background: #f8fafc;
        border-radius: 12px;
        padding: 20px 22px;
        text-align: center;
        border: 1px solid #e2e8f0;
    }
    .price-tile .lbl {
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 1px;
        color: #64748b; margin-bottom: 10px;
    }
    .price-tile .val {
        font-size: 22px; font-weight: 800;
        letter-spacing: -.5px;
        font-variant-numeric: tabular-nums;
    }
    .price-tile.blue  { background: #eff6ff; border-color: #bfdbfe; }
    .price-tile.blue  .val { color: #1d4ed8; }
    .price-tile.amber { background: #fffbeb; border-color: #fde68a; }
    .price-tile.amber .val { color: #b45309; }
    .price-tile.green { background: #f0fdf4; border-color: #bbf7d0; }
    .price-tile.green .val { color: #15803d; }
</style>

<div class="detail-shell">
    <div class="detail-wrap">

        <!-- HEADER -->
        <div class="detail-head">
            <div>
                <a asp-action="DonCuaToi" class="back">← Quay lại danh sách</a>
                <h1>
                    Đơn đặt xe
                    <span class="id-chip">#@Model.MaDatXe</span>
                </h1>
                <div>
                    <span class="status-pill @statusClass">@Model.TrangThai</span>
                </div>
            </div>

            <div class="d-flex gap-2">
                @if (coTheHuy)
                {
                    <form asp-action="Huy" asp-route-id="@Model.MaDatXe" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger px-4 py-2 fw-semibold"
                                style="border-radius:8px"
                                onclick="return confirm('Bạn có chắc muốn hủy đơn này?')">Hủy đơn</button>
                    </form>
                }

                <!-- === BAT DAU CODE CUA SV4: NGUYEN HOANG DUC HIEU (23103100116) === -->
                @if (!laKhachHang && Model.TrangThai == QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants.TrangThaiDatXe.ChoDuyet)
                {
                    <form asp-action="Duyet" asp-route-id="@Model.MaDatXe" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success px-4 py-2 fw-semibold text-white"
                                style="border-radius:8px"
                                onclick="return confirm('Xác nhận duyệt đơn này?')">Duyệt đơn</button>
                    </form>

                    <form asp-action="TuChoi" asp-route-id="@Model.MaDatXe" id="formTuChoi" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="lyDoTuChoi" id="inputLyDo" value="" />
                        <button type="button" class="btn btn-danger px-4 py-2 fw-semibold text-white"
                                style="border-radius:8px"
                                onclick="tuChoiDon()">Từ chối</button>
                    </form>
                }

                @if (!laKhachHang && Model.TrangThai == QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants.TrangThaiDatXe.DaDuyet)
                {
                    <a asp-controller="DatXe" asp-action="BanGiao" asp-route-id="@Model.MaDatXe" class="btn btn-primary px-4 py-2 fw-semibold text-white" style="border-radius:8px">Bàn giao xe</a>
                }

                @if (!laKhachHang && Model.TrangThai == QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants.TrangThaiDatXe.DangThue)
                {
                    <a asp-controller="DatXe" asp-action="TraXe" asp-route-id="@Model.MaDatXe" class="btn btn-warning px-4 py-2 fw-semibold" style="border-radius:8px">Nhận trả xe</a>
                }
                <!-- === KET THUC CODE CUA SV4 : NGUYEN HOANG DUC HIEU === -->
            </div>
        </div>

        <!-- XE HERO -->
        @if (Model.Xe != null)
        {
            <div class="xe-hero">
                <img src="@(string.IsNullOrEmpty(Model.Xe.AnhXe) ? "/images/xe/default.jpg" : Model.Xe.AnhXe)"
                     alt="@Model.Xe.TenXe" />
                <div class="info">
                    <h3>@Model.Xe.TenXe</h3>
                    <div class="d-flex gap-2 flex-wrap">
                        <span class="plate">@Model.Xe.BienSo</span>
                        <span class="plate">@Model.Xe.SoCho chỗ</span>
                        <span class="plate">@(Model.Xe.LoaiXe?.TenLoaiXe ?? "-")</span>
                    </div>
                </div>
            </div>
        }

        <!-- THÔNG TIN -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="info-card">
                    <h6 class="title">Thông tin khách hàng</h6>
                    <div class="info-row">
                        <span class="lbl">Họ tên</span>
                        <span class="val">@Model.KhachHang?.HoTen</span>
                    </div>
                    <div class="info-row">
                        <span class="lbl">Số điện thoại</span>
                        <span class="val">@Model.KhachHang?.SoDienThoai</span>
                    </div>
                    <div class="info-row">
                        <span class="lbl">Email</span>
                        <span class="val">@(string.IsNullOrEmpty(Model.KhachHang?.Email) ? "—" : Model.KhachHang.Email)</span>
                    </div>
                    <div class="info-row">
                        <span class="lbl">Địa chỉ</span>
                        <span class="val">@(string.IsNullOrEmpty(Model.KhachHang?.DiaChi) ? "—" : Model.KhachHang.DiaChi)</span>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-card">
                    <h6 class="title">Thông tin thuê xe</h6>
                    <div class="info-row">
                        <span class="lbl">Ngày đặt</span>
                        <span class="val">@Model.NgayDat.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="info-row">
                        <span class="lbl">Thời gian nhận</span>
                        <span class="val">@Model.ThoiGianNhanDuKien.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="info-row">
                        <span class="lbl">Thời gian trả</span>
                        <span class="val">@Model.ThoiGianTraDuKien.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="info-row">
                        <span class="lbl">Địa điểm nhận</span>
                        <span class="val">@Model.DiaDiemNhan</span>
                    </div>
                    <div class="info-row">
                        <span class="lbl">Địa điểm trả</span>
                        <span class="val">@Model.DiaDiemTra</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- CHI PHÍ -->
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="price-tile blue">
                    <div class="lbl">Đơn giá ngày</div>
                    <div class="val">@Model.DonGiaApDung.ToString("N0")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="price-tile blue">
                    <div class="lbl">Số ngày thuê</div>
                    <div class="val">@soNgay ngày</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="price-tile blue">
                    <div class="lbl">Tiền thuê dự kiến</div>
                    <div class="val">@tienThueDuKien.ToString("N0")</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="price-tile amber">
                    <div class="lbl">Tiền cọc</div>
                    <div class="val">@Model.TienCoc.ToString("N0")</div>
                </div>
            </div>
        </div>

        <!-- GHI CHÚ -->
        @if (!string.IsNullOrEmpty(Model.GhiChu) || !string.IsNullOrEmpty(Model.LyDoTuChoi))
        {
            <div class="row g-4">
                @if (!string.IsNullOrEmpty(Model.GhiChu))
                {
                    <div class="col-md-6">
                        <div class="info-card">
                            <h6 class="title">Ghi chú</h6>
                            <div class="p-3 bg-light rounded">@Model.GhiChu</div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.LyDoTuChoi))
                {
                    <div class="col-md-6">
                        <div class="info-card">
                            <h6 class="title">Lý do từ chối</h6>
                            <div class="p-3 rounded" style="background:#fee2e2;color:#991b1b">
                                @Model.LyDoTuChoi
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
@section Scripts {
    <script>
        // === BAT DAU CODE CUA SV4:  NGUYEN HOANG DUC HIEU (23103100116) ===
        function tuChoiDon() {
            var lyDo = prompt('Vui lòng nhập lý do từ chối đơn này:');
            if (lyDo != null && lyDo.trim() !== '') {
                document.getElementById('inputLyDo').value = lyDo;
                document.getElementById('formTuChoi').submit();
            } else if (lyDo != null) {
                alert('Bạn phải nhập lý do từ chối!');
            }
        }
        // === KET THUC CODE CUA NGUYEN HOANG DUC HIEU ===
    </script>
}