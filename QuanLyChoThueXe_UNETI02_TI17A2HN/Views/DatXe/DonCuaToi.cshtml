@* [VIRELLO] Bảng màu CSS đã chuyển sang giao diện VIRELLO - Vũ Tiến Đạt (SV3) *@
@* 
   File: Views/DatXe/DonCuaToi.cshtml
   Noi dung: Danh sach don dat xe cua khach hang dang nhap
   Sinh vien thuc hien: Vu Tien Dat - 23103100119 - SV3
   Module: Module 3 - Khach hang, Tim xe trong va Dat xe
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.DatXe.DatXeListVM
@{
    ViewData["Title"] = "Đơn của tôi";
    int stt = (Model.Trang - 1) * Model.KichThuocTrang;

    var tongDon = Model.TongSoBanGhi;
    var choDuyet = Model.DanhSach.Count(x => x.TrangThai == "Chờ duyệt");
    var daDuyet = Model.DanhSach.Count(x => x.TrangThai == "Đã duyệt");
    var hoanThanh = Model.DanhSach.Count(x => x.TrangThai == "Hoàn thành");
}

<style>
    .page-shell { background: #000000; min-height: 100vh; padding: 32px 0; }
    .page-wrap { max-width: 1440px; margin: 0 auto; padding: 0 24px; }

    .hero {
        background: linear-gradient(135deg, #1c1c1c 0%, #0a0a0a 100%);
        color: #fff;
        border-radius: 0;
        padding: 32px 30px;
        margin-bottom: 24px;
    }
    .hero h1 { font-size: 28px; font-weight: 800; letter-spacing: -.6px; margin: 0 0 6px 0; }
    .hero p { font-size: 14px; opacity: .85; margin: 0 0 20px 0; }
    .stat-row { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
    .stat-row .stat {
        background: rgba(255,255,255,.12);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 0;
        padding: 14px 16px;
    }
    .stat-row .stat .lbl {
        font-size: 11px; text-transform: uppercase;
        letter-spacing: .8px; opacity: .8; margin-bottom: 6px;
    }
    .stat-row .stat .num { font-size: 22px; font-weight: 800; line-height: 1; }

    .filter-card {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        padding: 18px 22px;
        margin-bottom: 20px;
    }
    .filter-card .form-label {
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .5px;
        color: #94a3b8; margin-bottom: 6px;
    }
    .filter-card .form-control,
    .filter-card .form-select {
        border-radius: 0; border-color: rgba(255,255,255,.2);
        font-size: 14px; height: 40px;
    }
    .filter-card .form-control:focus,
    .filter-card .form-select:focus {
        border-color: #E50914;
        box-shadow: 0 0 0 3px rgba(229,9,20,.12);
    }

    .data-card {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        overflow: hidden;
    }
    .data-card .card-head {
        display: flex; justify-content: space-between; align-items: center;
        padding: 18px 22px;
        border-bottom: 1px solid rgba(255,255,255,.06);
    }
    .data-card .card-head .title {
        font-size: 14px; font-weight: 700; color: #ffffff; margin: 0;
    }
    .data-card .card-head .count {
        font-size: 12px; color: #94a3b8;
        background: #1c1c1c;
        padding: 4px 12px; border-radius: 999px;
        font-weight: 600;
    }
    .data-card table { margin: 0; font-size: 14px; }
    .data-card thead th {
        background: #1c1c1c;
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .5px;
        color: #cbd5e1; padding: 14px 16px;
        border-bottom: 1px solid rgba(255,255,255,.1);
        white-space: nowrap;
    }
    .data-card tbody td {
        padding: 16px;
        border-bottom: 1px solid rgba(255,255,255,.06);
        vertical-align: middle;
    }
    .data-card tbody tr:last-child td { border-bottom: none; }
    .data-card tbody tr:hover { background: #161616; }

    .xe-cell { display: flex; align-items: center; gap: 12px; }
    .xe-thumb {
        width: 60px; height: 46px;
        object-fit: cover; border-radius: 0;
        border: 1px solid rgba(255,255,255,.1);
        flex-shrink: 0;
    }
    .xe-name { font-weight: 700; color: #ffffff; font-size: 14px; }
    .xe-plate {
        display: inline-block;
        background: #1c1c1c;
        border: 1px solid rgba(255,255,255,.1);
        font-size: 11px; font-weight: 700;
        padding: 2px 8px;
        border-radius: 0;
        margin-top: 2px;
        font-variant-numeric: tabular-nums;
    }

    .time-cell { font-size: 13px; }
    .time-cell .lbl { color: #94a3b8; font-size: 11px; display: block; }
    .time-cell .val { font-weight: 600; color: #ffffff; font-variant-numeric: tabular-nums; }

    .status-pill {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .3px;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .status-pill.cho-duyet { background: rgba(245,158,11,.15); color: #fcd34d; }
    .status-pill.da-duyet { background: rgba(59,130,246,.20); color: #93c5fd; }
    .status-pill.da-ban-giao { background: rgba(6,182,212,.15); color: #67e8f9; }
    .status-pill.dang-thue { background: rgba(99,102,241,.18); color: #a5b4fc; }
    .status-pill.cho-thanh-toan { background: rgba(245,158,11,.28); color: #fcd34d; }
    .status-pill.hoan-thanh { background: rgba(34,197,94,.15); color: #86efac; }
    .status-pill.tu-choi { background: rgba(239,68,68,.15); color: #fca5a5; }
    .status-pill.da-huy { background: #1c1c1c; color: #94a3b8; }

    .money { font-variant-numeric: tabular-nums; font-weight: 600; color: #ffffff; }
    .money.primary { color: #E50914; font-weight: 700; font-size: 15px; }
    .money .unit { font-size: 11px; font-weight: 500; color: #71717a; margin-left: 2px; }

    .action-cell { display: flex; justify-content: flex-end; gap: 6px; flex-wrap: nowrap; }
    .btn-clean {
        display: inline-flex; align-items: center; justify-content: center;
        padding: 7px 14px;
        font-size: 13px; font-weight: 600;
        border-radius: 0;
        border: 1px solid rgba(255,255,255,.2);
        background: #121212; color: #cbd5e1;
        text-decoration: none;
        transition: all .15s;
        line-height: 1; white-space: nowrap;
        min-height: 34px;
    }
    .btn-clean:hover { border-color: rgba(255,255,255,.3); background: #1c1c1c; color: #ffffff; }
    .btn-clean.danger { color: #fca5a5; border-color: rgba(239,68,68,.4); }
    .btn-clean.danger:hover { background: rgba(239,68,68,.10); }

    .empty-state {
        padding: 72px 24px; text-align: center; color: #71717a;
    }
    .empty-state .big { font-size: 42px; color: #3f3f46; letter-spacing: 4px; }
    .empty-state .msg { font-size: 15px; margin-top: 8px; }

    .pager {
        display: flex; justify-content: space-between; align-items: center;
        padding: 16px 22px;
        background: #1c1c1c;
        border-top: 1px solid rgba(255,255,255,.1);
        font-size: 13px; color: #94a3b8;
    }
    .pager .pagination { margin: 0; }
    .pager .page-link {
        border-radius: 0; margin: 0 2px;
        border-color: rgba(255,255,255,.1); color: #cbd5e1;
        font-size: 13px; font-weight: 600;
        padding: 6px 12px;
    }
    .pager .page-item.active .page-link {
        background: #b80710; border-color: #E50914;
    }
</style>

<div class="page-shell">
    <div class="page-wrap">

        <!-- HERO -->
        <div class="hero">
            <h1>Đơn đặt xe của tôi</h1>
            <p>Theo dõi trạng thái các đơn đặt xe bạn đã tạo</p>
            <div class="stat-row">
                <div class="stat">
                    <div class="lbl">Tổng đơn</div>
                    <div class="num">@tongDon</div>
                </div>
                <div class="stat">
                    <div class="lbl">Chờ duyệt</div>
                    <div class="num">@choDuyet</div>
                </div>
                <div class="stat">
                    <div class="lbl">Đã duyệt</div>
                    <div class="num">@daDuyet</div>
                </div>
                <div class="stat">
                    <div class="lbl">Hoàn thành</div>
                    <div class="num">@hoanThanh</div>
                </div>
            </div>
        </div>

        <!-- THÔNG BÁO -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>Thành công.</strong> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Lỗi.</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- FILTER -->
        <div class="filter-card">
            <form method="get" asp-action="DonCuaToi">
                <input type="hidden" name="trang" value="1" />

                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Từ khóa</label>
                        <input type="text" name="tuKhoa" value="@Model.TuKhoa"
                               class="form-control" placeholder="Biển số, tên xe..." />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Trạng thái</label>
                        <select name="trangThai" class="form-select" asp-items="Model.DanhSachTrangThai">
                            <option value="">Tất cả</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Loại xe</label>
                        <select name="maLoaiXe" class="form-select" asp-items="Model.DanhSachLoaiXe">
                            <option value="">Tất cả</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Từ ngày nhận</label>
                        <input type="date" name="tuNgay" value="@(Model.TuNgay?.ToString("yyyy-MM-dd"))"
                               class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Đến ngày</label>
                        <input type="date" name="denNgay" value="@(Model.DenNgay?.ToString("yyyy-MM-dd"))"
                               class="form-control" />
                    </div>

                    <div class="col-md-1">
                        <label class="form-label">Hiển thị</label>
                        <select name="kichThuocTrang" class="form-select">
                            <option value="10" selected="@(Model.KichThuocTrang == 10)">10</option>
                            <option value="20" selected="@(Model.KichThuocTrang == 20)">20</option>
                            <option value="50" selected="@(Model.KichThuocTrang == 50)">50</option>
                        </select>
                    </div>

                    <div class="col-md-11 d-flex justify-content-end gap-2">
                        <a asp-action="DonCuaToi" class="btn btn-outline-secondary px-3">Xóa lọc</a>
                        <button type="submit" class="btn btn-primary px-4">Áp dụng</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- DATA -->
        <div class="data-card">
            <div class="card-head">
                <h6 class="title">Danh sách đơn</h6>
                <span class="count">@Model.DanhSach.Count / @Model.TongSoBanGhi đơn</span>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:56px">STT</th>
                            <th>Xe</th>
                            <th>Thời gian thuê</th>
                            <th class="text-end">Đơn giá / ngày</th>
                            <th class="text-end">Tiền cọc</th>
                            <th>Trạng thái</th>
                            <th class="text-end" style="width:180px">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSach.Any())
                        {
                            foreach (var item in Model.DanhSach)
                            {
                                stt++;
                                var statusClass = item.TrangThai switch
                                {
                                    "Chờ duyệt" => "cho-duyet",
                                    "Đã duyệt" => "da-duyet",
                                    "Đã bàn giao" => "da-ban-giao",
                                    "Đang thuê" => "dang-thue",
                                    "Chờ thanh toán" => "cho-thanh-toan",
                                    "Hoàn thành" => "hoan-thanh",
                                    "Từ chối" => "tu-choi",
                                    "Đã hủy" => "da-huy",
                                    _ => "da-huy"
                                };
                                var coTheHuy = item.TrangThai == "Chờ duyệt" || item.TrangThai == "Đã duyệt";

                                <tr>
                                    <td class="text-muted">@stt</td>
                                    <td>
                                        <div class="xe-cell">
                                            <img src="@(string.IsNullOrEmpty(item.Xe?.AnhXe) ? "/images/xe/default.jpg" : item.Xe.AnhXe)"
                                                 class="xe-thumb" alt="@item.Xe?.TenXe" />
                                            <div>
                                                <div class="xe-name">@item.Xe?.TenXe</div>
                                                <span class="xe-plate">@item.Xe?.BienSo</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="time-cell">
                                        <span class="lbl">Nhận</span>
                                        <span class="val">@item.ThoiGianNhanDuKien.ToString("dd/MM/yyyy HH:mm")</span>
                                        <span class="lbl mt-1">Trả</span>
                                        <span class="val">@item.ThoiGianTraDuKien.ToString("dd/MM/yyyy HH:mm")</span>
                                    </td>
                                    <td class="text-end">
                                        <span class="money primary">
                                            @item.DonGiaApDung.ToString("N0")<span class="unit">đ</span>
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <span class="money">
                                            @item.TienCoc.ToString("N0")<span class="unit">đ</span>
                                        </span>
                                    </td>
                                    <td>
                                        <span class="status-pill @statusClass">@item.TrangThai</span>
                                    </td>
                                    <td>
                                        <div class="action-cell">
                                            <a asp-action="Details" asp-route-id="@item.MaDatXe"
                                               class="btn-clean">Xem</a>
                                            @if (coTheHuy)
                                            {
                                                <form asp-action="Huy" asp-route-id="@item.MaDatXe"
                                                      method="post" class="m-0">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit"
                                                            class="btn-clean danger"
                                                            onclick="return confirm('Bạn có chắc muốn hủy đơn này?')">
                                                        Hủy
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="empty-state">
                                        <div class="big">— — —</div>
                                        <div class="msg">Bạn chưa có đơn đặt xe nào</div>
                                        <a asp-action="TimXeTrong" class="btn btn-primary mt-3">
                                            Tìm xe và đặt ngay
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TongSoTrang > 1)
            {
                <div class="pager">
                    <div>
                        Trang <strong>@Model.Trang</strong> / @Model.TongSoTrang —
                        hiển thị <strong>@Model.DanhSach.Count</strong> trong
                        <strong>@Model.TongSoBanGhi</strong> đơn
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(Model.CoTrangTruoc ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="DonCuaToi"
                                   asp-route-trang="@(Model.Trang - 1)"
                                   asp-route-tuKhoa="@Model.TuKhoa"
                                   asp-route-trangThai="@Model.TrangThai"
                                   asp-route-maLoaiXe="@Model.MaLoaiXe"
                                   asp-route-kichThuocTrang="@Model.KichThuocTrang">Trước</a>
                            </li>

                            @{
                                var batDau = Math.Max(1, Model.Trang - 2);
                                var ketThuc = Math.Min(Model.TongSoTrang, Model.Trang + 2);
                            }

                            @for (int i = batDau; i <= ketThuc; i++)
                            {
                                <li class="page-item @(i == Model.Trang ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="DonCuaToi"
                                       asp-route-trang="@i"
                                       asp-route-tuKhoa="@Model.TuKhoa"
                                       asp-route-trangThai="@Model.TrangThai"
                                       asp-route-maLoaiXe="@Model.MaLoaiXe"
                                       asp-route-kichThuocTrang="@Model.KichThuocTrang">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CoTrangSau ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="DonCuaToi"
                                   asp-route-trang="@(Model.Trang + 1)"
                                   asp-route-tuKhoa="@Model.TuKhoa"
                                   asp-route-trangThai="@Model.TrangThai"
                                   asp-route-maLoaiXe="@Model.MaLoaiXe"
                                   asp-route-kichThuocTrang="@Model.KichThuocTrang">Sau</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>