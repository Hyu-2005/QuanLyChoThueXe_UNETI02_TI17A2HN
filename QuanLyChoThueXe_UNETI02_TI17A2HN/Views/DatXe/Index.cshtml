@* 
   File: Views/DatXe/Index.cshtml
   Noi dung: Danh sach tat ca don dat xe (admin/nhan vien)
   Sinh vien thuc hien: Vu Tien Dat - 23103100119 - SV3
   Module: Module 3 - Khach hang, Tim xe trong va Dat xe
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.DatXe.DatXeListVM
@{
    ViewData["Title"] = "Quản lý đơn đặt xe";
    int stt = (Model.Trang - 1) * Model.KichThuocTrang;

    var tongDon = Model.TongSoBanGhi;
    var choDuyet = Model.DanhSach.Count(x => x.TrangThai == "Chờ duyệt");
    var daDuyet = Model.DanhSach.Count(x => x.TrangThai == "Đã duyệt");
    var dangThue = Model.DanhSach.Count(x => x.TrangThai == "Đang thuê");
    var coFilter = !string.IsNullOrEmpty(Model.TuKhoa)
                || !string.IsNullOrEmpty(Model.TrangThai)
                || Model.MaLoaiXe.HasValue
                || Model.TuNgay.HasValue
                || Model.DenNgay.HasValue;
}

<style>
    .page-shell { background: #f5f7fa; min-height: 100vh; padding: 32px 0; }
    .page-wrap { max-width: 1440px; margin: 0 auto; padding: 0 24px; }

    /* HERO */
    .dx-hero {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: #fff;
        border-radius: 14px;
        padding: 32px 30px;
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }
    .dx-hero::before {
        content: "";
        position: absolute;
        top: -60px; right: -60px;
        width: 220px; height: 220px;
        background: rgba(255,255,255,.06);
        border-radius: 50%;
    }
    .dx-hero h1 {
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.6px;
        margin: 0 0 6px 0;
    }
    .dx-hero .sub {
        font-size: 14px;
        opacity: .85;
        margin: 0 0 20px 0;
        max-width: 560px;
    }
    .stat-row {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
    }
    .stat-row .stat {
        background: rgba(255,255,255,.12);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 10px;
        padding: 14px 16px;
    }
    .stat-row .stat .lbl {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .8px;
        opacity: .8;
        margin-bottom: 6px;
    }
    .stat-row .stat .num {
        font-size: 22px;
        font-weight: 800;
        line-height: 1;
    }

    /* FILTER */
    .filter-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 18px 22px;
        margin-bottom: 20px;
    }
    .filter-card .form-label {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #64748b;
        margin-bottom: 6px;
    }
    .filter-card .form-control,
    .filter-card .form-select {
        border-radius: 8px;
        border-color: #d1d5db;
        font-size: 14px;
        height: 40px;
    }
    .filter-card .form-control:focus,
    .filter-card .form-select:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59,130,246,.12);
    }

    /* DATA */
    .data-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
    }
    .data-card .card-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 22px;
        border-bottom: 1px solid #f1f5f9;
    }
    .data-card .card-head .title {
        font-size: 14px;
        font-weight: 700;
        color: #0f172a;
        margin: 0;
    }
    .data-card .card-head .count {
        font-size: 12px;
        color: #64748b;
        background: #f1f5f9;
        padding: 4px 12px;
        border-radius: 999px;
        font-weight: 600;
    }
    .data-card table {
        margin: 0;
        font-size: 14px;
    }
    .data-card thead th {
        background: #f9fafb;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        color: #475569;
        padding: 14px 16px;
        border-bottom: 1px solid #e5e7eb;
        white-space: nowrap;
    }
    .data-card tbody td {
        padding: 16px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }
    .data-card tbody tr:last-child td { border-bottom: none; }
    .data-card tbody tr:hover { background: #fafbfc; }

    /* CELL */
    .kh-cell .name {
        font-weight: 700;
        color: #0f172a;
        font-size: 14px;
        margin-bottom: 2px;
    }
    .kh-cell .phone {
        font-size: 12px;
        color: #64748b;
        font-variant-numeric: tabular-nums;
    }

    .xe-cell {
        display: flex;
        align-items: center;
        gap: 10px;
    }
    .xe-thumb {
        width: 56px;
        height: 44px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
        flex-shrink: 0;
    }
    .xe-name {
        font-weight: 700;
        color: #0f172a;
        font-size: 13px;
        margin-bottom: 2px;
    }
    .xe-plate {
        display: inline-block;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        font-size: 11px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 5px;
        font-variant-numeric: tabular-nums;
    }

    .time-cell {
        font-size: 13px;
        line-height: 1.5;
    }
    .time-cell .lbl {
        color: #94a3b8;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .3px;
    }
    .time-cell .val {
        font-weight: 600;
        color: #0f172a;
        font-variant-numeric: tabular-nums;
        display: block;
        margin-bottom: 4px;
    }

    .money {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        color: #0f172a;
    }
    .money.primary {
        color: #1d4ed8;
        font-weight: 700;
        font-size: 15px;
    }
    .money .unit {
        font-size: 11px;
        font-weight: 500;
        color: #94a3b8;
        margin-left: 2px;
    }

    .status-pill {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .3px;
        text-transform: uppercase;
        white-space: nowrap;
    }
    .status-pill.cho-duyet { background: #fef3c7; color: #92400e; }
    .status-pill.da-duyet { background: #dbeafe; color: #1e40af; }
    .status-pill.da-ban-giao { background: #cffafe; color: #155e75; }
    .status-pill.dang-thue { background: #e0e7ff; color: #3730a3; }
    .status-pill.cho-thanh-toan { background: #fde68a; color: #78350f; }
    .status-pill.hoan-thanh { background: #dcfce7; color: #166534; }
    .status-pill.tu-choi { background: #fee2e2; color: #991b1b; }
    .status-pill.da-huy { background: #f1f5f9; color: #64748b; }

    .action-cell {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 6px;
        flex-wrap: nowrap;
    }
    .btn-clean {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 14px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        background: #fff;
        color: #374151;
        text-decoration: none;
        transition: all .15s;
        line-height: 1;
        white-space: nowrap;
        min-height: 34px;
    }
    .btn-clean:hover { border-color: #9ca3af; background: #f9fafb; color: #111827; }
    .btn-clean.warn { color: #b45309; border-color: #fcd34d; }
    .btn-clean.warn:hover { background: #fffbeb; }

    .empty-state {
        padding: 80px 24px;
        text-align: center;
        color: #94a3b8;
    }
    .empty-state .big {
        font-size: 42px;
        font-weight: 700;
        color: #e5e7eb;
        letter-spacing: 4px;
    }
    .empty-state .msg { font-size: 15px; margin-top: 8px; }

    /* PAGER */
    .pager {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 22px;
        background: #f9fafb;
        border-top: 1px solid #e5e7eb;
        font-size: 13px;
        color: #64748b;
    }
    .pager .pagination { margin: 0; }
    .pager .page-link {
        border-radius: 8px;
        margin: 0 2px;
        border-color: #e5e7eb;
        color: #334155;
        font-size: 13px;
        font-weight: 600;
        padding: 6px 12px;
    }
    .pager .page-item.active .page-link {
        background: #1d4ed8;
        border-color: #1d4ed8;
    }

    @@media (max-width: 768px) {
        .stat-row { grid-template-columns: repeat(2, 1fr); }
    }
</style>

<div class="page-shell">
    <div class="page-wrap">

        <!-- HERO -->
        <div class="dx-hero">
            <h1>Quản lý đơn đặt xe</h1>
            <p class="sub">
                Theo dõi, lọc và xử lý toàn bộ đơn đặt xe trong hệ thống.
                Duyệt đơn, bàn giao, trả xe và thanh toán ở các module tiếp theo.
            </p>
            <div class="stat-row">
                <div class="stat">
                    <div class="lbl">Tổng số đơn</div>
                    <div class="num">@tongDon</div>
                </div>
                <div class="stat">
                    <div class="lbl">Chờ duyệt</div>
                    <div class="num">@choDuyet</div>
                </div>
                <div class="stat">
                    <div class="lbl">Đã duyệt</div>
                    <div class="num">@daDuyet</div>
                </div>
                <div class="stat">
                    <div class="lbl">Đang thuê</div>
                    <div class="num">@dangThue</div>
                </div>
            </div>
        </div>

        <!-- THÔNG BÁO -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>Thành công.</strong> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Lỗi.</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- FILTER -->
        <div class="filter-card">
            <form method="get" asp-action="Index">
                <input type="hidden" name="trang" value="1" />

                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label">Từ khóa</label>
                        <input type="text" name="tuKhoa" value="@Model.TuKhoa"
                               class="form-control"
                               placeholder="Tên KH, SĐT, biển số, tên xe..." />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Trạng thái</label>
                        <select name="trangThai" class="form-select" asp-items="Model.DanhSachTrangThai">
                            <option value="">Tất cả</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Loại xe</label>
                        <select name="maLoaiXe" class="form-select" asp-items="Model.DanhSachLoaiXe">
                            <option value="">Tất cả</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Từ ngày nhận</label>
                        <input type="date" name="tuNgay"
                               value="@(Model.TuNgay?.ToString("yyyy-MM-dd"))"
                               class="form-control" />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Đến ngày</label>
                        <input type="date" name="denNgay"
                               value="@(Model.DenNgay?.ToString("yyyy-MM-dd"))"
                               class="form-control" />
                    </div>

                    <div class="col-md-1">
                        <label class="form-label">Hiển thị</label>
                        <select name="kichThuocTrang" class="form-select">
                            <option value="10" selected="@(Model.KichThuocTrang == 10)">10</option>
                            <option value="20" selected="@(Model.KichThuocTrang == 20)">20</option>
                            <option value="50" selected="@(Model.KichThuocTrang == 50)">50</option>
                        </select>
                    </div>

                    <div class="col-md-11 d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary px-3">Xóa lọc</a>
                        <button type="submit" class="btn btn-primary px-4">Áp dụng</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- DATA -->
        <div class="data-card">
            <div class="card-head">
                <h6 class="title">Danh sách đơn đặt xe</h6>
                <span class="count">
                    @Model.DanhSach.Count / @Model.TongSoBanGhi đơn
                </span>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:56px">STT</th>
                            <th>Khách hàng</th>
                            <th>Xe</th>
                            <th>Thời gian thuê</th>
                            <th class="text-end">Đơn giá / ngày</th>
                            <th class="text-end">Tiền cọc</th>
                            <th>Trạng thái</th>
                            <th class="text-end" style="width:170px">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSach.Any())
                        {
                            foreach (var item in Model.DanhSach)
                            {
                                stt++;
                                var statusClass = item.TrangThai switch
                                {
                                    "Chờ duyệt" => "cho-duyet",
                                    "Đã duyệt" => "da-duyet",
                                    "Đã bàn giao" => "da-ban-giao",
                                    "Đang thuê" => "dang-thue",
                                    "Chờ thanh toán" => "cho-thanh-toan",
                                    "Hoàn thành" => "hoan-thanh",
                                    "Từ chối" => "tu-choi",
                                    "Đã hủy" => "da-huy",
                                    _ => "da-huy"
                                };

                                <tr>
                                    <td class="text-muted">@stt</td>

                                    <td>
                                        <div class="kh-cell">
                                            <div class="name">@item.KhachHang?.HoTen</div>
                                            <div class="phone">@item.KhachHang?.SoDienThoai</div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="xe-cell">
                                            <img src="@(string.IsNullOrEmpty(item.Xe?.AnhXe) ? "/images/xe/default.jpg" : item.Xe.AnhXe)"
                                                 class="xe-thumb" alt="@item.Xe?.TenXe" />
                                            <div>
                                                <div class="xe-name">@item.Xe?.TenXe</div>
                                                <span class="xe-plate">@item.Xe?.BienSo</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="time-cell">
                                        <span class="lbl">Nhận</span>
                                        <span class="val">@item.ThoiGianNhanDuKien.ToString("dd/MM/yyyy HH:mm")</span>
                                        <span class="lbl">Trả</span>
                                        <span class="val">@item.ThoiGianTraDuKien.ToString("dd/MM/yyyy HH:mm")</span>
                                    </td>

                                    <td class="text-end">
                                        <span class="money primary">
                                            @item.DonGiaApDung.ToString("N0")<span class="unit">đ</span>
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <span class="money">
                                            @item.TienCoc.ToString("N0")<span class="unit">đ</span>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="status-pill @statusClass">@item.TrangThai</span>
                                    </td>

                                    <td>
                                        <div class="action-cell">
                                            <a asp-action="Details" asp-route-id="@item.MaDatXe"
                                               class="btn-clean">Xem</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="empty-state">
                                        <div class="big">— — —</div>
                                        <div class="msg">Không có đơn đặt xe nào phù hợp</div>
                                        @if (coFilter)
                                        {
                                            <a asp-action="Index" class="btn btn-outline-primary mt-3">
                                                Xóa bộ lọc
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- PAGER -->
            @if (Model.TongSoTrang > 1)
            {
                <div class="pager">
                    <div>
                        Trang <strong>@Model.Trang</strong> / @Model.TongSoTrang —
                        hiển thị <strong>@Model.DanhSach.Count</strong> trong
                        <strong>@Model.TongSoBanGhi</strong> đơn
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(Model.CoTrangTruoc ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-trang="@(Model.Trang - 1)"
                                   asp-route-tuKhoa="@Model.TuKhoa"
                                   asp-route-trangThai="@Model.TrangThai"
                                   asp-route-maLoaiXe="@Model.MaLoaiXe"
                                   asp-route-tuNgay="@(Model.TuNgay?.ToString("yyyy-MM-dd"))"
                                   asp-route-denNgay="@(Model.DenNgay?.ToString("yyyy-MM-dd"))"
                                   asp-route-sapXepTheo="@Model.SapXepTheo"
                                   asp-route-thuTuSapXep="@Model.ThuTuSapXep"
                                   asp-route-kichThuocTrang="@Model.KichThuocTrang">Trước</a>
                            </li>

                            @{
                                var batDau = Math.Max(1, Model.Trang - 2);
                                var ketThuc = Math.Min(Model.TongSoTrang, Model.Trang + 2);
                            }

                            @for (int i = batDau; i <= ketThuc; i++)
                            {
                                <li class="page-item @(i == Model.Trang ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-trang="@i"
                                       asp-route-tuKhoa="@Model.TuKhoa"
                                       asp-route-trangThai="@Model.TrangThai"
                                       asp-route-maLoaiXe="@Model.MaLoaiXe"
                                       asp-route-tuNgay="@(Model.TuNgay?.ToString("yyyy-MM-dd"))"
                                       asp-route-denNgay="@(Model.DenNgay?.ToString("yyyy-MM-dd"))"
                                       asp-route-sapXepTheo="@Model.SapXepTheo"
                                       asp-route-thuTuSapXep="@Model.ThuTuSapXep"
                                       asp-route-kichThuocTrang="@Model.KichThuocTrang">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CoTrangSau ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-trang="@(Model.Trang + 1)"
                                   asp-route-tuKhoa="@Model.TuKhoa"
                                   asp-route-trangThai="@Model.TrangThai"
                                   asp-route-maLoaiXe="@Model.MaLoaiXe"
                                   asp-route-tuNgay="@(Model.TuNgay?.ToString("yyyy-MM-dd"))"
                                   asp-route-denNgay="@(Model.DenNgay?.ToString("yyyy-MM-dd"))"
                                   asp-route-sapXepTheo="@Model.SapXepTheo"
                                   asp-route-thuTuSapXep="@Model.ThuTuSapXep"
                                   asp-route-kichThuocTrang="@Model.KichThuocTrang">Sau</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>