@*
    ==============================================================
    DangNhap.cshtml - Màn hình đăng nhập theo mẫu VIRELLO
    Chức năng đăng nhập gốc: Phạm Gia Minh Hoàng - 23103100087 - SV1 (Module 1)
    Giao diện VIRELLO + nút Google: Vũ Tiến Đạt - 23103100119 - SV3
    ==============================================================
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.TaiKhoan.DangNhapVM
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["HideChrome"] = true;
    ViewData["Dark"] = true;
    Layout = "_Layout";
}

<div class="vr-auth">

    <!-- CỘT TRÁI: ẢNH + GIỚI THIỆU -->
    <div class="vr-auth-left">
        <div class="bg">
            <img src="https://images.unsplash.com/photo-1617814076367-b759c7d7e738?q=80&w=2070&auto=format&fit=crop" alt="Xe sang" />
        </div>

        <a class="vr-logo" asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 100 100" aria-hidden="true">
                <path d="M10 15 L45 85 L55 85 L90 15 L70 15 L50 60 L30 15 Z" />
                <path class="vr-logo-inner" d="M35 15 L50 48 L65 15 Z" />
            </svg>
            <span class="vr-logo-text">VIRELLO</span>
        </a>

        <div>
            <h2 class="vr-auth-left-title">Thuê xe dễ dàng<br /><span class="vr-grad-text">Khám phá mọi hành trình</span></h2>
            <p>Tìm xe trống, đặt xe trực tuyến và theo dõi đơn thuê trong một hệ thống duy nhất.</p>
        </div>

        <div class="vr-auth-bullets">
            <div><i class="fa-solid fa-car-side"></i> Quản lý xe dễ dàng</div>
            <div><i class="fa-solid fa-clipboard-list"></i> Theo dõi đơn thuê</div>
            <div><i class="fa-solid fa-shield-halved"></i> Thông tin minh bạch</div>
        </div>
    </div>

    <!-- CỘT PHẢI: FORM -->
    <div class="vr-auth-right">
        <div class="vr-auth-top"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Về trang chủ</a></div>

        <div class="vr-auth-card">
            <span class="vr-label">— ĐĂNG NHẬP —</span>
            <h1 class="vr-auth-title">Chào mừng trở lại</h1>
            <p class="vr-auth-sub">Vui lòng đăng nhập để tiếp tục sử dụng dịch vụ</p>

            @if (TempData["Success"] != null)
            {
                <div class="vr-auth-msg ok">@TempData["Success"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="vr-auth-msg err">@TempData["Error"]</div>
            }

            <form asp-action="DangNhap" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="vr-auth-error" style="margin-bottom:12px;"></div>

                <div class="vr-field">
                    <label asp-for="TenDangNhap">Tên đăng nhập</label>
                    <input asp-for="TenDangNhap" class="vr-input" placeholder="Nhập tên đăng nhập" autocomplete="username" autofocus />
                    <span asp-validation-for="TenDangNhap" class="vr-auth-error"></span>
                </div>

                <div class="vr-field">
                    <label asp-for="MatKhau">Mật khẩu</label>
                    <div class="vr-pass">
                        <input asp-for="MatKhau" id="passwordField" class="vr-input" placeholder="Nhập mật khẩu" autocomplete="current-password" />
                        <button type="button" onclick="togglePassword()" aria-label="Hiện hoặc ẩn mật khẩu">
                            <i id="eyeIcon" class="fa-regular fa-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="MatKhau" class="vr-auth-error"></span>
                </div>

                <div class="vr-row">
                    <label class="vr-check">
                        <input asp-for="GhiNho" type="checkbox" />
                        <span>Ghi nhớ đăng nhập</span>
                    </label>
                    <a asp-controller="TaiKhoan" asp-action="QuenMatKhau" class="vr-link">Quên mật khẩu?</a>
                </div>

                <button type="submit" class="vr-btn-red full">Đăng nhập <i class="fa-solid fa-arrow-right"></i></button>
            </form>

            @* ==============================================================
               Bắt Đầu Code của SV3: Vũ Tiến Đạt
               file: Views/TaiKhoan/DangNhap.cshtml
               nội dung: Nút "Tiếp tục với Google" (chuyển sang DangNhapGoogleController) và link "Đăng ký ngay".
               sinh viên thực hiện: Vũ Tiến Đạt - 23103100119 - SV3
               ============================================================== *@
            <div class="vr-divider">Hoặc đăng nhập bằng</div>
            <a asp-controller="DangNhapGoogle" asp-action="Index" asp-route-returnUrl="@Model.ReturnUrl" class="vr-google">
                <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" /><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" /><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" /><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" /></svg>
                Tiếp tục với Google
            </a>
            <p class="vr-auth-foot">Chưa có tài khoản? <a asp-controller="DangKy" asp-action="Index">Đăng ký ngay</a></p>
            @* ==============================================================
               Kết thúc Code của SV3
               ============================================================== *@
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword() {
            var f = document.getElementById('passwordField');
            var i = document.getElementById('eyeIcon');
            var an = f.type === 'password';
            f.type = an ? 'text' : 'password';
            i.className = an ? 'fa-regular fa-eye-slash' : 'fa-regular fa-eye';
        }
    </script>
}
