@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.TaiKhoan.DangNhapVM

@{
    ViewData["Title"] = "Đăng nhập";
    Layout = "_Layout";
}

<style>
    .login-shell {
        min-height: 100vh;
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px 16px;
        margin: -24px -12px;
    }
    .login-card {
        background: #fff;
        border-radius: 16px;
        box-shadow: 0 20px 60px rgba(15,23,42,.25);
        width: 100%;
        max-width: 440px;
        overflow: hidden;
    }
    .login-head {
        padding: 32px 36px 20px;
        text-align: center;
    }
    .login-logo {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        font-weight: 800;
        margin-bottom: 16px;
        box-shadow: 0 8px 20px rgba(59,130,246,.35);
    }
    .login-head h1 {
        font-size: 22px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.4px;
        margin: 0 0 6px 0;
    }
    .login-head .sub {
        font-size: 13px;
        color: #64748b;
        margin: 0;
    }
    .login-body { padding: 8px 36px 28px; }
    .login-body .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
    }
    .login-body .form-control {
        border-radius: 10px;
        border-color: #d1d5db;
        font-size: 14px;
        padding: 10px 14px;
        height: 46px;
    }
    .login-body .form-control:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59,130,246,.15);
    }
    .login-body .form-check-label {
        font-size: 13px;
        color: #475569;
    }
    .btn-login {
        width: 100%;
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 12px;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.3px;
        transition: all .2s;
        box-shadow: 0 4px 12px rgba(59,130,246,.3);
    }
    .btn-login:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 18px rgba(59,130,246,.4);
    }
    .login-footer {
        padding: 20px 36px 24px;
        background: #f9fafb;
        border-top: 1px solid #f1f5f9;
        font-size: 12px;
        color: #64748b;
        line-height: 1.8;
    }
    .login-footer strong {
        color: #334155;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .5px;
    }
    .login-footer code {
        background: #fff;
        border: 1px solid #e5e7eb;
        padding: 2px 8px;
        border-radius: 6px;
        color: #1d4ed8;
        font-weight: 600;
        font-size: 12px;
    }
</style>

<div class="login-shell">
    <div class="login-card">

        <div class="login-head">
            <div class="login-logo">Q</div>
            <h1>Đăng nhập hệ thống</h1>
            <p class="sub">Quản lý cho thuê xe - UNETI02</p>
        </div>

        <div class="login-body">
            <form asp-action="DangNhap" method="post">
                <input type="hidden" asp-for="ReturnUrl" />

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3 small"></div>

                <div class="mb-3">
                    <label asp-for="TenDangNhap" class="form-label">Tên đăng nhập</label>
                    <input asp-for="TenDangNhap" class="form-control"
                           placeholder="Nhập tên đăng nhập" autofocus />
                    <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MatKhau" class="form-label">Mật khẩu</label>
                    <input asp-for="MatKhau" class="form-control"
                           placeholder="Nhập mật khẩu" />
                    <span asp-validation-for="MatKhau" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="GhiNho" class="form-check-input" />
                    <label asp-for="GhiNho" class="form-check-label">Ghi nhớ đăng nhập</label>
                </div>

                <button type="submit" class="btn-login">Đăng nhập</button>
            </form>

            @* ==============================================================
               Bắt Đầu Code của SV3: Vũ Tiến Đạt
               file: Views/TaiKhoan/DangNhap.cshtml
               nội dung: Thêm nút "Đăng nhập bằng Google" (chuyển sang DangNhapGoogleController).
               sinh viên thực hiện: Vũ Tiến Đạt - 23103100119 - SV3
               ============================================================== *@
            <div style="display:flex;align-items:center;gap:12px;margin:22px 0 16px;color:#94a3b8;font-size:12px">
                <span style="flex:1;height:1px;background:#e5e7eb"></span>Hoặc đăng nhập bằng<span style="flex:1;height:1px;background:#e5e7eb"></span>
            </div>
            <a asp-controller="DangNhapGoogle" asp-action="Index" asp-route-returnUrl="@Model.ReturnUrl"
               style="display:flex;align-items:center;justify-content:center;gap:10px;height:46px;border:1px solid #d1d5db;border-radius:10px;background:#fff;color:#1f2937;font-weight:600;font-size:14px;text-decoration:none">
                <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" /><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" /><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" /><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" /></svg>
                Tiếp tục với Google
            </a>
            @* ==============================================================
               Kết thúc Code của SV3
               ============================================================== *@

            @* ==============================================================
               Bắt Đầu Code của SV3: Vũ Tiến Đạt
               file: Views/TaiKhoan/DangNhap.cshtml
               nội dung: Thêm link "Đăng ký" để khách hàng tự tạo tài khoản (chuyển sang DangKyController).
               sinh viên thực hiện: Vũ Tiến Đạt - 23103100119 - SV3
               ============================================================== *@
            <div class="text-center mt-3 small">
                Chưa có tài khoản? <a asp-controller="DangKy" asp-action="Index" class="fw-semibold">Đăng ký</a>
            </div>
            @* ==============================================================
               Kết thúc Code của SV3
               ============================================================== *@
        </div>

        <div class="login-footer">
            <strong>Tài khoản kiểm thử</strong>
            <div class="mt-2">
                Admin: <code>admin</code> / <code>admin123</code><br />
                Nhân viên: <code>nhanvien01</code> / <code>nv123456</code><br />
                Khách hàng: <code>kh01</code> / <code>kh123456</code>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
