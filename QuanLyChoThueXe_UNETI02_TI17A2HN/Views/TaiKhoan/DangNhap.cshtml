@*
    DangNhap.cshtml - Màn hình đăng nhập
    Sinh viên thực hiện: Phạm Gia Minh Hoàng - 23103100087 - SV1
    Nội dung: Thiết kế 2 cột full-screen, hiện đại
    Module: Module 1 - Tài khoản, Đăng nhập, Phân quyền
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.TaiKhoan.DangNhapVM
@{
    ViewData["Title"] = "Đăng nhập";
    ViewData["HideChrome"] = true;
    Layout = "_Layout";
}

<div class="lg-shell">

    <!-- ============================================================ -->
    <!-- CỘT TRÁI: HERO + ẢNH NỀN                                     -->
    <!-- ============================================================ -->
    <div class="lg-left">

        <!-- Background -->
        <div class="lg-bg">
            <img src="https://images.unsplash.com/photo-1621007947382-bb3c3994e3fb?w=1600&q=80"
                 alt="Xe cho thuê" />
        </div>
        <div class="lg-overlay"></div>
        <div class="lg-blob lg-blob-1"></div>
        <div class="lg-blob lg-blob-2"></div>

        <!-- Content -->
        <div class="lg-left-content">

            <!-- Logo -->
            <div class="lg-logo">
                <div class="lg-logo-icon">
                    <svg width="42" height="26" viewBox="0 0 48 28" fill="none">
                        <path d="M8 20h32M8 20v-4l3-8h20l3 8v4"
                              stroke="#2563eb" stroke-width="2.6"
                              stroke-linecap="round" stroke-linejoin="round" />
                        <path d="M11 12h22" stroke="#2563eb" stroke-width="2.6"
                              stroke-linecap="round" />
                        <circle cx="14" cy="20" r="2.6" fill="#2563eb" />
                        <circle cx="34" cy="20" r="2.6" fill="#2563eb" />
                    </svg>
                </div>
                <div class="lg-logo-text">
                    <span class="lg-brand">
                        Drive<span class="accent">Easy</span>
                    </span>
                    <span class="lg-tagline">Thuê xe dễ dàng · Hành trình trọn vẹn</span>
                </div>
            </div>

            <!-- Title -->
            <div class="lg-hero">
                <h1 class="lg-title">
                    Thuê xe dễ dàng<br />
                    <span class="lg-title-accent">Khám phá mọi hành trình</span>
                </h1>
                <p class="lg-subtitle">
                    Đa dạng dòng xe · Thủ tục nhanh gọn · Giá tốt nhất
                </p>
            </div>

            <!-- Features (chỉ desktop) -->
            <div class="lg-features">
                <div class="lg-feature">
                    <div class="lg-feature-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z" />
                            <path d="M9 12l2 2 4-4" />
                        </svg>
                    </div>
                    <div>
                        <div class="lg-feature-title">An toàn tuyệt đối</div>
                        <div class="lg-feature-sub">100% xe được bảo hiểm</div>
                    </div>
                </div>

                <div class="lg-feature">
                    <div class="lg-feature-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10" />
                            <path d="M12 6v6l4 2" />
                        </svg>
                    </div>
                    <div>
                        <div class="lg-feature-title">Thủ tục nhanh gọn</div>
                        <div class="lg-feature-sub">Đặt xe trong 2 phút</div>
                    </div>
                </div>

                <div class="lg-feature">
                    <div class="lg-feature-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 18v-6a9 9 0 0118 0v6" />
                            <path d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z" />
                        </svg>
                    </div>
                    <div>
                        <div class="lg-feature-title">Hỗ trợ 24/7</div>
                        <div class="lg-feature-sub">Luôn sẵn sàng mọi lúc</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================================ -->
    <!-- CỘT PHẢI: FORM ĐĂNG NHẬP                                     -->
    <!-- ============================================================ -->
    <div class="lg-right">
        <div class="lg-card">

            <!-- Header -->
            <div class="lg-card-head">
                <h2 class="lg-card-title">Đăng nhập</h2>
                <p class="lg-card-subtitle">
                    Vui lòng đăng nhập để tiếp tục sử dụng dịch vụ
                </p>
            </div>

            <form asp-action="DangNhap" method="post" class="lg-form">
                <input type="hidden" asp-for="ReturnUrl" />
                <div asp-validation-summary="ModelOnly" class="lg-validation"></div>

                <!-- Tên đăng nhập -->
                <div class="lg-field">
                    <label class="lg-label">Số điện thoại hoặc email</label>
                    <div class="lg-input-wrap">
                        <span class="lg-input-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                                <circle cx="12" cy="7" r="4" />
                            </svg>
                        </span>
                        <input asp-for="TenDangNhap"
                               class="lg-input"
                               placeholder="Nhập số điện thoại hoặc email"
                               autocomplete="username"
                               autofocus />
                    </div>
                    <span asp-validation-for="TenDangNhap" class="lg-error"></span>
                </div>

                <!-- Mật khẩu -->
                <div class="lg-field">
                    <label class="lg-label">Mật khẩu</label>
                    <div class="lg-input-wrap">
                        <span class="lg-input-icon">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="11" width="18" height="11" rx="2" />
                                <path d="M7 11V7a5 5 0 0110 0v4" />
                            </svg>
                        </span>
                        <input asp-for="MatKhau"
                               type="password"
                               id="passwordField"
                               class="lg-input"
                               placeholder="Nhập mật khẩu"
                               autocomplete="current-password" />
                        <button type="button" class="lg-toggle"
                                onclick="togglePassword()"
                                aria-label="Hiện/ẩn mật khẩu">
                            <svg id="eyeIcon" width="18" height="18" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="1.8"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="MatKhau" class="lg-error"></span>
                </div>

                <!-- Remember + Forgot -->
                <div class="lg-options">
                    <label class="lg-checkbox">
                        <input asp-for="GhiNho" type="checkbox" />
                        <span class="lg-checkbox-mark"></span>
                        <span class="lg-checkbox-label">Ghi nhớ đăng nhập</span>
                    </label>
                    <a asp-controller="TaiKhoan" asp-action="QuenMatKhau"
                       class="lg-forgot">Quên mật khẩu?</a>
                </div>

                <!-- Nút đăng nhập -->
                <button type="submit" class="lg-btn-login">
                    <span>Đăng nhập</span>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                </button>

                <!-- Divider -->
                <div class="lg-divider">
                    <span>Hoặc đăng nhập bằng</span>
                </div>

                <!-- Google -->
                <button type="button" class="lg-btn-google">
                    <svg width="20" height="20" viewBox="0 0 48 48">
                        <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.4 29.3 35 24 35c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34.1 5.1 29.3 3 24 3 12.4 3 3 12.4 3 24s9.4 21 21 21 21-9.4 21-21c0-1.4-.1-2.3-.4-3.5z" />
                        <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34.1 5.1 29.3 3 24 3 16.3 3 9.7 7.4 6.3 14.7z" />
                        <path fill="#4CAF50" d="M24 45c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 36.1 26.7 37 24 37c-5.3 0-9.7-2.6-11.3-7l-6.5 5C9.5 41.5 16.2 45 24 45z" />
                        <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.2-4.1 5.6l6.2 5.2C41 35.5 45 30.3 45 24c0-1.4-.1-2.3-.4-3.5z" />
                    </svg>
                    <span>Tiếp tục với Google</span>
                </button>

                <!-- Register -->
                <div class="lg-register">
                    Chưa có tài khoản?
                    <a asp-controller="DangKy" asp-action="Index">Đăng ký ngay</a>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    /* ============================================================
       BASE
       ============================================================ */
    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
    }

    /* ============================================================
       LAYOUT 2 CỘT
       ============================================================ */
    .lg-shell {
        display: grid;
        grid-template-columns: 1.05fr 1fr;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
    }

    /* ============================================================
       CỘT TRÁI
       ============================================================ */
    .lg-left {
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    /* Background */
    .lg-bg {
        position: absolute;
        inset: 0;
        z-index: 0;
    }
    .lg-bg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        display: block;
    }
    .lg-overlay {
        position: absolute;
        inset: 0;
        z-index: 1;
        background: linear-gradient(
            180deg,
            rgba(239,246,255,0.94) 0%,
            rgba(219,234,254,0.82) 18%,
            rgba(191,219,254,0.38) 42%,
            rgba(148,163,184,0.12) 68%,
            rgba(15,23,42,0.25) 100%);
    }

    /* Blobs */
    .lg-blob {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        filter: blur(80px);
        z-index: 2;
    }
    .lg-blob-1 {
        top: -180px;
        left: -180px;
        width: 500px;
        height: 500px;
        background: radial-gradient(circle, rgba(255,255,255,.85) 0%, transparent 70%);
    }
    .lg-blob-2 {
        bottom: -150px;
        right: -150px;
        width: 420px;
        height: 420px;
        background: radial-gradient(circle, rgba(37,99,235,.25) 0%, transparent 70%);
    }

    /* Content */
    .lg-left-content {
        position: relative;
        z-index: 3;
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 48px 64px 40px;
    }

    /* Logo */
    .lg-logo {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 56px;
    }
    .lg-logo-icon {
        width: 56px;
        height: 56px;
        background: #fff;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 8px 24px rgba(37,99,235,.18);
        flex-shrink: 0;
    }
    .lg-logo-text {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }
    .lg-brand {
        font-size: 26px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.8px;
    }
    .lg-brand .accent { color: #2563eb; }
    .lg-tagline {
        font-size: 11.5px;
        color: #64748b;
        font-weight: 500;
        margin-top: 3px;
        letter-spacing: 0.1px;
    }

    /* Hero */
    .lg-hero {
        flex-shrink: 0;
    }
    .lg-title {
        font-size: 46px;
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -1.4px;
        color: #0f172a;
        margin: 0 0 20px 0;
        max-width: 520px;
    }
    .lg-title-accent {
        color: #2563eb;
        display: inline-block;
    }
    .lg-subtitle {
        font-size: 16px;
        color: #475569;
        font-weight: 500;
        margin: 0;
        line-height: 1.6;
        max-width: 500px;
    }

    /* Spacer */
    .lg-left-content::after {
        content: "";
        flex: 1;
        min-height: 40px;
    }

    /* Features */
    .lg-features {
        display: flex;
        flex-direction: column;
        gap: 16px;
        margin-top: auto;
    }
    .lg-feature {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 16px;
        background: rgba(255,255,255,.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255,255,255,.7);
        border-radius: 14px;
        max-width: 360px;
        transition: all .2s;
    }
    .lg-feature:hover {
        background: rgba(255,255,255,.85);
        transform: translateX(4px);
    }
    .lg-feature-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #2563eb;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        box-shadow: 0 4px 12px rgba(37,99,235,.3);
    }
    .lg-feature-title {
        font-size: 13.5px;
        font-weight: 700;
        color: #0f172a;
        line-height: 1.2;
    }
    .lg-feature-sub {
        font-size: 11.5px;
        color: #64748b;
        margin-top: 2px;
    }

    /* ============================================================
       CỘT PHẢI
       ============================================================ */
    .lg-right {
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px;
        overflow-y: auto;
        position: relative;
    }
    .lg-right::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #2563eb, #60a5fa);
    }
    .lg-card {
        width: 100%;
        max-width: 440px;
    }

    /* Header */
    .lg-card-head {
        margin-bottom: 32px;
    }
    .lg-card-title {
        font-size: 32px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -1px;
        margin: 0 0 8px 0;
    }
    .lg-card-subtitle {
        font-size: 14px;
        color: #64748b;
        margin: 0;
        line-height: 1.5;
    }

    /* Form */
    .lg-form { margin: 0; }

    .lg-validation {
        background: #fef2f2;
        border-left: 4px solid #ef4444;
        border-radius: 10px;
        padding: 12px 16px;
        font-size: 13px;
        color: #991b1b;
        margin-bottom: 20px;
    }
    .lg-validation:empty { display: none; }
    .lg-validation ul { margin: 0; padding-left: 20px; }

    /* Fields */
    .lg-field { margin-bottom: 18px; }
    .lg-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 8px;
    }
    .lg-input-wrap { position: relative; }
    .lg-input-icon {
        position: absolute;
        left: 16px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        pointer-events: none;
        display: flex;
        z-index: 2;
        transition: color .15s;
    }
    .lg-input {
        width: 100%;
        height: 50px;
        padding: 0 46px 0 48px;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        font-size: 14px;
        color: #0f172a;
        background: #fff;
        transition: all .15s;
        outline: none;
        box-sizing: border-box;
        font-family: inherit;
    }
    .lg-input::placeholder {
        color: #94a3b8;
        font-weight: 400;
    }
    .lg-input:hover { border-color: #cbd5e1; }
    .lg-input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 4px rgba(37,99,235,.08);
    }
    .lg-input-wrap:focus-within .lg-input-icon {
        color: #2563eb;
    }
    .lg-toggle {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        border: none;
        cursor: pointer;
        color: #94a3b8;
        padding: 4px;
        display: flex;
        transition: color .15s;
    }
    .lg-toggle:hover { color: #2563eb; }

    .lg-error {
        display: block;
        color: #dc2626;
        font-size: 12px;
        margin-top: 6px;
        min-height: 14px;
    }

    /* Options */
    .lg-options {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin: 8px 0 26px 0;
    }
    .lg-checkbox {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        cursor: pointer;
        user-select: none;
    }
    .lg-checkbox input[type="checkbox"] {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }
    .lg-checkbox-mark {
        width: 18px;
        height: 18px;
        border-radius: 5px;
        border: 1.5px solid #cbd5e1;
        background: #fff;
        position: relative;
        transition: all .15s;
        flex-shrink: 0;
    }
    .lg-checkbox input:checked ~ .lg-checkbox-mark {
        background: #2563eb;
        border-color: #2563eb;
    }
    .lg-checkbox input:checked ~ .lg-checkbox-mark::after {
        content: "";
        position: absolute;
        left: 5px;
        top: 1px;
        width: 4px;
        height: 9px;
        border: solid #fff;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }
    .lg-checkbox-label {
        font-size: 13.5px;
        color: #475569;
        font-weight: 500;
    }
    .lg-forgot {
        font-size: 13.5px;
        color: #2563eb;
        text-decoration: none;
        font-weight: 600;
        transition: color .15s;
    }
    .lg-forgot:hover {
        color: #1d4ed8;
        text-decoration: underline;
    }

    /* Button */
    .lg-btn-login {
        width: 100%;
        height: 52px;
        background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 700;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all .2s;
        box-shadow:
            0 8px 20px rgba(37,99,235,.28),
            0 2px 4px rgba(37,99,235,.15);
        letter-spacing: 0.1px;
        font-family: inherit;
    }
    .lg-btn-login:hover {
        transform: translateY(-2px);
        box-shadow:
            0 14px 32px rgba(37,99,235,.4),
            0 4px 8px rgba(37,99,235,.2);
    }
    .lg-btn-login:active { transform: translateY(0); }

    /* Divider */
    .lg-divider {
        text-align: center;
        margin: 26px 0 20px 0;
        position: relative;
    }
    .lg-divider::before {
        content: "";
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        height: 1px;
        background: #e5e7eb;
    }
    .lg-divider span {
        background: #fff;
        padding: 0 16px;
        position: relative;
        font-size: 13px;
        color: #94a3b8;
        font-weight: 500;
    }

    /* Google */
    .lg-btn-google {
        width: 100%;
        height: 52px;
        background: #fff;
        border: 1.5px solid #e5e7eb;
        border-radius: 12px;
        font-size: 14.5px;
        font-weight: 600;
        color: #334155;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        transition: all .15s;
        font-family: inherit;
    }
    .lg-btn-google:hover {
        border-color: #cbd5e1;
        background: #f9fafb;
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(15,23,42,.06);
    }

    /* Register */
    .lg-register {
        text-align: center;
        margin-top: 26px;
        font-size: 14px;
        color: #64748b;
    }
    .lg-register a {
        color: #2563eb;
        font-weight: 700;
        text-decoration: none;
        margin-left: 4px;
        transition: color .15s;
    }
    .lg-register a:hover {
        color: #1d4ed8;
        text-decoration: underline;
    }

    /* ============================================================
       RESPONSIVE
       ============================================================ */
    @@media (max-width: 1024px) {
        html, body { overflow: auto; }
        .lg-shell {
            grid-template-columns: 1fr;
            height: auto;
            min-height: 100vh;
        }
        .lg-left { min-height: 460px; }
        .lg-left-content { padding: 32px 32px 28px; }
        .lg-logo { margin-bottom: 40px; }
        .lg-title { font-size: 34px; }
        .lg-subtitle { font-size: 14px; }
        .lg-right { padding: 40px 24px; }
    }
