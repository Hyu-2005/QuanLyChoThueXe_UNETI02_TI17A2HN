@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.TaiKhoan.DoiMatKhauVM

@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<style>
    .form-shell { background: #000000; min-height: 100vh; padding: 32px 0; }
    .form-wrap { max-width: 640px; margin: 0 auto; padding: 0 24px; }

    .form-head {
        margin-bottom: 28px;
        padding-bottom: 20px;
        border-bottom: 1px solid rgba(255,255,255,.1);
    }
    .form-head .back {
        font-size: 13px; color: #94a3b8; text-decoration: none;
        display: inline-block; margin-bottom: 8px;
    }
    .form-head .back:hover { color: #E50914; }
    .form-head h1 {
        font-size: 26px; font-weight: 800; color: #ffffff;
        letter-spacing: -0.4px; margin: 0 0 4px 0;
    }
    .form-head .sub { font-size: 14px; color: #94a3b8; margin: 0; }

    .form-card {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(0,0,0,.45);
    }
    .form-card .sect {
        padding: 28px 32px;
        border-bottom: 1px solid rgba(255,255,255,.06);
    }
    .form-card .sect:last-of-type { border-bottom: none; }
    .form-card .sect-title {
        display: flex; align-items: center; gap: 12px;
        font-size: 12px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 1.2px;
        color: #94a3b8; margin: 0 0 22px 0;
    }
    .form-card .sect-title .num {
        width: 26px; height: 26px; border-radius: 50%;
        background: #b80710; color: #fff;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 12px; font-weight: 700; flex-shrink: 0;
    }

    .form-label { font-size: 13px; font-weight: 600; color: #cbd5e1; margin-bottom: 6px; }
    .form-label .req { color: #f87171; margin-left: 2px; }
    .form-control {
        border-radius: 0; border-color: rgba(255,255,255,.2);
        font-size: 14px; padding: 9px 12px; height: 42px;
    }
    .form-control:focus {
        border-color: #E50914;
        box-shadow: 0 0 0 3px rgba(229,9,20,.12);
    }
    .form-text { font-size: 12px; color: #71717a; margin-top: 4px; }

    .form-actions {
        padding: 20px 32px;
        background: #1c1c1c;
        border-top: 1px solid rgba(255,255,255,.1);
        display: flex; justify-content: flex-end; gap: 10px;
    }
    .form-actions .btn { padding: 10px 26px; font-weight: 600; border-radius: 0; }
</style>

<div class="form-shell">
    <div class="form-wrap">

        <div class="form-head">
            <a asp-controller="Home" asp-action="Index" class="back">← Quay lại trang chủ</a>
            <h1>Đổi mật khẩu</h1>
            <p class="sub">Cập nhật mật khẩu đăng nhập của bạn</p>
        </div>

        <form asp-action="DoiMatKhau" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="form-card">

                <div class="sect">
                    <h6 class="sect-title">
                        <span class="num">1</span> Xác thực mật khẩu cũ
                    </h6>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="MatKhauCu" class="form-label">
                                Mật khẩu hiện tại <span class="req">*</span>
                            </label>
                            <input asp-for="MatKhauCu" class="form-control"
                                   placeholder="Nhập mật khẩu đang dùng" />
                            <span asp-validation-for="MatKhauCu" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="sect">
                    <h6 class="sect-title">
                        <span class="num">2</span> Đặt mật khẩu mới
                    </h6>

                    <div class="row g-3">
                        <div class="col-12">
                            <label asp-for="MatKhauMoi" class="form-label">
                                Mật khẩu mới <span class="req">*</span>
                            </label>
                            <input asp-for="MatKhauMoi" class="form-control"
                                   placeholder="Tối thiểu 6 ký tự" />
                            <span asp-validation-for="MatKhauMoi" class="text-danger small"></span>
                            <div class="form-text">Nên dùng chữ, số và ký tự đặc biệt để bảo mật</div>
                        </div>

                        <div class="col-12">
                            <label asp-for="XacNhanMatKhau" class="form-label">
                                Xác nhận mật khẩu mới <span class="req">*</span>
                            </label>
                            <input asp-for="XacNhanMatKhau" class="form-control"
                                   placeholder="Nhập lại mật khẩu mới" />
                            <span asp-validation-for="XacNhanMatKhau" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    <button type="submit" class="btn btn-primary">Đổi mật khẩu</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}