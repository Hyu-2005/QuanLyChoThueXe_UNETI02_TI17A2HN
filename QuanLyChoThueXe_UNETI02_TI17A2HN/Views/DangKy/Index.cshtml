@*
    ==============================================================
    Index.cshtml - Khách hàng tự đăng ký tài khoản (giao diện VIRELLO)
    Họ và tên: Vũ Tiến Đạt - MSSV: 23103100119 - SV3
    Module: Module 3 - Khách hàng
    ==============================================================
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.TaiKhoan.DangKyVM
@{
    ViewData["Title"] = "Đăng ký tài khoản";
    ViewData["HideChrome"] = true;
    ViewData["Dark"] = true;
    Layout = "_Layout";
}

<div class="vr-auth">

    <!-- CỘT TRÁI -->
    <div class="vr-auth-left">
        <div class="bg">
            <img src="https://images.unsplash.com/photo-1617814076367-b759c7d7e738?q=80&w=2070&auto=format&fit=crop" alt="Xe sang" />
        </div>

        <a class="vr-logo" asp-controller="Home" asp-action="Index">
            <svg viewBox="0 0 100 100" aria-hidden="true">
                <path d="M10 15 L45 85 L55 85 L90 15 L70 15 L50 60 L30 15 Z" />
                <path class="vr-logo-inner" d="M35 15 L50 48 L65 15 Z" />
            </svg>
            <span class="vr-logo-text">VIRELLO</span>
        </a>

        <div>
            <h2 class="vr-auth-left-title">Tạo tài khoản<br /><span class="vr-grad-text">chỉ trong một phút</span></h2>
            <p>Đăng ký, tải CCCD và giấy phép lái xe để được xác minh, rồi bắt đầu đặt xe.</p>
        </div>

        <div class="vr-auth-bullets">
            <div><i class="fa-solid fa-user-plus"></i> 1. Đăng ký</div>
            <div><i class="fa-solid fa-id-card"></i> 2. Tải giấy tờ</div>
            <div><i class="fa-solid fa-car-side"></i> 3. Đặt xe</div>
        </div>
    </div>

    <!-- CỘT PHẢI -->
    <div class="vr-auth-right">
        <div class="vr-auth-top"><a asp-controller="Home" asp-action="Index"><i class="fa-solid fa-arrow-left"></i> Về trang chủ</a></div>

        <div class="vr-auth-card wide">
            <span class="vr-label">— ĐĂNG KÝ —</span>
            <h1 class="vr-auth-title">Tài khoản khách hàng</h1>
            <p class="vr-auth-sub">Dành cho khách hàng thuê xe</p>

            <form asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="vr-auth-error" style="margin-bottom:12px;"></div>

                <div class="vr-auth-grid">
                    <div class="vr-field">
                        <label asp-for="TenDangNhap">Tên đăng nhập</label>
                        <input asp-for="TenDangNhap" class="vr-input" placeholder="Ví dụ: nguyenvana" autocomplete="username" autofocus />
                        <span asp-validation-for="TenDangNhap" class="vr-auth-error"></span>
                    </div>
                    <div class="vr-field">
                        <label asp-for="HoTen">Họ tên</label>
                        <input asp-for="HoTen" class="vr-input" placeholder="Nguyễn Văn A" />
                        <span asp-validation-for="HoTen" class="vr-auth-error"></span>
                    </div>
                    <div class="vr-field">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" class="vr-input" placeholder="ten@gmail.com" autocomplete="email" />
                        <span asp-validation-for="Email" class="vr-auth-error"></span>
                    </div>
                    <div class="vr-field">
                        <label asp-for="SoDienThoai">Số điện thoại</label>
                        <input asp-for="SoDienThoai" class="vr-input" placeholder="09xxxxxxxx" autocomplete="tel" />
                        <span asp-validation-for="SoDienThoai" class="vr-auth-error"></span>
                    </div>
                    <div class="vr-field full">
                        <label asp-for="DiaChi">Địa chỉ</label>
                        <input asp-for="DiaChi" class="vr-input" placeholder="Số nhà, đường, quận/huyện" />
                        <span asp-validation-for="DiaChi" class="vr-auth-error"></span>
                    </div>
                    <div class="vr-field">
                        <label asp-for="MatKhau">Mật khẩu</label>
                        <input asp-for="MatKhau" class="vr-input" placeholder="Tối thiểu 6 ký tự" autocomplete="new-password" />
                        <span asp-validation-for="MatKhau" class="vr-auth-error"></span>
                    </div>
                    <div class="vr-field">
                        <label asp-for="XacNhanMatKhau">Nhập lại mật khẩu</label>
                        <input asp-for="XacNhanMatKhau" class="vr-input" placeholder="Nhập lại mật khẩu" autocomplete="new-password" />
                        <span asp-validation-for="XacNhanMatKhau" class="vr-auth-error"></span>
                    </div>
                </div>

                <button type="submit" class="vr-btn-red full" style="margin-top:28px;">Đăng ký <i class="fa-solid fa-arrow-right"></i></button>
            </form>

            <p class="vr-auth-foot">Đã có tài khoản? <a asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a></p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
