@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.HangXe.HangXeFormVM

@{
    ViewData["Title"] = "Them hang xe";
}

<h2>Them hang xe</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="TenHangXe" class="form-label"></label>
                <input asp-for="TenHangXe" class="form-control" />
                <span asp-validation-for="TenHangXe" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="QuocGia" class="form-label"></label>
                <input asp-for="QuocGia" class="form-control" />
                <span asp-validation-for="QuocGia" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MoTa" class="form-label"></label>
                <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
                <span asp-validation-for="MoTa" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="TrangThai" class="form-check-input" />
                <label asp-for="TrangThai" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Luu</button>
            <a asp-action="Index" class="btn btn-secondary">Huy</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}