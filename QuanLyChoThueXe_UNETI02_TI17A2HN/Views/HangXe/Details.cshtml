@model QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Entities.HangXe

@{
    ViewData["Title"] = "Chi tiet hang xe";
}

<h2>Chi tiet hang xe</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Ma hang xe</dt>
            <dd class="col-sm-9">@Model.MaHangXe</dd>

            <dt class="col-sm-3">Ten hang xe</dt>
            <dd class="col-sm-9">@Model.TenHangXe</dd>

            <dt class="col-sm-3">Quoc gia</dt>
            <dd class="col-sm-9">@(Model.QuocGia ?? "-")</dd>

            <dt class="col-sm-3">Mo ta</dt>
            <dd class="col-sm-9">@(Model.MoTa ?? "-")</dd>

            <dt class="col-sm-3">Trang thai</dt>
            <dd class="col-sm-9">
                @if (Model.TrangThai)
                {
                    <span class="badge bg-success">Hoat dong</span>
                }
                else
                {
                    <span class="badge bg-secondary">Ngung</span>
                }
            </dd>
        </dl>

        <h4 class="mt-4">Danh sach xe thuoc hang nay (@Model.Xes.Count xe)</h4>
        @if (Model.Xes.Any())
        {
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Bien so</th>
                        <th>Ten xe</th>
                        <th>Tinh trang</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var xe in Model.Xes)
                    {
                        <tr>
                            <td>@xe.BienSo</td>
                            <td>@xe.TenXe</td>
                            <td>@xe.TinhTrang</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">Chua co xe nao thuoc hang nay</p>
        }
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.MaHangXe" class="btn btn-warning">Sua</a>
<a asp-action="Index" class="btn btn-secondary">Quay lai</a>