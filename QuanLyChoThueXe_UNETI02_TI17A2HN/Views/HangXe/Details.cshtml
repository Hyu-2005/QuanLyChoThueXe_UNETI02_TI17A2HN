@* 
   File: Views/HangXe/Details.cshtml
   Noi dung: Chi tiet hang xe
   Sinh vien thuc hien: Pham Gia Minh Hoang - 23103100087 - SV1
   Module: Module 1 - Tai khoan, Dang nhap, Phan quyen, Loai xe, Hang xe
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Entities.HangXe
@{
    ViewData["Title"] = "Chi tiết hãng xe";
}

<style>
    .detail-shell { background: #000000; min-height: 100vh; padding: 32px 0; }
    .detail-wrap { max-width: 1080px; margin: 0 auto; padding: 0 24px; }

    .detail-head {
        display: flex; justify-content: space-between; align-items: flex-end;
        margin-bottom: 28px; padding-bottom: 20px;
        border-bottom: 1px solid rgba(255,255,255,.1);
    }
    .detail-head .back {
        font-size: 13px; color: #94a3b8; text-decoration: none;
        display: inline-block; margin-bottom: 8px;
    }
    .detail-head .back:hover { color: #E50914; }
    .detail-head h1 {
        font-size: 26px; font-weight: 800; color: #ffffff;
        letter-spacing: -0.4px; margin: 0 0 8px 0;
    }
    .id-chip {
        display: inline-block;
        background: rgba(99,102,241,.18);
        color: #a5b4fc;
        font-weight: 700;
        font-size: 13px;
        padding: 4px 12px;
        border-radius: 0;
        margin-right: 8px;
        vertical-align: middle;
    }
    .status-pill {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .3px;
        text-transform: uppercase;
    }
    .status-pill.on  { background: rgba(34,197,94,.15); color: #86efac; }
    .status-pill.off { background: #1c1c1c; color: #94a3b8; }

    .info-card {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        padding: 26px 30px;
        height: 100%;
    }
    .info-card .title {
        font-size: 12px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 1.2px;
        color: #94a3b8; margin: 0 0 20px 0;
    }
    .info-row {
        display: flex; justify-content: space-between;
        padding: 13px 0; border-bottom: 1px solid rgba(255,255,255,.06);
        font-size: 14px;
    }
    .info-row:last-child { border-bottom: none; }
    .info-row .lbl { color: #94a3b8; }
    .info-row .val {
        font-weight: 600; color: #ffffff; text-align: right;
    }

    .country-highlight {
        background: linear-gradient(135deg, #1c1c1c 0%, #0a0a0a 100%);
        color: #fff;
        border-radius: 0;
        padding: 26px 30px;
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 20px;
    }
    .country-highlight .lbl {
        font-size: 12px; text-transform: uppercase;
        letter-spacing: .8px; opacity: .85; margin-bottom: 6px;
    }
    .country-highlight .val {
        font-size: 28px; font-weight: 800;
        letter-spacing: -0.5px; line-height: 1;
    }
    .country-highlight .extra {
        text-align: right; font-size: 13px; opacity: .9;
        line-height: 1.8;
    }

    .desc-box {
        background: #0a0a0a;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        padding: 18px 20px;
        font-size: 14px;
        color: #cbd5e1;
        line-height: 1.7;
    }

    .data-card {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        overflow: hidden;
    }
    .data-card .card-head {
        padding: 20px 24px;
        border-bottom: 1px solid rgba(255,255,255,.1);
        display: flex; justify-content: space-between; align-items: center;
    }
    .data-card .card-head .title {
        font-size: 14px; font-weight: 700;
        color: #ffffff; margin: 0;
        text-transform: uppercase; letter-spacing: 0.5px;
    }
    .data-card .card-head .count {
        font-size: 12px; color: #94a3b8;
        background: #1c1c1c;
        padding: 4px 12px; border-radius: 999px;
        font-weight: 600;
    }

    .data-card table { margin: 0; font-size: 14px; }
    .data-card thead th {
        background: #1c1c1c;
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 0.5px;
        color: #cbd5e1; padding: 12px 16px;
        border-bottom: 1px solid rgba(255,255,255,.1);
    }
    .data-card tbody td {
        padding: 14px 16px;
        border-bottom: 1px solid rgba(255,255,255,.06);
        vertical-align: middle;
    }
    .data-card tbody tr:last-child td { border-bottom: none; }

    .badge-soft {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 11px; font-weight: 700;
        letter-spacing: .3px;
    }
</style>

<div class="detail-shell">
    <div class="detail-wrap">

        <div class="detail-head">
            <div>
                <a asp-action="Index" class="back">← Quay lại danh sách</a>
                <h1>@Model.TenHangXe</h1>
                <div>
                    <span class="id-chip">Mã hãng: #@Model.MaHangXe</span>
                    @if (Model.TrangThai)
                    {
                        <span class="status-pill on">Hoạt động</span>
                    }
                    else
                    {
                        <span class="status-pill off">Ngừng</span>
                    }
                </div>
            </div>
            <a asp-action="Edit" asp-route-id="@Model.MaHangXe"
               class="btn btn-warning px-4 py-2 fw-semibold" style="border-radius:0">
                Sửa hãng xe
            </a>
        </div>

        <div class="country-highlight">
            <div>
                <div class="lbl">Quốc gia</div>
                <div class="val">@(string.IsNullOrEmpty(Model.QuocGia) ? "Chưa xác định" : Model.QuocGia)</div>
            </div>
            <div class="extra">
                <div>Số xe thuộc hãng này:</div>
                <div style="font-size:20px;font-weight:800">@(Model.Xes?.Count ?? 0) xe</div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="info-card">
                    <h6 class="title">Thông tin hãng xe</h6>
                    <div class="info-row">
                        <span class="lbl">Mã hãng</span>
                        <span class="val">#@Model.MaHangXe</span>
                    </div>
                    <div class="info-row">
                        <span class="lbl">Tên hãng</span>
                        <span class="val">@Model.TenHangXe</span>
                    </div>
                    <div class="info-row">
                        <span class="lbl">Quốc gia</span>
                        <span class="val">@(string.IsNullOrEmpty(Model.QuocGia) ? "—" : Model.QuocGia)</span>
                    </div>
                    <div class="info-row">
                        <span class="lbl">Trạng thái</span>
                        <span class="val">
                            @if (Model.TrangThai)
                            {
                                <span class="badge-soft" style="background:rgba(34,197,94,.15);color:#86efac">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge-soft" style="background:#1c1c1c;color:#94a3b8">Ngừng</span>
                            }
                        </span>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.MoTa))
            {
                <div class="col-md-6">
                    <div class="info-card">
                        <h6 class="title">Mô tả</h6>
                        <div class="desc-box">@Model.MoTa</div>
                    </div>
                </div>
            }
        </div>

        <div class="data-card">
            <div class="card-head">
                <h6 class="title">Xe thuộc hãng này</h6>
                <span class="count">@(Model.Xes?.Count ?? 0) xe</span>
            </div>

            @if (Model.Xes != null && Model.Xes.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th style="width:70px">STT</th>
                                <th>Biển số</th>
                                <th>Tên xe</th>
                                <th>Loại xe</th>
                                <th>Năm SX</th>
                                <th>Tình trạng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int i = 0; }
                            @foreach (var xe in Model.Xes)
                            {
                                i++;
                                <tr>
                                    <td class="text-muted">@i</td>
                                    <td>
                                        <span class="badge-soft" style="background:#1c1c1c;color:#ffffff">
                                            @xe.BienSo
                                        </span>
                                    </td>
                                    <td class="fw-semibold">@xe.TenXe</td>
                                    <td class="text-muted">@(xe.LoaiXe?.TenLoaiXe ?? "-")</td>
                                    <td class="text-muted">@xe.NamSanXuat</td>
                                    <td>
                                        <span class="badge-soft" style="background:#eef2ff;color:#a5b4fc">
                                            @xe.TinhTrang
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <div style="font-size:40px;color:#52525b;letter-spacing:6px">— — —</div>
                    <div class="mt-2">Chưa có xe nào thuộc hãng này</div>
                </div>
            }
        </div>
    </div>
</div>