@* 
   File: Views/HangXe/Index.cshtml
   Noi dung: Danh sach hang xe co tim kiem, loc, sap xep, phan trang
   Sinh vien thuc hien: Pham Gia Minh Hoang - 23103100087 - SV1
   Module: Module 1 - Tai khoan, Dang nhap, Phan quyen, Loai xe, Hang xe
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.HangXe.HangXeListVM
@{
    ViewData["Title"] = "Hãng xe";
    int stt = (Model.Trang - 1) * Model.KichThuocTrang;

    var quocGiaList = ViewBag.QuocGiaList as List<string> ?? new List<string>();
    var tongHang = Model.TongSoBanGhi;
    var dangHoatDong = Model.DanhSach.Count(x => x.TrangThai);
    var dangNgung = Model.DanhSach.Count(x => !x.TrangThai);
    var coFilter = !string.IsNullOrEmpty(Model.TuKhoa)
                || !string.IsNullOrEmpty(Model.QuocGia)
                || Model.TrangThai.HasValue;
}

<style>
    .page-shell { background: #f5f7fa; min-height: 100vh; padding: 32px 0; }
    .page-wrap { max-width: 1440px; margin: 0 auto; padding: 0 24px; }

    .hang-hero {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: #fff;
        border-radius: 14px;
        padding: 32px 30px;
        margin-bottom: 24px;
        position: relative;
        overflow: hidden;
    }
    .hang-hero::before {
        content: "";
        position: absolute;
        top: -60px; right: -60px;
        width: 220px; height: 220px;
        background: rgba(255,255,255,.06);
        border-radius: 50%;
    }
    .hang-hero h1 {
        font-size: 28px; font-weight: 800;
        letter-spacing: -0.6px; margin: 0 0 6px 0;
    }
    .hang-hero .sub {
        font-size: 14px; opacity: .85;
        margin: 0 0 20px 0; max-width: 520px;
    }
    .stat-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
    }
    .stat-row .stat {
        background: rgba(255,255,255,.12);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,.14);
        border-radius: 10px;
        padding: 14px 16px;
    }
    .stat-row .stat .lbl {
        font-size: 11px; text-transform: uppercase;
        letter-spacing: .8px; opacity: .8; margin-bottom: 6px;
    }
    .stat-row .stat .num {
        font-size: 22px; font-weight: 800; line-height: 1;
    }
    .hero-actions { position: absolute; top: 32px; right: 30px; }

    .filter-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        margin-bottom: 20px;
        overflow: hidden;
    }
    .filter-card .head {
        display: flex; justify-content: space-between; align-items: center;
        padding: 16px 22px;
        border-bottom: 1px solid #f1f5f9;
    }
    .filter-card .head h6 {
        font-size: 12px; font-weight: 700;
        letter-spacing: 1px; text-transform: uppercase;
        color: #475569; margin: 0;
    }
    .filter-toggle {
        background: transparent; border: none;
        font-size: 13px; font-weight: 600;
        color: #1d4ed8; cursor: pointer;
        padding: 4px 8px; border-radius: 6px;
    }
    .filter-toggle:hover { background: #eff6ff; }
    .filter-card .body { padding: 18px 22px; }
    .filter-card .form-label {
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .5px;
        color: #64748b; margin-bottom: 6px;
    }
    .filter-card .form-control,
    .filter-card .form-select {
        border-radius: 8px; border-color: #d1d5db;
        font-size: 14px; height: 40px;
    }
    .filter-card .form-control:focus,
    .filter-card .form-select:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59,130,246,.12);
    }
    .filter-badge {
        display: inline-block;
        background: #eff6ff;
        color: #1d4ed8;
        font-size: 11px; font-weight: 700;
        padding: 3px 8px; border-radius: 6px;
        margin-left: 6px;
    }

    .data-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
    }
    .data-card .card-head {
        display: flex; justify-content: space-between; align-items: center;
        padding: 18px 22px;
        border-bottom: 1px solid #f1f5f9;
    }
    .data-card .card-head .title {
        font-size: 14px; font-weight: 700;
        color: #0f172a; margin: 0;
    }
    .data-card .card-head .count {
        font-size: 12px; color: #64748b;
        background: #f1f5f9;
        padding: 4px 12px; border-radius: 999px;
        font-weight: 600;
    }
    .data-card table { margin: 0; font-size: 14px; }
    .data-card thead th {
        background: #f9fafb;
        font-size: 11px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .5px;
        color: #475569; padding: 14px 16px;
        border-bottom: 1px solid #e5e7eb;
        white-space: nowrap;
    }
    .data-card tbody td {
        padding: 16px;
        border-bottom: 1px solid #f1f5f9;
        vertical-align: middle;
    }
    .data-card tbody tr:last-child td { border-bottom: none; }
    .data-card tbody tr:hover { background: #fafbfc; }

    .hang-name {
        font-weight: 700; color: #0f172a;
        font-size: 15px; margin-bottom: 4px;
    }
    .hang-meta { font-size: 12px; color: #64748b; }

    .country-chip {
        display: inline-block;
        background: #f0fdf4;
        color: #15803d;
        border: 1px solid #bbf7d0;
        padding: 5px 12px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 13px;
    }

    .status-pill {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .2px;
        white-space: nowrap;
    }
    .status-pill.on  { background: #dcfce7; color: #166534; }
    .status-pill.off { background: #f1f5f9; color: #64748b; }

    .count-xe {
        font-weight: 700;
        color: #0f172a;
        font-variant-numeric: tabular-nums;
    }

    .action-cell {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 6px;
        flex-wrap: nowrap;
    }
    .btn-clean {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 14px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 8px;
        border: 1px solid #d1d5db;
        background: #fff;
        color: #374151;
        text-decoration: none;
        transition: all .15s;
        line-height: 1;
        white-space: nowrap;
        min-height: 34px;
    }
    .btn-clean:hover { border-color: #9ca3af; background: #f9fafb; color: #111827; }
    .btn-clean.warn { color: #b45309; border-color: #fcd34d; }
    .btn-clean.warn:hover { background: #fffbeb; }
    .btn-clean.danger { color: #b91c1c; border-color: #fca5a5; }
    .btn-clean.danger:hover { background: #fef2f2; }

    .empty-state {
        padding: 80px 24px;
        text-align: center;
        color: #94a3b8;
    }
    .empty-state .big {
        font-size: 42px; font-weight: 700;
        color: #e5e7eb; letter-spacing: 4px;
    }
    .empty-state .msg { font-size: 15px; margin-top: 8px; }

    .pager {
        display: flex; justify-content: space-between; align-items: center;
        padding: 16px 22px;
        background: #f9fafb;
        border-top: 1px solid #e5e7eb;
        font-size: 13px; color: #64748b;
    }
    .pager .pagination { margin: 0; }
    .pager .page-link {
        border-radius: 8px; margin: 0 2px;
        border-color: #e5e7eb; color: #334155;
        font-size: 13px; font-weight: 600;
        padding: 6px 12px;
    }
    .pager .page-item.active .page-link {
        background: #1d4ed8; border-color: #1d4ed8;
    }
</style>

<div class="page-shell">
    <div class="page-wrap">

        <div class="hang-hero">
            <div class="hero-actions">
                <a asp-action="Create" class="btn btn-light fw-semibold px-4 py-2"
                   style="border-radius:8px">
                    + Thêm hãng xe mới
                </a>
            </div>
            <h1>Hãng xe</h1>
            <p class="sub">
                Danh mục hãng sản xuất xe (Toyota, Honda, Kia, Hyundai, Ford...).
                Dùng để phân loại xe theo hãng trong hệ thống cho thuê.
            </p>
            <div class="stat-row">
                <div class="stat">
                    <div class="lbl">Tổng số hãng</div>
                    <div class="num">@tongHang</div>
                </div>
                <div class="stat">
                    <div class="lbl">Đang hoạt động</div>
                    <div class="num">@dangHoatDong</div>
                </div>
                <div class="stat">
                    <div class="lbl">Ngừng hoạt động</div>
                    <div class="num">@dangNgung</div>
                </div>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>Thành công.</strong> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Lỗi.</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="filter-card">
            <div class="head">
                <h6>
                    Tìm kiếm &amp; lọc
                    @if (coFilter)
                    {
                        <span class="filter-badge">Đang lọc</span>
                    }
                </h6>
                <button type="button" class="filter-toggle" data-bs-toggle="collapse"
                        data-bs-target="#filterBody" aria-expanded="true">
                    Ẩn / hiện bộ lọc
                </button>
            </div>

            <div class="collapse show" id="filterBody">
                <div class="body">
                    <form method="get" asp-action="Index">
                        <input type="hidden" name="trang" value="1" />

                        <div class="row g-3 align-items-end">
                            <div class="col-md-3">
                                <label class="form-label">Từ khóa</label>
                                <input type="text" name="tuKhoa" value="@Model.TuKhoa"
                                       class="form-control"
                                       placeholder="Nhập tên hãng xe..." />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Quốc gia</label>
                                <select name="quocGia" class="form-select">
                                    <option value="">Tất cả</option>
                                    @foreach (var qg in quocGiaList)
                                    {
                                        <option value="@qg" selected="@(Model.QuocGia == qg)">@qg</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Trạng thái</label>
                                <select name="trangThai" class="form-select">
                                    <option value="">Tất cả</option>
                                    <option value="true" selected="@(Model.TrangThai == true)">Hoạt động</option>
                                    <option value="false" selected="@(Model.TrangThai == false)">Ngừng</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Sắp xếp theo</label>
                                <select name="sapXepTheo" class="form-select">
                                    <option value="">Mặc định</option>
                                    <option value="tenhangxe" selected="@(Model.SapXepTheo == "tenhangxe")">Tên hãng</option>
                                    <option value="quocgia" selected="@(Model.SapXepTheo == "quocgia")">Quốc gia</option>
                                </select>
                            </div>

                            <div class="col-md-2">
                                <label class="form-label">Hiển thị</label>
                                <select name="kichThuocTrang" class="form-select">
                                    <option value="10" selected="@(Model.KichThuocTrang == 10)">10 / trang</option>
                                    <option value="20" selected="@(Model.KichThuocTrang == 20)">20 / trang</option>
                                    <option value="50" selected="@(Model.KichThuocTrang == 50)">50 / trang</option>
                                </select>
                            </div>

                            <div class="col-md-12 d-flex justify-content-end gap-2 pt-2">
                                <a asp-action="Index" class="btn btn-outline-secondary px-3">Xóa lọc</a>
                                <button type="submit" class="btn btn-primary px-4">Áp dụng</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="data-card">
            <div class="card-head">
                <h6 class="title">Danh sách hãng xe</h6>
                <span class="count">
                    @Model.DanhSach.Count / @Model.TongSoBanGhi hãng
                </span>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:56px">STT</th>
                            <th>Hãng xe</th>
                            <th>Quốc gia</th>
                            <th>Mô tả</th>
                            <th class="text-center">Số xe</th>
                            <th>Trạng thái</th>
                            <th class="text-end" style="width:240px">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSach.Any())
                        {
                            foreach (var item in Model.DanhSach)
                            {
                                stt++;
                                <tr>
                                    <td class="text-muted">@stt</td>
                                    <td>
                                        <div class="hang-name">@item.TenHangXe</div>
                                        <div class="hang-meta">Mã hãng: #@item.MaHangXe</div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.QuocGia))
                                        {
                                            <span class="country-chip">@item.QuocGia</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-muted" style="max-width:280px">
                                        @(string.IsNullOrEmpty(item.MoTa) ? "—" : item.MoTa)
                                    </td>
                                    <td class="text-center">
                                        <span class="count-xe">@(item.Xes?.Count ?? 0)</span>
                                    </td>
                                    <td>
                                        @if (item.TrangThai)
                                        {
                                            <span class="status-pill on">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="status-pill off">Ngừng</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="action-cell">
                                            <a asp-action="Details" asp-route-id="@item.MaHangXe"
                                               class="btn-clean">Xem</a>
                                            <a asp-action="Edit" asp-route-id="@item.MaHangXe"
                                               class="btn-clean warn">Sửa</a>
                                            <form asp-action="DoiTrangThai" asp-route-id="@item.MaHangXe"
                                                  method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn-clean danger"
                                                        onclick="return confirm('Đổi trạng thái hãng xe này?')">
                                                    @(item.TrangThai ? "Ngừng" : "Bật")
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="empty-state">
                                        <div class="big">— — —</div>
                                        <div class="msg">Không có hãng xe nào phù hợp</div>
                                        @if (coFilter)
                                        {
                                            <a asp-action="Index" class="btn btn-outline-primary mt-3">
                                                Xóa bộ lọc
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TongSoTrang > 1)
            {
                <div class="pager">
                    <div>
                        Trang <strong>@Model.Trang</strong> / @Model.TongSoTrang —
                        hiển thị <strong>@Model.DanhSach.Count</strong> trong
                        <strong>@Model.TongSoBanGhi</strong> hãng
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(Model.CoTrangTruoc ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-trang="@(Model.Trang - 1)"
                                   asp-route-tuKhoa="@Model.TuKhoa"
                                   asp-route-quocGia="@Model.QuocGia"
                                   asp-route-trangThai="@Model.TrangThai"
                                   asp-route-sapXepTheo="@Model.SapXepTheo"
                                   asp-route-kichThuocTrang="@Model.KichThuocTrang">Trước</a>
                            </li>

                            @{
                                var batDau = Math.Max(1, Model.Trang - 2);
                                var ketThuc = Math.Min(Model.TongSoTrang, Model.Trang + 2);
                            }

                            @for (int i = batDau; i <= ketThuc; i++)
                            {
                                <li class="page-item @(i == Model.Trang ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-trang="@i"
                                       asp-route-tuKhoa="@Model.TuKhoa"
                                       asp-route-quocGia="@Model.QuocGia"
                                       asp-route-trangThai="@Model.TrangThai"
                                       asp-route-sapXepTheo="@Model.SapXepTheo"
                                       asp-route-kichThuocTrang="@Model.KichThuocTrang">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CoTrangSau ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-trang="@(Model.Trang + 1)"
                                   asp-route-tuKhoa="@Model.TuKhoa"
                                   asp-route-quocGia="@Model.QuocGia"
                                   asp-route-trangThai="@Model.TrangThai"
                                   asp-route-sapXepTheo="@Model.SapXepTheo"
                                   asp-route-kichThuocTrang="@Model.KichThuocTrang">Sau</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>