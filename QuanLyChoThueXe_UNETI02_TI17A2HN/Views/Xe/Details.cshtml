@*
    Details.cshtml - xem chi tiet xe
    sinh vien thuc hien: Dao Gia Hung - 23103100065
    module 2 - quan ly xe, bang gia thue
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Entities.Xe
@{
    ViewData["Title"] = "Chi tiết xe";

    var badge = Model.TinhTrang switch
    {
        "Sẵn sàng" => "bg-success text-white",
        "Đang được giữ chỗ" => "bg-info text-dark",
        "Đang cho thuê" => "bg-warning text-dark",
        "Bảo dưỡng" => "bg-danger text-white",
        "Ngừng hoạt động" => "bg-secondary text-white",
        _ => "bg-secondary text-white"
    };

    var anh = string.IsNullOrEmpty(Model.AnhXe) ? "/images/xe/default.jpg" : Model.AnhXe;
}

<div class="container py-4" style="max-width:1100px">

    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3">← Quay lại</a>
        <div>
            <h3 class="fw-bold mb-1">@Model.TenXe</h3>
            <p class="text-muted mb-0 small">
                Biển số:
                <span class="badge bg-light text-dark border">@Model.BienSo</span>
            </p>
        </div>
        <div class="ms-auto d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.MaXe" class="btn btn-warning">Sửa</a>
        </div>
    </div>

    <div class="row g-4">
        <!-- ẢNH -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">
                <img src="@anh"
                     class="card-img-top"
                     style="height:340px;object-fit:cover"
                     alt="@Model.TenXe" />

                <div class="card-body text-center">
                    <span class="badge @badge px-4 py-2 fs-6">@Model.TinhTrang</span>
                </div>
            </div>
        </div>

        <!-- THÔNG TIN -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <h6 class="text-uppercase text-muted small fw-bold mb-3">Thông tin chi tiết</h6>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Biển số</small>
                                <strong>@Model.BienSo</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Tên xe</small>
                                <strong>@Model.TenXe</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Loại xe</small>
                                <strong>@(Model.LoaiXe?.TenLoaiXe ?? "-")</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Hãng xe</small>
                                <strong>@(Model.HangXe?.TenHangXe ?? "-")</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Năm sản xuất</small>
                                <strong>@Model.NamSanXuat</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Màu sắc</small>
                                <strong>@(string.IsNullOrEmpty(Model.MauSac) ? "-" : Model.MauSac)</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Số chỗ</small>
                                <strong>@Model.SoCho chỗ</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Số km hiện tại</small>
                                <strong>@Model.SoKmHienTai.ToString("N0") km</strong>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.MoTa))
                        {
                            <div class="col-12">
                                <div class="p-3 bg-light rounded">
                                    <small class="text-muted d-block">Mô tả</small>
                                    <span>@Model.MoTa</span>
                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG GIÁ -->
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-4">
            <h6 class="text-uppercase text-muted small fw-bold mb-3">
                Bảng giá hiện có (@(Model.BangGiaThues?.Count ?? 0))
            </h6>

            @if (Model.BangGiaThues != null && Model.BangGiaThues.Any())
            {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Áp dụng cho</th>
                                <th>Từ ngày</th>
                                <th>Đến ngày</th>
                                <th class="text-end">Đơn giá ngày</th>
                                <th class="text-end">Đơn giá giờ</th>
                                <th class="text-end">Tiền cọc</th>
                                <th class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bg in Model.BangGiaThues
                                .OrderByDescending(b => b.TrangThai)
                                .ThenByDescending(b => b.TuNgay))
                            {
                                <tr>
                                    <td>
                                        @if (bg.MaXe.HasValue)
                                        {
                                            <span class="badge bg-primary">Riêng xe này</span>
                                        }
                                        else if (bg.MaLoaiXe.HasValue)
                                        {
                                            <span class="badge bg-info text-dark">
                                                Loại: @(bg.LoaiXe?.TenLoaiXe ?? "-")
                                            </span>
                                        }
                                    </td>
                                    <td>@bg.TuNgay.ToString("dd/MM/yyyy")</td>
                                    <td>@bg.DenNgay.ToString("dd/MM/yyyy")</td>
                                    <td class="text-end">@bg.DonGiaNgay.ToString("N0") đ</td>
                                    <td class="text-end">@bg.DonGiaGio.ToString("N0") đ</td>
                                    <td class="text-end">@bg.TienCocMacDinh.ToString("N0") đ</td>
                                    <td class="text-center">
                                        @if (bg.TrangThai)
                                        {
                                            <span class="badge bg-success">Đang áp dụng</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Ngừng</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mb-0">Chưa có bảng giá nào cho xe này.</p>
            }
        </div>
    </div>

</div>