@*
    Details.cshtml - xem chi tiet xe
    sinh vien thuc hien: Dao Gia Hung - 23103100065
    module 2 - quan ly xe, bang gia thue
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Entities.Xe
@{
    ViewData["Title"] = "Chi tiết xe";
}

<div class="container py-4" style="max-width:1100px">

    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3">← Quay lại</a>
        <div>
            <h3 class="fw-bold mb-1">@Model.TenXe</h3>
            <p class="text-muted mb-0 small">
                Biển số:
                <span class="badge bg-light text-dark border">@Model.BienSo</span>
            </p>
        </div>
    </div>

    <div class="row g-4">
        <!-- ẢNH -->
        <div class="col-md-5">
            <div class="card border-0 shadow-sm">
                <img src="@(string.IsNullOrEmpty(Model.AnhXe) ? "/images/xe/default.jpg" : Model.AnhXe)"
                     class="card-img-top"
                     style="height:340px;object-fit:cover" />

                <div class="card-body text-center">
                    @{
                        var badge = Model.TinhTrang switch
                        {
                            "Sẵn sàng" => "bg-success text-white",
                            "Đang được giữ chỗ" => "bg-info text-dark",
                            "Đang cho thuê" => "bg-warning text-dark",
                            "Bảo dưỡng" => "bg-danger text-white",
                            "Ngừng hoạt động" => "bg-secondary text-white",
                            _ => "bg-secondary text-white"
                        };
                    }
                    <span class="badge @badge px-4 py-2 fs-6">
                        @Model.TinhTrang
                    </span>
                </div>
            </div>
        </div>

        <!-- THÔNG TIN -->
        <div class="col-md-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">

                    <h6 class="text-uppercase text-muted small fw-bold mb-3">
                        Thông tin chi tiết
                    </h6>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Biển số</small>
                                <strong>@Model.BienSo</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Tên xe</small>
                                <strong>@Model.TenXe</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded">
                                <small class="text-muted d-block">Loại xe</small>
                                <strong>@Model