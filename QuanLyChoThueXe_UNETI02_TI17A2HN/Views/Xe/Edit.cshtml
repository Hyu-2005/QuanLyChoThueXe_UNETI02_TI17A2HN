@* [VIRELLO] Bảng màu CSS đã chuyển sang giao diện VIRELLO - Vũ Tiến Đạt (SV3) *@
@*
    Edit.cshtml - form sua xe
    sinh vien thuc hien: Dao Gia Hung - 23103100065
    module 2 - quan ly xe, bang gia thue
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.Xe.XeFormVM
@{
    ViewData["Title"] = "Sửa xe";
}

<style>
    .form-shell { background: #000000; min-height: 100vh; padding: 32px 0; }
    .form-wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }

    .form-head {
        margin-bottom: 28px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        padding-bottom: 20px;
        border-bottom: 1px solid rgba(255,255,255,.1);
    }
    .form-head .back {
        font-size: 13px; color: #94a3b8; text-decoration: none;
        display: inline-block; margin-bottom: 8px;
    }
    .form-head .back:hover { color: #E50914; }
    .form-head h1 {
        font-size: 26px; font-weight: 800; color: #ffffff;
        letter-spacing: -0.4px; margin: 0 0 4px 0;
    }
    .form-head .sub { font-size: 14px; color: #94a3b8; margin: 0; }
    .plate-chip {
        display: inline-block;
        background: #1c1c1c;
        border: 1px solid rgba(255,255,255,.1);
        padding: 4px 12px;
        border-radius: 0;
        font-weight: 700;
        color: #ffffff;
        font-size: 13px;
        margin-left: 8px;
        vertical-align: middle;
        font-variant-numeric: tabular-nums;
    }

    .form-card {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(0,0,0,.45);
    }
    .form-card .sect { padding: 28px 32px; border-bottom: 1px solid rgba(255,255,255,.06); }
    .form-card .sect:last-of-type { border-bottom: none; }
    .form-card .sect-title {
        display: flex; align-items: center; gap: 12px;
        font-size: 12px; font-weight: 700;
        text-transform: uppercase; letter-spacing: 1.2px;
        color: #94a3b8; margin: 0 0 22px 0;
    }
    .form-card .sect-title .num {
        width: 26px; height: 26px; border-radius: 50%;
        background: #b80710; color: #fff;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 12px; font-weight: 700; flex-shrink: 0;
    }
    .form-card .sect-title .hint {
        margin-left: auto; font-size: 11px; font-weight: 500;
        text-transform: none; letter-spacing: 0; color: #71717a;
    }

    .form-label { font-size: 13px; font-weight: 600; color: #cbd5e1; margin-bottom: 6px; }
    .form-label .req { color: #f87171; margin-left: 2px; }
    .form-control, .form-select {
        border-radius: 0; border-color: rgba(255,255,255,.2);
        font-size: 14px; padding: 9px 12px; height: 42px;
    }
    .form-control:focus, .form-select:focus {
        border-color: #E50914;
        box-shadow: 0 0 0 3px rgba(229,9,20,.12);
    }
    .input-group-text {
        background: #0a0a0a; border-color: rgba(255,255,255,.2);
        color: #94a3b8; font-weight: 600; font-size: 13px;
    }
    .form-text { font-size: 12px; color: #71717a; margin-top: 4px; }

    .upload-box {
        background: #0a0a0a;
        border: 2px dashed rgba(255,255,255,.2);
        border-radius: 0;
        padding: 24px 20px;
        text-align: center;
        transition: all .15s;
    }
    .upload-box:hover { border-color: #E50914; background: rgba(229,9,20,.10); }
    .upload-box .preview {
        width: 100%; height: 240px;
        object-fit: cover; border-radius: 0;
        border: 1px solid rgba(255,255,255,.1);
        margin-bottom: 16px; background: #121212;
    }
    .upload-box .hint { font-size: 12px; color: #94a3b8; margin-top: 8px; }
    .tips-box {
        background: rgba(229,9,20,.10);
        border-left: 4px solid #E50914;
        padding: 16px 20px;
        border-radius: 0;
        font-size: 13px;
        color: #E50914;
        line-height: 1.8;
    }
    .tips-box strong { color: #E50914; }

    .form-actions {
        padding: 20px 32px; background: #1c1c1c;
        border-top: 1px solid rgba(255,255,255,.1);
        display: flex; justify-content: flex-end; gap: 10px;
    }
    .form-actions .btn { padding: 10px 26px; font-weight: 600; border-radius: 0; }
</style>

<div class="form-shell">
    <div class="form-wrap">

        <div class="form-head">
            <div>
                <a asp-action="Index" class="back">← Quay lại danh sách</a>
                <h1>
                    Sửa xe
                    <span class="plate-chip">@Model.BienSo</span>
                </h1>
                <p class="sub">Cập nhật thông tin xe trong hệ thống</p>
            </div>
        </div>

        <form asp-action="Edit" asp-route-id="@Model.MaXe" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="MaXe" />
            <input type="hidden" asp-for="AnhXe" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="form-card">

                <div class="sect">
                    <h6 class="sect-title">
                        <span class="num">1</span> Thông tin cơ bản
                        <span class="hint">Cập nhật biển số, tên, loại và hãng xe</span>
                    </h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BienSo" class="form-label">
                                Biển số xe <span class="req">*</span>
                            </label>
                            <input asp-for="BienSo" class="form-control" />
                            <span asp-validation-for="BienSo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TenXe" class="form-label">
                                Tên xe <span class="req">*</span>
                            </label>
                            <input asp-for="TenXe" class="form-control" />
                            <span asp-validation-for="TenXe" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MaLoaiXe" class="form-label">
                                Loại xe <span class="req">*</span>
                            </label>
                            <select asp-for="MaLoaiXe" asp-items="Model.DanhSachLoaiXe" class="form-select"></select>
                            <span asp-validation-for="MaLoaiXe" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MaHangXe" class="form-label">
                                Hãng xe <span class="req">*</span>
                            </label>
                            <select asp-for="MaHangXe" asp-items="Model.DanhSachHangXe" class="form-select"></select>
                            <span asp-validation-for="MaHangXe" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="sect">
                    <h6 class="sect-title">
                        <span class="num">2</span> Thông số kỹ thuật
                        <span class="hint">Số km mới phải lớn hơn hoặc bằng số km hiện tại</span>
                    </h6>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="NamSanXuat" class="form-label">
                                Năm sản xuất <span class="req">*</span>
                            </label>
                            <input asp-for="NamSanXuat" type="number" class="form-control" />
                            <span asp-validation-for="NamSanXuat" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="MauSac" class="form-label">Màu sắc</label>
                            <input asp-for="MauSac" class="form-control" />
                        </div>

                        <div class="col-md-3">
                            <label asp-for="SoCho" class="form-label">
                                Số chỗ <span class="req">*</span>
                            </label>
                            <input asp-for="SoCho" type="number" class="form-control" />
                            <span asp-validation-for="SoCho" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="SoKmHienTai" class="form-label">
                                Số km hiện tại <span class="req">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="SoKmHienTai" type="number" step="0.01" class="form-control" />
                                <span class="input-group-text">km</span>
                            </div>
                            <span asp-validation-for="SoKmHienTai" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TinhTrang" class="form-label">
                                Tình trạng <span class="req">*</span>
                            </label>
                            <select asp-for="TinhTrang" asp-items="Model.DanhSachTinhTrang" class="form-select"></select>
                            <span asp-validation-for="TinhTrang" class="text-danger small"></span>
                            <div class="form-text">
                                Lưu ý: đổi sang Bảo dưỡng/Ngừng hoạt động có thể bị chặn
                                nếu xe còn lịch đặt chưa hoàn thành
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="MoTa" class="form-label">Mô tả</label>
                            <textarea asp-for="MoTa" rows="3" class="form-control"></textarea>
                        </div>
                    </div>
                </div>

                <div class="sect">
                    <h6 class="sect-title">
                        <span class="num">3</span> Ảnh xe
                        <span class="hint">Bỏ trống nếu muốn giữ ảnh hiện tại</span>
                    </h6>

                    <div class="row g-3">
                        <div class="col-md-5">
                            <div class="upload-box">
                                <img id="previewImg"
                                     src="@(string.IsNullOrEmpty(Model.AnhXe) ? "/images/xe/default.jpg" : Model.AnhXe)"
                                     class="preview" alt="Ảnh xe" />
                                <input asp-for="FileAnh" type="file" accept="image/*"
                                       class="form-control form-control-sm"
                                       onchange="previewImage(event)" />
                                <span asp-validation-for="FileAnh" class="text-danger small"></span>
                                <div class="hint">Chọn ảnh mới nếu muốn thay ảnh hiện tại</div>
                            </div>
                        </div>

                        <div class="col-md-7 d-flex align-items-center">
                            <div class="tips-box w-100">
                                <strong>Lưu ý khi đổi ảnh:</strong>
                                <div>· Nếu chọn ảnh mới, ảnh cũ sẽ bị xóa tự động khỏi server</div>
                                <div>· Kích thước tối đa 5MB, định dạng JPG/PNG/GIF/WEBP</div>
                                <div>· Nếu không chọn ảnh, hệ thống giữ nguyên ảnh hiện tại</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    <button type="submit" class="btn btn-warning">Cập nhật</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                document.getElementById('previewImg').src = URL.createObjectURL(file);
            }
        }
    </script>
}