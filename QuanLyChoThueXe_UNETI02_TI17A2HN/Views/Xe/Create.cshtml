@*
    Create.cshtml - form them xe moi
    sinh vien thuc hien: Dao Gia Hung - 23103100065
    module 2 - quan ly xe, bang gia thue
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.Xe.XeFormVM
@{
    ViewData["Title"] = "Thêm xe mới";
}

<style>
    .form-shell { background: #f5f7fa; min-height: 100vh; padding: 32px 0; }
    .form-wrap { max-width: 1180px; margin: 0 auto; padding: 0 24px; }

    .form-head {
        margin-bottom: 28px;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        padding-bottom: 20px;
        border-bottom: 1px solid #e5e7eb;
    }
    .form-head .back {
        font-size: 13px; color: #64748b; text-decoration: none;
        display: inline-block; margin-bottom: 8px;
    }
    .form-head .back:hover { color: #1d4ed8; }
    .form-head h1 {
        font-size: 26px; font-weight: 800; color: #0f172a;
        letter-spacing: -0.4px; margin: 0 0 4px 0;
    }
    .form-head .sub { font-size: 14px; color: #64748b; margin: 0; }

    .form-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 1px 3px rgba(15,23,42,.04);
    }
    .form-card .sect {
        padding: 28px 32px;
        border-bottom: 1px solid #f1f5f9;
    }
    .form-card .sect:last-of-type { border-bottom: none; }
    .form-card .sect-title {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: #64748b;
        margin: 0 0 22px 0;
    }
    .form-card .sect-title .num {
        width: 26px; height: 26px;
        border-radius: 50%;
        background: #1d4ed8;
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        flex-shrink: 0;
    }
    .form-card .sect-title .hint {
        margin-left: auto;
        font-size: 11px;
        font-weight: 500;
        text-transform: none;
        letter-spacing: 0;
        color: #94a3b8;
    }

    .form-label {
        font-size: 13px;
        font-weight: 600;
        color: #334155;
        margin-bottom: 6px;
    }
    .form-label .req { color: #dc2626; margin-left: 2px; }
    .form-control, .form-select {
        border-radius: 8px;
        border-color: #d1d5db;
        font-size: 14px;
        padding: 9px 12px;
        height: 42px;
    }
    .form-control:focus, .form-select:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 3px rgba(59,130,246,.12);
    }
    .input-group-text {
        background: #f8fafc;
        border-color: #d1d5db;
        color: #64748b;
        font-weight: 600;
        font-size: 13px;
    }
    .form-text { font-size: 12px; color: #94a3b8; margin-top: 4px; }

    .upload-box {
        background: #f8fafc;
        border: 2px dashed #cbd5e1;
        border-radius: 12px;
        padding: 24px 20px;
        text-align: center;
        transition: all .15s;
    }
    .upload-box:hover { border-color: #3b82f6; background: #eff6ff; }
    .upload-box .preview {
        width: 100%;
        height: 240px;
        object-fit: cover;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        margin-bottom: 16px;
        background: #fff;
    }
    .upload-box .hint {
        font-size: 12px;
        color: #64748b;
        margin-top: 8px;
    }
    .tips-box {
        background: #eff6ff;
        border-left: 4px solid #3b82f6;
        padding: 16px 20px;
        border-radius: 10px;
        font-size: 13px;
        color: #1e40af;
        line-height: 1.8;
    }
    .tips-box strong { color: #1e3a8a; }

    .form-actions {
        padding: 20px 32px;
        background: #f9fafb;
        border-top: 1px solid #e5e7eb;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }
    .form-actions .btn { padding: 10px 26px; font-weight: 600; border-radius: 8px; }
</style>

<div class="form-shell">
    <div class="form-wrap">

        <div class="form-head">
            <div>
                <a asp-action="Index" class="back">← Quay lại danh sách</a>
                <h1>Thêm xe mới</h1>
                <p class="sub">Điền đầy đủ thông tin để đăng ký xe vào hệ thống</p>
            </div>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="form-card">

                <div class="sect">
                    <h6 class="sect-title">
                        <span class="num">1</span> Thông tin cơ bản
                        <span class="hint">Biển số, tên và phân loại xe</span>
                    </h6>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="BienSo" class="form-label">
                                Biển số xe <span class="req">*</span>
                            </label>
                            <input asp-for="BienSo" class="form-control"
                                   placeholder="VD: 51A-12345" />
                            <span asp-validation-for="BienSo" class="text-danger small"></span>
                            <div class="form-text">Biển số phải là duy nhất trong hệ thống</div>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TenXe" class="form-label">
                                Tên xe <span class="req">*</span>
                            </label>
                            <input asp-for="TenXe" class="form-control"
                                   placeholder="VD: Toyota Vios 2022" />
                            <span asp-validation-for="TenXe" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MaLoaiXe" class="form-label">
                                Loại xe <span class="req">*</span>
                            </label>
                            <select asp-for="MaLoaiXe" asp-items="Model.DanhSachLoaiXe" class="form-select">
                                <option value="">-- Chọn loại xe --</option>
                            </select>
                            <span asp-validation-for="MaLoaiXe" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="MaHangXe" class="form-label">
                                Hãng xe <span class="req">*</span>
                            </label>
                            <select asp-for="MaHangXe" asp-items="Model.DanhSachHangXe" class="form-select">
                                <option value="">-- Chọn hãng xe --</option>
                            </select>
                            <span asp-validation-for="MaHangXe" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="sect">
                    <h6 class="sect-title">
                        <span class="num">2</span> Thông số kỹ thuật
                        <span class="hint">Năm sản xuất, màu sắc, số chỗ, km</span>
                    </h6>

                    <div class="row g-3">
                        <div class="col-md-3">
                            <label asp-for="NamSanXuat" class="form-label">
                                Năm sản xuất <span class="req">*</span>
                            </label>
                            <input asp-for="NamSanXuat" type="number"
                                   class="form-control" placeholder="2022" />
                            <span asp-validation-for="NamSanXuat" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="MauSac" class="form-label">Màu sắc</label>
                            <input asp-for="MauSac" class="form-control" placeholder="VD: Trắng" />
                            <span asp-validation-for="MauSac" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="SoCho" class="form-label">
                                Số chỗ <span class="req">*</span>
                            </label>
                            <input asp-for="SoCho" type="number" class="form-control" placeholder="4" />
                            <span asp-validation-for="SoCho" class="text-danger small"></span>
                        </div>

                        <div class="col-md-3">
                            <label asp-for="SoKmHienTai" class="form-label">
                                Số km hiện tại <span class="req">*</span>
                            </label>
                            <div class="input-group">
                                <input asp-for="SoKmHienTai" type="number" step="0.01"
                                       class="form-control" placeholder="0" />
                                <span class="input-group-text">km</span>
                            </div>
                            <span asp-validation-for="SoKmHienTai" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TinhTrang" class="form-label">
                                Tình trạng <span class="req">*</span>
                            </label>
                            <select asp-for="TinhTrang" asp-items="Model.DanhSachTinhTrang" class="form-select">
                                <option value="">-- Chọn tình trạng --</option>
                            </select>
                            <span asp-validation-for="TinhTrang" class="text-danger small"></span>
                            <div class="form-text">
                                Xe Bảo dưỡng/Ngừng hoạt động sẽ không nhận đơn đặt mới
                            </div>
                        </div>

                        <div class="col-12">
                            <label asp-for="MoTa" class="form-label">Mô tả</label>
                            <textarea asp-for="MoTa" rows="3" class="form-control"
                                      placeholder="Mô tả chi tiết về xe, tình trạng nội thất, ngoại thất..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>
                    </div>
                </div>

                <div class="sect">
                    <h6 class="sect-title">
                        <span class="num">3</span> Ảnh xe
                        <span class="hint">Hỗ trợ JPG, PNG, GIF, WEBP (tối đa 5MB)</span>
                    </h6>

                    <div class="row g-3">
                        <div class="col-md-5">
                            <div class="upload-box">
                                <img id="previewImg" src="/images/xe/default.jpg"
                                     class="preview" alt="Ảnh xe" />
                                <input asp-for="FileAnh" type="file" accept="image/*"
                                       class="form-control form-control-sm"
                                       onchange="previewImage(event)" />
                                <span asp-validation-for="FileAnh" class="text-danger small"></span>
                                <div class="hint">Chọn ảnh ngang 4:3 hoặc 16:9 để hiển thị đẹp nhất</div>
                            </div>
                        </div>

                        <div class="col-md-7 d-flex align-items-center">
                            <div class="tips-box w-100">
                                <strong>Gợi ý chọn ảnh đẹp:</strong>
                                <div>· Chụp ngang xe, thấy đủ 4 bánh, nền sáng</div>
                                <div>· Tỉ lệ 4:3 hoặc 16:9, dung lượng &lt; 2MB để tải nhanh</div>
                                <div>· Ưu tiên ảnh thực tế, không dùng ảnh quảng cáo</div>
                                <div>· Ảnh sẽ được lưu tự động vào <code>/images/xe/</code></div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-actions">
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                    <button type="submit" class="btn btn-primary">Lưu xe</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                document.getElementById('previewImg').src = URL.createObjectURL(file);
            }
        }
    </script>
}