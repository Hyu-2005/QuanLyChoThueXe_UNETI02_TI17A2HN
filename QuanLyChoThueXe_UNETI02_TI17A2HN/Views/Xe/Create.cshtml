@*
    Create.cshtml - form them xe moi
    sinh vien thuc hien: Dao Gia Hung - 23103100065
    module 2 - quan ly xe, bang gia thue
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.Xe.XeFormVM
@{
    ViewData["Title"] = "Thêm xe";
}

<div class="container py-4" style="max-width:1100px">

    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3">← Quay lại</a>
        <div>
            <h3 class="fw-bold mb-1">Thêm xe mới</h3>
            <p class="text-muted mb-0 small">Điền thông tin xe để thêm vào hệ thống</p>
        </div>
    </div>

    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="row g-4">
            <!-- CỘT ẢNH -->
            <div class="col-md-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center d-flex flex-column justify-content-center">
                        <label class="form-label fw-semibold mb-3">Ảnh xe</label>

                        <div class="mb-3">
                            <img id="previewImg" src="/images/xe/default.jpg"
                                 class="rounded shadow-sm border"
                                 style="width:100%;height:220px;object-fit:cover" />
                        </div>

                        <input asp-for="FileAnh" type="file" accept="image/*"
                               class="form-control form-control-sm"
                               onchange="previewImage(event)" />
                        <span asp-validation-for="FileAnh" class="text-danger small"></span>

                        <small class="text-muted d-block mt-2">JPG, PNG, GIF, WEBP</small>
                    </div>
                </div>
            </div>

            <!-- CỘT FORM -->
            <div class="col-md-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-4">

                        <h6 class="text-uppercase text-muted small fw-bold mb-3">
                            Thông tin cơ bản
                        </h6>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="BienSo" class="form-label fw-semibold"></label>
                                <input asp-for="BienSo" class="form-control" placeholder="VD: 51A-12345" />
                                <span asp-validation-for="BienSo" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TenXe" class="form-label fw-semibold"></label>
                                <input asp-for="TenXe" class="form-control" placeholder="VD: Toyota Vios" />
                                <span asp-validation-for="TenXe" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MaLoaiXe" class="form-label fw-semibold"></label>
                                <select asp-for="MaLoaiXe" asp-items="Model.DanhSachLoaiXe" class="form-select">
                                    <option value="">-- Chọn loại xe --</option>
                                </select>
                                <span asp-validation-for="MaLoaiXe" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MaHangXe" class="form-label fw-semibold"></label>
                                <select asp-for="MaHangXe" asp-items="Model.DanhSachHangXe" class="form-select">
                                    <option value="">-- Chọn hãng xe --</option>
                                </select>
                                <span asp-validation-for="MaHangXe" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="my-4" />

                        <h6 class="text-uppercase text-muted small fw-bold mb-3">
                            Thông số kỹ thuật
                        </h6>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="NamSanXuat" class="form-label fw-semibold"></label>
                                <input asp-for="NamSanXuat" type="number" class="form-control" />
                                <span asp-validation-for="NamSanXuat" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="MauSac" class="form-label fw-semibold"></label>
                                <input asp-for="MauSac" class="form-control" placeholder="VD: Trắng" />
                                <span asp-validation-for="MauSac" class="text-danger small"></span>
                            </div>

                            <div class="col-md-4">
                                <label asp-for="SoCho" class="form-label fw-semibold"></label>
                                <input asp-for="SoCho" type="number" class="form-control" />
                                <span asp-validation-for="SoCho" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SoKmHienTai" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <input asp-for="SoKmHienTai" type="number" step="0.01" class="form-control" />
                                    <span class="input-group-text">km</span>
                                </div>
                                <span asp-validation-for="SoKmHienTai" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="TinhTrang" class="form-label fw-semibold"></label>
                                <select asp-for="TinhTrang" asp-items="Model.DanhSachTinhTrang" class="form-select">
                                    <option value="">-- Chọn tình trạng --</option>
                                </select>
                                <span asp-validation-for="TinhTrang" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="MoTa" class="form-label fw-semibold"></label>
                                <textarea asp-for="MoTa" rows="3" class="form-control"
                                          placeholder="Mô tả chi tiết về xe..."></textarea>
                                <span asp-validation-for="MoTa" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-top d-flex justify-content-end gap-2 py-3">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4">Lưu xe</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                document.getElementById('previewImg').src = URL.createObjectURL(file);
            }
        }
    </script>
}