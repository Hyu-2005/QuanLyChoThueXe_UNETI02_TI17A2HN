@* 
   File: Views/GiayTo/CuaToi.cshtml
   Họ và tên: [Vũ Tiến Đạt]
   Mã sinh viên: [23103100119]
   Nội dung thực hiện: Khách hàng tải giấy tờ (CCCD, GPLX) và xem trạng thái kiểm tra
   Module: Module 3 - Khách hàng
*@
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.GiayTo.GiayToCuaToiVM

@{
    ViewData["Title"] = "Giấy tờ của tôi";

    string BadgeClass(string trangThai) =>
        trangThai == TrangThaiGiayTo.DaXacMinh ? "ok"
        : trangThai == TrangThaiGiayTo.TuChoi ? "bad"
        : "wait";

    var hoSoDayDu = LoaiGiayTo.TatCa.All(l =>
        Model.DanhSach.Any(d => d.LoaiGiayTo == l && d.TrangThai == TrangThaiGiayTo.DaXacMinh));
}

<style>
    .gt-shell { background: #f5f7fa; padding: 28px 0; }
    .gt-wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }
    .gt-hero {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: #fff; border-radius: 14px; padding: 28px 30px; margin-bottom: 22px;
    }
    .gt-hero h1 { font-size: 26px; font-weight: 800; margin: 0 0 6px 0; }
    .gt-hero p { margin: 0; opacity: .88; font-size: 14px; }
    .gt-card { background: #fff; border: 1px solid #e5e7eb; border-radius: 14px; overflow: hidden; margin-bottom: 18px; }
    .gt-card .head { padding: 16px 22px; border-bottom: 1px solid #f1f5f9; font-weight: 700; font-size: 14px; }
    .gt-card .body { padding: 20px 22px; }
    .gt-card .form-label { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: .4px; color: #64748b; }
    .gt-card .form-control, .gt-card .form-select { border-radius: 8px; font-size: 14px; }
    .pill { display: inline-block; padding: 4px 12px; border-radius: 999px; font-size: 12px; font-weight: 700; }
    .pill.ok { background: #dcfce7; color: #166534; }
    .pill.wait { background: #fef3c7; color: #92400e; }
    .pill.bad { background: #fee2e2; color: #991b1b; }
    .gt-meta { font-size: 13px; color: #475569; margin-bottom: 4px; }
    .gt-meta .lbl { color: #94a3b8; font-size: 11px; text-transform: uppercase; letter-spacing: .3px; }
    .gt-thumbs { display: flex; gap: 10px; margin-top: 12px; flex-wrap: wrap; }
    .gt-thumb {
        width: 150px; height: 100px; border: 1px solid #e5e7eb; border-radius: 8px;
        overflow: hidden; display: flex; align-items: center; justify-content: center;
        background: #f9fafb; font-size: 12px; color: #1d4ed8; font-weight: 600; text-decoration: none;
    }
    .gt-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .gt-reason { background: #fef2f2; color: #991b1b; border-radius: 8px; padding: 8px 12px; font-size: 13px; margin-top: 10px; }
    .gt-empty { color: #94a3b8; font-size: 14px; }
</style>

<div class="gt-shell">
    <div class="gt-wrap">

        <div class="gt-hero">
            <h1>Giấy tờ của tôi</h1>
            <p>
                Tải lên CCCD và giấy phép lái xe để nhân viên kiểm tra.
                @if (hoSoDayDu)
                {
                    <strong>Hồ sơ của bạn đã được xác minh đầy đủ.</strong>
                }
            </p>
        </div>

        <div class="row g-4">

            <!-- FORM TAI LEN -->
            <div class="col-lg-5">
                <div class="gt-card">
                    <div class="head">Tải giấy tờ lên</div>
                    <div class="body">
                        <form asp-action="TaiLen" method="post" enctype="multipart/form-data">
                            <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

                            <div class="mb-3">
                                <label asp-for="LoaiGiayTo" class="form-label"></label>
                                <select asp-for="LoaiGiayTo" class="form-select" id="loaiGiayTo">
                                    @foreach (var l in LoaiGiayTo.TatCa)
                                    {
                                        <option value="@l" selected="@(Model.LoaiGiayTo == l)">
                                            @LoaiGiayTo.GetDisplayName(l)
                                        </option>
                                    }
                                </select>
                                <span asp-validation-for="LoaiGiayTo" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="SoGiayTo" class="form-label"></label>
                                <input asp-for="SoGiayTo" class="form-control" placeholder="Nhập số trên giấy tờ" />
                                <span asp-validation-for="SoGiayTo" class="text-danger small"></span>
                            </div>

                            <div class="mb-3" id="boxNgayHetHan">
                                <label asp-for="NgayHetHan" class="form-label"></label>
                                <input asp-for="NgayHetHan" type="date" class="form-control" />
                                <span asp-validation-for="NgayHetHan" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="FileMatTruoc" class="form-label"></label>
                                <input asp-for="FileMatTruoc" type="file" class="form-control"
                                       accept=".jpg,.jpeg,.png,.webp,.pdf" />
                                <span asp-validation-for="FileMatTruoc" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="FileMatSau" class="form-label"></label>
                                <input asp-for="FileMatSau" type="file" class="form-control"
                                       accept=".jpg,.jpeg,.png,.webp,.pdf" />
                                <span asp-validation-for="FileMatSau" class="text-danger small"></span>
                            </div>

                            <div class="small text-muted mb-3">
                                Chấp nhận .jpg, .png, .webp, .pdf – tối đa 5 MB mỗi file.
                                Tải lại cùng loại giấy tờ sẽ thay thế bản cũ và phải được kiểm tra lại.
                            </div>

                            <button type="submit" class="btn btn-primary w-100">Tải lên</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- TRANG THAI GIAY TO -->
            <div class="col-lg-7">
                @foreach (var loai in LoaiGiayTo.TatCa)
                {
                    var gt = Model.DanhSach.FirstOrDefault(d => d.LoaiGiayTo == loai);

                    <div class="gt-card">
                        <div class="head d-flex justify-content-between align-items-center">
                            <span>@LoaiGiayTo.GetDisplayName(loai)</span>
                            @if (gt != null)
                            {
                                <span class="pill @BadgeClass(gt.TrangThai)">@gt.TrangThai</span>
                            }
                        </div>
                        <div class="body">
                            @if (gt == null)
                            {
                                <div class="gt-empty">Bạn chưa tải giấy tờ này.</div>
                            }
                            else
                            {
                                <div class="gt-meta"><span class="lbl">Số giấy tờ:</span> <strong>@gt.SoGiayTo</strong></div>
                                @if (gt.NgayHetHan.HasValue)
                                {
                                    <div class="gt-meta"><span class="lbl">Hết hạn:</span> @gt.NgayHetHan.Value.ToString("dd/MM/yyyy")</div>
                                }
                                <div class="gt-meta"><span class="lbl">Tải lên:</span> @gt.NgayTai.ToString("dd/MM/yyyy HH:mm")</div>
                                @if (gt.NgayKiemTra.HasValue)
                                {
                                    <div class="gt-meta">
                                        <span class="lbl">Kiểm tra:</span>
                                        @gt.NgayKiemTra.Value.ToString("dd/MM/yyyy HH:mm")
                                        @if (!string.IsNullOrEmpty(gt.NguoiKiemTra))
                                        {
                                            <text>– @gt.NguoiKiemTra</text>
                                        }
                                    </div>
                                }

                                @if (gt.TrangThai == TrangThaiGiayTo.TuChoi && !string.IsNullOrEmpty(gt.LyDoTuChoi))
                                {
                                    <div class="gt-reason"><strong>Lý do từ chối:</strong> @gt.LyDoTuChoi</div>
                                }

                                <div class="gt-thumbs">
                                    <a class="gt-thumb" target="_blank"
                                       asp-action="Xem" asp-route-id="@gt.MaGiayTo" asp-route-mat="truoc">
                                        @if (gt.DuongDanMatTruoc.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <span>Mở PDF (mặt trước)</span>
                                        }
                                        else
                                        {
                                            <img alt="Mặt trước" src="@Url.Action("Xem", "GiayTo", new { id = gt.MaGiayTo, mat = "truoc" })" />
                                        }
                                    </a>
                                    @if (!string.IsNullOrEmpty(gt.DuongDanMatSau))
                                    {
                                        <a class="gt-thumb" target="_blank"
                                           asp-action="Xem" asp-route-id="@gt.MaGiayTo" asp-route-mat="sau">
                                            @if (gt.DuongDanMatSau.EndsWith(".pdf", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <span>Mở PDF (mặt sau)</span>
                                            }
                                            else
                                            {
                                                <img alt="Mặt sau" src="@Url.Action("Xem", "GiayTo", new { id = gt.MaGiayTo, mat = "sau" })" />
                                            }
                                        </a>
                                    }
                                </div>

                                @if (gt.TrangThai != TrangThaiGiayTo.DaXacMinh)
                                {
                                    <form asp-action="Xoa" asp-route-id="@gt.MaGiayTo" method="post" class="mt-3"
                                          onsubmit="return confirm('Xóa giấy tờ này?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                    </form>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Chi hien o "Ngay het han" khi chon GPLX
        (function () {
            var sel = document.getElementById('loaiGiayTo');
            var box = document.getElementById('boxNgayHetHan');
            function capNhat() { box.style.display = sel.value === 'GPLX' ? '' : 'none'; }
            sel.addEventListener('change', capNhat);
            capNhat();
        })();
    </script>
}
