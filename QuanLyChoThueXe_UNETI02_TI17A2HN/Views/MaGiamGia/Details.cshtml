@* [VIRELLO] Bảng màu CSS đã chuyển sang giao diện VIRELLO - Vũ Tiến Đạt (SV3) *@
@*
    Details.cshtml - Chi tiết mã giảm giá + lịch sử sử dụng
    Sinh viên thực hiện: Dương Lâm Huy - 23103100120 - SV5
    Module: Module 5 - Tính tiền, Thanh toán
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Entities.MaGiamGia
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants
@{
    ViewData["Title"] = "Chi tiết mã giảm giá";

    var now = DateTime.Now;
    var statusText = !Model.TrangThai ? "Đã tắt"
        : Model.NgayKetThuc < now ? "Hết hạn"
        : Model.NgayBatDau > now ? "Chưa hiệu lực"
        : Model.SoLuotDaDung >= Model.SoLuotDungToiDa ? "Hết lượt"
        : "Đang chạy";

    var statusClass = !Model.TrangThai ? "off"
        : Model.NgayKetThuc < now ? "expired"
        : Model.NgayBatDau > now ? "pending"
        : Model.SoLuotDaDung >= Model.SoLuotDungToiDa ? "used-up"
        : "active";

    var percentUsed = Model.SoLuotDungToiDa > 0
        ? (int)Math.Round((double)Model.SoLuotDaDung / Model.SoLuotDungToiDa * 100)
        : 0;
}

<style>
    .detail-shell {
        background: #000000;
        min-height: 100vh;
        padding: 32px 0;
    }

    .detail-wrap {
        max-width: 1180px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .detail-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 28px;
        padding-bottom: 20px;
        border-bottom: 1px solid rgba(255,255,255,.1);
        flex-wrap: wrap;
        gap: 16px;
    }

        .detail-head .back {
            font-size: 13px;
            color: #94a3b8;
            text-decoration: none;
            display: inline-block;
            margin-bottom: 8px;
        }

            .detail-head .back:hover {
                color: #E50914;
            }

        .detail-head h1 {
            font-size: 26px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.4px;
            margin: 0 0 8px 0;
        }

    .voucher-code-big {
        display: inline-block;
        background: rgba(139,92,246,.18);
        color: #c4b5fd;
        font-size: 24px;
        font-weight: 800;
        padding: 8px 20px;
        border-radius: 4px;
        font-family: 'Courier New', monospace;
        letter-spacing: 2px;
        margin-bottom: 8px;
    }

    .status-pill {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .3px;
        text-transform: uppercase;
    }

        .status-pill.active {
            background: rgba(34,197,94,.15);
            color: #86efac;
        }

        .status-pill.off {
            background: #1c1c1c;
            color: #94a3b8;
        }

        .status-pill.expired {
            background: rgba(239,68,68,.15);
            color: #fca5a5;
        }

        .status-pill.pending {
            background: rgba(245,158,11,.15);
            color: #fcd34d;
        }

        .status-pill.used-up {
            background: rgba(139,92,246,.15);
            color: #c4b5fd;
        }

    .info-card {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        padding: 26px 30px;
        margin-bottom: 20px;
    }

        .info-card .title {
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: #94a3b8;
            margin: 0 0 18px 0;
        }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 11px 0;
        border-bottom: 1px solid rgba(255,255,255,.06);
        font-size: 14px;
    }

        .info-row:last-child {
            border-bottom: none;
        }

        .info-row .lbl {
            color: #94a3b8;
        }

        .info-row .val {
            font-weight: 600;
            color: #ffffff;
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

    .stat-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 20px;
    }

    .stat-box {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        padding: 18px 22px;
        border-left: 4px solid #E50914;
    }

        .stat-box.green {
            border-left-color: #10b981;
        }

        .stat-box.amber {
            border-left-color: #f59e0b;
        }

        .stat-box .lbl {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #94a3b8;
            margin-bottom: 8px;
        }

        .stat-box .val {
            font-size: 24px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.6px;
            font-variant-numeric: tabular-nums;
        }

    .progress-usage {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 12px;
    }

    .progress-bar-custom {
        flex: 1;
        height: 10px;
        background: rgba(255,255,255,.1);
        border-radius: 999px;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #10b981 0%, #34d399 100%);
        transition: width .3s;
    }

    .progress-text {
        font-size: 12px;
        color: #94a3b8;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        font-weight: 600;
    }

    .data-card {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        overflow: hidden;
    }

        .data-card .card-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 22px;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

            .data-card .card-head .title {
                font-size: 14px;
                font-weight: 700;
                color: #ffffff;
                margin: 0;
            }

            .data-card .card-head .count {
                font-size: 12px;
                color: #94a3b8;
                background: #1c1c1c;
                padding: 4px 12px;
                border-radius: 999px;
                font-weight: 600;
            }

        .data-card table {
            margin: 0;
            font-size: 14px;
        }

        .data-card thead th {
            background: #1c1c1c;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #cbd5e1;
            padding: 14px 16px;
            border-bottom: 1px solid rgba(255,255,255,.1);
            white-space: nowrap;
        }

        .data-card tbody td {
            padding: 14px 16px;
            border-bottom: 1px solid rgba(255,255,255,.06);
            vertical-align: middle;
        }

        .data-card tbody tr:last-child td {
            border-bottom: none;
        }

        .data-card tbody tr:hover {
            background: #161616;
        }

    .money {
        font-variant-numeric: tabular-nums;
        font-weight: 600;
        color: #ffffff;
    }

        .money.green {
            color: #34d399;
        }
</style>

<div class="detail-shell">
    <div class="detail-wrap">

        <!-- HEADER -->
        <div class="detail-head">
            <div>
                <a asp-action="Index" class="back">← Quay lại danh sách</a>
                <div class="voucher-code-big">@Model.Code</div>
                <h1>@Model.TenChuongTrinh</h1>
                <span class="status-pill @statusClass">@statusText</span>
            </div>
            <div>
                <a asp-action="Edit" asp-route-id="@Model.MaGiamGiaId"
                   class="btn btn-warning px-4 py-2 fw-semibold" style="border-radius:0">
                    Sửa mã
                </a>
            </div>
        </div>

        <!-- STATS -->
        <div class="stat-grid">
            <div class="stat-box green">
                <div class="lbl">Đã sử dụng</div>
                <div class="val">@Model.SoLuotDaDung / @Model.SoLuotDungToiDa</div>
                <div class="progress-usage">
                    <div class="progress-bar-custom">
                        <div class="progress-bar-fill" style="width: @(percentUsed)%"></div>
                    </div>
                    <span class="progress-text">@percentUsed%</span>
                </div>
            </div>

            <div class="stat-box amber">
                <div class="lbl">Còn lại</div>
                <div class="val">@Model.SoLuotConLai lượt</div>
            </div>

            <div class="stat-box">
                <div class="lbl">Tổng tiền đã giảm</div>
                <div class="val">@(Model.SuDungMaGiamGias?.Sum(s => s.SoTienDuocGiam).ToString("N0") ?? "0") đ</div>
            </div>
        </div>

        <!-- THÔNG TIN VOUCHER -->
        <div class="row g-4 mb-4">
            <div class="col-md-6">
                <div class="info-card">
                    <h6 class="title">Thông tin giảm giá</h6>
                    <div class="info-row">
                        <span class="lbl">Loại giảm</span>
                        <span class="val">@LoaiGiamGia.GetDisplayName(Model.LoaiGiamGia)</span>
                    </div>
                    <div class="info-row">
                        <span class="lbl">Giá trị giảm</span>
                        <span class="val" style="color:#E50914; font-size:16px">
                            @if (Model.LoaiGiamGia == LoaiGiamGia.PhanTram)
                            {
                                <text>@Model.GiaTriGiam.ToString("N0")%</text>
                            }
                            else
                            {
                                <text>@Model.GiaTriGiam.ToString("N0") đ</text>
                            }
                        </span>
                    </div>
                    @if (Model.GiamToiDa.HasValue && Model.LoaiGiamGia == LoaiGiamGia.PhanTram)
                    {
                        <div class="info-row">
                            <span class="lbl">Giảm tối đa</span>
                            <span class="val">@Model.GiamToiDa.Value.ToString("N0") đ</span>
                        </div>
                    }
                    <div class="info-row">
                        <span class="lbl">Đơn hàng tối thiểu</span>
                        <span class="val">@Model.DonHangToiThieu.ToString("N0") đ</span>
                    </div>
                    <div class="info-row">
                        <span class="lbl">Mỗi khách 1 lần</span>
                        <span class="val">@(Model.MoiKhachMotLan ? "Có" : "Không")</span>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="info-card">
                    <h6 class="title">Hiệu lực &amp; Trạng thái</h6>
                    <div class="info-row">
                        <span class="lbl">Ngày bắt đầu</span>
                        <span class="val">@Model.NgayBatDau.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="info-row">
                        <span class="lbl">Ngày kết thúc</span>
                        <span class="val">@Model.NgayKetThuc.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    <div class="info-row">
                        <span class="lbl">Trạng thái</span>
                        <span class="val">
                            @if (Model.TrangThai)
                            {
                                <span style="color:#86efac">Đang bật</span>
                            }
                            else
                            {
                                <span style="color:#94a3b8">Đã tắt</span>
                            }
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.MoTa))
                    {
                        <div class="info-row" style="flex-direction:column; align-items:flex-start; gap:8px">
                            <span class="lbl">Mô tả</span>
                            <span class="val" style="text-align:left; font-weight:400; color:#cbd5e1">@Model.MoTa</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- LỊCH SỬ SỬ DỤNG -->
        <div class="data-card">
            <div class="card-head">
                <h6 class="title">Lịch sử sử dụng</h6>
                <span class="count">@(Model.SuDungMaGiamGias?.Count ?? 0) lượt</span>
            </div>

            @if (Model.SuDungMaGiamGias != null && Model.SuDungMaGiamGias.Any())
            {
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th style="width:56px">STT</th>
                                <th>Khách hàng</th>
                                <th>Đơn đặt xe</th>
                                <th class="text-end">Tiền được giảm</th>
                                <th>Ngày sử dụng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int idx = 0;
                            }
                            @foreach (var s in Model.SuDungMaGiamGias.OrderByDescending(x => x.NgaySuDung))
                            {
                                idx++;
                                <tr>
                                    <td class="text-muted">@idx</td>
                                    <td>
                                        <div class="fw-bold">@(s.KhachHang?.HoTen ?? "-")</div>
                                        <div class="small text-muted">@(s.KhachHang?.SoDienThoai ?? "-")</div>
                                    </td>
                                    <td>
                                        <a asp-controller="DatXe" asp-action="Details" asp-route-id="@s.MaDatXe"
                                           class="text-decoration-none" style="color:#93c5fd">
                                            #@s.MaDatXe
                                        </a>
                                    </td>
                                    <td class="text-end">
                                        <span class="money green">- @s.SoTienDuocGiam.ToString("N0") đ</span>
                                    </td>
                                    <td class="text-muted">@s.NgaySuDung.ToString("dd/MM/yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <div style="font-size:40px;color:#52525b;letter-spacing:6px">— — —</div>
                    <div class="mt-2">Chưa có ai sử dụng mã này</div>
                </div>
            }
        </div>
    </div>
</div>