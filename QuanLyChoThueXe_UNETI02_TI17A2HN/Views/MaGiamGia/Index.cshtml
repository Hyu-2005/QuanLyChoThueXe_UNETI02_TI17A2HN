@* [VIRELLO] Bảng màu CSS đã chuyển sang giao diện VIRELLO - Vũ Tiến Đạt (SV3) *@
@*
    Index.cshtml - Danh sách mã giảm giá (Admin)
    Sinh viên thực hiện: Dương Lâm Huy - 23103100120 - SV5
    Module: Module 5 - Tính tiền, Thanh toán
*@
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.MaGiamGia.MaGiamGiaListVM
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants
@{
    ViewData["Title"] = "Mã giảm giá";
    int stt = (Model.Trang - 1) * Model.KichThuocTrang;

    // Hàm xác định trạng thái hiển thị
    string GetStatusClass(QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Entities.MaGiamGia v)
    {
        if (!v.TrangThai) return "off";
        var now = DateTime.Now;
        if (v.NgayKetThuc < now) return "expired";
        if (v.NgayBatDau > now) return "pending";
        if (v.SoLuotDaDung >= v.SoLuotDungToiDa) return "used-up";
        return "active";
    }

    string GetStatusText(QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Entities.MaGiamGia v)
    {
        if (!v.TrangThai) return "Đã tắt";
        var now = DateTime.Now;
        if (v.NgayKetThuc < now) return "Hết hạn";
        if (v.NgayBatDau > now) return "Chưa hiệu lực";
        if (v.SoLuotDaDung >= v.SoLuotDungToiDa) return "Hết lượt";
        return "Đang chạy";
    }
}

<style>
    .page-shell {
        background: #000000;
        min-height: 100vh;
        padding: 32px 0;
    }

    .page-wrap {
        max-width: 1440px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .page-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 24px;
        padding-bottom: 20px;
        border-bottom: 1px solid rgba(255,255,255,.1);
        flex-wrap: wrap;
        gap: 16px;
    }

        .page-head h1 {
            font-size: 26px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.4px;
            margin: 0 0 4px 0;
        }

        .page-head .sub {
            font-size: 14px;
            color: #94a3b8;
            margin: 0;
        }

    .head-actions {
        display: flex;
        gap: 10px;
    }

    .btn-create {
        background: linear-gradient(135deg, #b80710 0%, #E50914 100%);
        color: #fff;
        border: none;
        padding: 11px 22px;
        font-weight: 700;
        font-size: 13px;
        border-radius: 0;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        box-shadow: 0 4px 12px rgba(229,9,20,.25);
        transition: all .2s;
    }

        .btn-create:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 6px 18px rgba(229,9,20,.35);
        }

    .stat-strip {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 20px;
    }

    .stat-card {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        padding: 18px 22px;
        border-left: 4px solid #10b981;
    }

        .stat-card.red {
            border-left-color: #ef4444;
        }

        .stat-card.amber {
            border-left-color: #f59e0b;
        }

        .stat-card .lbl {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #94a3b8;
            margin-bottom: 8px;
        }

        .stat-card .val {
            font-size: 28px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.6px;
            font-variant-numeric: tabular-nums;
        }

        .stat-card.green .val {
            color: #86efac;
        }

        .stat-card.red .val {
            color: #fca5a5;
        }

        .stat-card.amber .val {
            color: #fbbf24;
        }

    .filter-card {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        padding: 18px 22px;
        margin-bottom: 20px;
    }

        .filter-card .form-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #94a3b8;
            margin-bottom: 6px;
        }

        .filter-card .form-control,
        .filter-card .form-select {
            border-radius: 0;
            border-color: rgba(255,255,255,.2);
            font-size: 14px;
            height: 40px;
        }

            .filter-card .form-control:focus,
            .filter-card .form-select:focus {
                border-color: #E50914;
                box-shadow: 0 0 0 3px rgba(229,9,20,.12);
            }

    .data-card {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 0;
        overflow: hidden;
    }

        .data-card .card-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 22px;
            border-bottom: 1px solid rgba(255,255,255,.06);
        }

            .data-card .card-head .title {
                font-size: 14px;
                font-weight: 700;
                color: #ffffff;
                margin: 0;
            }

            .data-card .card-head .count {
                font-size: 12px;
                color: #94a3b8;
                background: #1c1c1c;
                padding: 4px 12px;
                border-radius: 999px;
                font-weight: 600;
            }

        .data-card table {
            margin: 0;
            font-size: 14px;
        }

        .data-card thead th {
            background: #1c1c1c;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .5px;
            color: #cbd5e1;
            padding: 14px 16px;
            border-bottom: 1px solid rgba(255,255,255,.1);
            white-space: nowrap;
        }

        .data-card tbody td {
            padding: 16px;
            border-bottom: 1px solid rgba(255,255,255,.06);
            vertical-align: middle;
        }

        .data-card tbody tr:last-child td {
            border-bottom: none;
        }

        .data-card tbody tr:hover {
            background: #161616;
        }

    .voucher-code {
        display: inline-block;
        background: rgba(139,92,246,.18);
        color: #c4b5fd;
        font-size: 13px;
        font-weight: 800;
        padding: 5px 12px;
        border-radius: 4px;
        font-family: 'Courier New', monospace;
        letter-spacing: 1px;
    }

    .voucher-name {
        font-weight: 700;
        color: #ffffff;
        font-size: 14px;
        margin-bottom: 4px;
    }

    .voucher-desc {
        font-size: 12px;
        color: #94a3b8;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .voucher-value {
        font-weight: 800;
        color: #E50914;
        font-size: 15px;
    }

        .voucher-value.percent {
            color: #fbbf24;
        }

    .voucher-sub {
        font-size: 11px;
        color: #71717a;
        margin-top: 2px;
    }

    .progress-usage {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .progress-bar-custom {
        flex: 1;
        height: 6px;
        background: rgba(255,255,255,.1);
        border-radius: 999px;
        overflow: hidden;
        min-width: 60px;
    }

    .progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #10b981 0%, #34d399 100%);
        transition: width .3s;
    }

        .progress-bar-fill.warning {
            background: linear-gradient(90deg, #f59e0b 0%, #fbbf24 100%);
        }

        .progress-bar-fill.danger {
            background: linear-gradient(90deg, #dc2626 0%, #ef4444 100%);
        }

    .progress-text {
        font-size: 11px;
        color: #94a3b8;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .status-pill {
        display: inline-block;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .3px;
        text-transform: uppercase;
        white-space: nowrap;
    }

        .status-pill.active {
            background: rgba(34,197,94,.15);
            color: #86efac;
        }

        .status-pill.off {
            background: #1c1c1c;
            color: #94a3b8;
        }

        .status-pill.expired {
            background: rgba(239,68,68,.15);
            color: #fca5a5;
        }

        .status-pill.pending {
            background: rgba(245,158,11,.15);
            color: #fcd34d;
        }

        .status-pill.used-up {
            background: rgba(139,92,246,.15);
            color: #c4b5fd;
        }

    .action-cell {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 6px;
        flex-wrap: nowrap;
    }

    .btn-clean {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 7px 14px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 0;
        border: 1px solid rgba(255,255,255,.2);
        background: #121212;
        color: #cbd5e1;
        text-decoration: none;
        transition: all .15s;
        line-height: 1;
        white-space: nowrap;
        min-height: 34px;
    }

        .btn-clean:hover {
            border-color: rgba(255,255,255,.3);
            background: #1c1c1c;
            color: #ffffff;
        }

        .btn-clean.warn {
            color: #fbbf24;
            border-color: rgba(245,158,11,.4);
        }

            .btn-clean.warn:hover {
                background: rgba(245,158,11,.10);
            }

        .btn-clean.danger {
            color: #fca5a5;
            border-color: rgba(239,68,68,.4);
        }

            .btn-clean.danger:hover {
                background: rgba(239,68,68,.10);
            }

    .empty-state {
        padding: 72px 24px;
        text-align: center;
        color: #71717a;
    }

        .empty-state .big {
            font-size: 42px;
            font-weight: 700;
            color: #3f3f46;
            letter-spacing: 4px;
        }

        .empty-state .msg {
            font-size: 15px;
            margin-top: 8px;
        }

    .pager {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 22px;
        background: #1c1c1c;
        border-top: 1px solid rgba(255,255,255,.1);
        font-size: 13px;
        color: #94a3b8;
    }

        .pager .pagination {
            margin: 0;
        }

        .pager .page-link {
            border-radius: 0;
            margin: 0 2px;
            border-color: rgba(255,255,255,.1);
            color: #cbd5e1;
            font-size: 13px;
            font-weight: 600;
            padding: 6px 12px;
        }

        .pager .page-item.active .page-link {
            background: #b80710;
            border-color: #E50914;
        }
</style>

<div class="page-shell">
    <div class="page-wrap">

        <!-- HEADER -->
        <div class="page-head">
            <div>
                <h1>Mã giảm giá</h1>
                <p class="sub">Quản lý voucher khuyến mãi của hệ thống</p>
            </div>
            <div class="head-actions">
                <a asp-action="Create" class="btn-create">
                    + Tạo mã mới
                </a>
            </div>
        </div>

        <!-- THÔNG BÁO -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                <strong>Thành công.</strong> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show">
                <strong>Lỗi.</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- STATS -->
        <div class="stat-strip">
            <div class="stat-card green">
                <div class="lbl">Đang hoạt động</div>
                <div class="val">@Model.TongDangHoatDong</div>
            </div>
            <div class="stat-card red">
                <div class="lbl">Đã hết hạn</div>
                <div class="val">@Model.TongDaHetHan</div>
            </div>
            <div class="stat-card amber">
                <div class="lbl">Sắp hết lượt (≥80%)</div>
                <div class="val">@Model.TongSapHetLuot</div>
            </div>
        </div>

        <!-- FILTER -->
        <div class="filter-card">
            <form method="get" asp-action="Index">
                <div class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Từ khóa</label>
                        <input type="text" name="tuKhoa" value="@Model.TuKhoa"
                               class="form-control" placeholder="Mã, tên chương trình, mô tả..." />
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Loại giảm</label>
                        <select name="loaiGiamGia" class="form-select">
                            <option value="">Tất cả</option>
                            @foreach (var loai in LoaiGiamGia.TatCa)
                            {
                                <option value="@loai" selected="@(Model.LoaiGiamGia == loai)">
                                    @LoaiGiamGia.GetDisplayName(loai)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Trạng thái</label>
                        <select name="trangThaiLoc" class="form-select">
                            <option value="">Tất cả</option>
                            <option value="active" selected="@(Model.TrangThaiLoc == "active")">Đang chạy</option>
                            <option value="pending" selected="@(Model.TrangThaiLoc == "pending")">Chưa hiệu lực</option>
                            <option value="expired" selected="@(Model.TrangThaiLoc == "expired")">Hết hạn</option>
                            <option value="sap_het" selected="@(Model.TrangThaiLoc == "sap_het")">Sắp hết lượt</option>
                            <option value="inactive" selected="@(Model.TrangThaiLoc == "inactive")">Đã tắt</option>
                        </select>
                    </div>

                    <div class="col-md-2">
                        <label class="form-label">Hiển thị</label>
                        <select name="kichThuocTrang" class="form-select">
                            <option value="10" selected="@(Model.KichThuocTrang == 10)">10 / trang</option>
                            <option value="20" selected="@(Model.KichThuocTrang == 20)">20 / trang</option>
                            <option value="50" selected="@(Model.KichThuocTrang == 50)">50 / trang</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
                        <button type="submit" class="btn btn-primary">Áp dụng</button>
                    </div>
                </div>
            </form>
        </div>

        <!-- DATA -->
        <div class="data-card">
            <div class="card-head">
                <h6 class="title">Danh sách mã giảm giá</h6>
                <span class="count">@Model.DanhSach.Count / @Model.TongSoBanGhi mã</span>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th style="width:56px">STT</th>
                            <th>Mã &amp; Chương trình</th>
                            <th>Giá trị giảm</th>
                            <th>Điều kiện</th>
                            <th>Hiệu lực</th>
                            <th>Lượt dùng</th>
                            <th>Trạng thái</th>
                            <th class="text-end" style="width:260px">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSach.Any())
                        {
                            foreach (var item in Model.DanhSach)
                            {
                                stt++;
                                var statusClass = GetStatusClass(item);
                                var statusText = GetStatusText(item);
                                var percentUsed = item.SoLuotDungToiDa > 0
                                    ? (int)Math.Round((double)item.SoLuotDaDung / item.SoLuotDungToiDa * 100)
                                    : 0;
                                var progressClass = percentUsed >= 90 ? "danger"
                                    : percentUsed >= 70 ? "warning" : "";

                                <tr>
                                    <td class="text-muted">@stt</td>

                                    <td>
                                        <span class="voucher-code">@item.Code</span>
                                        <div class="voucher-name mt-2">@item.TenChuongTrinh</div>
                                        @if (!string.IsNullOrEmpty(item.MoTa))
                                        {
                                            <div class="voucher-desc">@item.MoTa</div>
                                        }
                                    </td>

                                    <td>
                                        @if (item.LoaiGiamGia == LoaiGiamGia.PhanTram)
                                        {
                                            <div class="voucher-value percent">
                                                Giảm @item.GiaTriGiam.ToString("N0")%
                                            </div>
                                            @if (item.GiamToiDa.HasValue)
                                            {
                                                <div class="voucher-sub">Tối đa @item.GiamToiDa.Value.ToString("N0")đ</div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="voucher-value">
                                                Giảm @item.GiaTriGiam.ToString("N0")đ
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        @if (item.DonHangToiThieu > 0)
                                        {
                                            <div class="voucher-sub">
                                                Đơn tối thiểu: <strong>@item.DonHangToiThieu.ToString("N0")đ</strong>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="voucher-sub">Không giới hạn đơn</div>
                                        }
                                        @if (item.MoiKhachMotLan)
                                        {
                                            <div class="voucher-sub">🔒 Mỗi khách 1 lần</div>
                                        }
                                    </td>

                                    <td>
                                        <div class="voucher-sub">Từ: @item.NgayBatDau.ToString("dd/MM/yyyy")</div>
                                        <div class="voucher-sub">Đến: @item.NgayKetThuc.ToString("dd/MM/yyyy")</div>
                                    </td>

                                    <td>
                                        <div class="progress-usage">
                                            <div class="progress-bar-custom">
                                                <div class="progress-bar-fill @progressClass"
                                                     style="width: @(percentUsed)%"></div>
                                            </div>
                                            <span class="progress-text">
                                                @item.SoLuotDaDung / @item.SoLuotDungToiDa
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="status-pill @statusClass">@statusText</span>
                                    </td>

                                    <td>
                                        <div class="action-cell">
                                            <a asp-action="Details" asp-route-id="@item.MaGiamGiaId"
                                               class="btn-clean">Xem</a>
                                            <a asp-action="Edit" asp-route-id="@item.MaGiamGiaId"
                                               class="btn-clean warn">Sửa</a>
                                            <form asp-action="DoiTrangThai" asp-route-id="@item.MaGiamGiaId"
                                                  method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn-clean @(item.TrangThai ? "danger" : "")"
                                                        onclick="return confirm('@(item.TrangThai ? "Vô hiệu hóa" : "Kích hoạt") mã này?')">
                                                    @(item.TrangThai ? "Tắt" : "Bật")
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="empty-state">
                                        <div class="big">— — —</div>
                                        <div class="msg">Chưa có mã giảm giá nào</div>
                                        <a asp-action="Create" class="btn btn-primary mt-3">
                                            Tạo mã giảm giá đầu tiên
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (Model.TongSoTrang > 1)
            {
                <div class="pager">
                    <div>
                        Trang <strong>@Model.Trang</strong> / @Model.TongSoTrang —
                        hiển thị <strong>@Model.DanhSach.Count</strong> trong
                        <strong>@Model.TongSoBanGhi</strong> mã
                    </div>

                    <nav>
                        <ul class="pagination pagination-sm">
                            <li class="page-item @(Model.CoTrangTruoc ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-trang="@(Model.Trang - 1)"
                                   asp-route-tuKhoa="@Model.TuKhoa"
                                   asp-route-loaiGiamGia="@Model.LoaiGiamGia"
                                   asp-route-trangThaiLoc="@Model.TrangThaiLoc"
                                   asp-route-kichThuocTrang="@Model.KichThuocTrang">Trước</a>
                            </li>

                            @{
                                var batDau = Math.Max(1, Model.Trang - 2);
                                var ketThuc = Math.Min(Model.TongSoTrang, Model.Trang + 2);
                            }

                            @for (int i = batDau; i <= ketThuc; i++)
                            {
                                <li class="page-item @(i == Model.Trang ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-trang="@i"
                                       asp-route-tuKhoa="@Model.TuKhoa"
                                       asp-route-loaiGiamGia="@Model.LoaiGiamGia"
                                       asp-route-trangThaiLoc="@Model.TrangThaiLoc"
                                       asp-route-kichThuocTrang="@Model.KichThuocTrang">@i</a>
                                </li>
                            }

                            <li class="page-item @(Model.CoTrangSau ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-trang="@(Model.Trang + 1)"
                                   asp-route-tuKhoa="@Model.TuKhoa"
                                   asp-route-loaiGiamGia="@Model.LoaiGiamGia"
                                   asp-route-trangThaiLoc="@Model.TrangThaiLoc"
                                   asp-route-kichThuocTrang="@Model.KichThuocTrang">Sau</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>