@* ==============================================================
   Bắt Đầu Code của SV4: Nguyễn Hoàng Đức Hiếu
   file: Views/BaoDuong/Index.cshtml
   nội dung: STT 11 - Dashboard & Quản lý Theo dõi Bảo dưỡng xe nâng cao (Tabs: Đang bảo dưỡng, Cảnh báo định kỳ theo KM, Lịch sử toàn bộ)
   sinh viên thực hiện: Nguyễn Hoàng Đức Hiếu - 23103100116 - SV4
   ============================================================== *@
@model IEnumerable<QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Entities.LichSuBaoDuong>

@{
    ViewData["Title"] = "Quản lý & Theo dõi Bảo dưỡng xe";
    var tab = ViewBag.TabHienTai as string ?? "dangbaoduong";
    var xeCanBaoDuong = ViewBag.DanhSachXeCanBaoDuong as IEnumerable<dynamic>;
}

<div class="container-fluid py-4 px-md-4">
    <!-- HEADER & ACTION -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="fw-bold text-dark mb-1">
                <i class="bi bi-tools text-primary"></i> Quản lý & Theo dõi Bảo dưỡng xe
            </h3>
            <p class="text-muted small mb-0">Theo dõi quy trình bảo dưỡng, cảnh báo km định kỳ và nghiệm thu đưa xe vào kinh doanh.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="TaoMoi" class="btn btn-primary px-3 py-2 fw-semibold">
                <i class="bi bi-plus-circle"></i> + Lập phiếu bảo dưỡng mới
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- THỐNG KÊ DASHBOARD -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 h-100 bg-white border-start border-4 border-warning">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Đang trong xưởng</div>
                        <div class="fs-3 fw-bold text-warning">@ViewBag.TongDangBaoDuong</div>
                        <div class="text-muted" style="font-size: 11px;">Phương tiện đang tạm khóa</div>
                    </div>
                    <div class="bg-warning-subtle text-warning p-3 rounded-circle fs-4">
                        <i class="bi bi-wrench-adjustable"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 h-100 bg-white border-start border-4 border-danger">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Cảnh báo đến hạn</div>
                        <div class="fs-3 fw-bold text-danger">@ViewBag.TongXeCanBaoDuong</div>
                        <div class="text-muted" style="font-size: 11px;">Cán mốc chu kỳ 5.000 km</div>
                    </div>
                    <div class="bg-danger-subtle text-danger p-3 rounded-circle fs-4">
                        <i class="bi bi-speedometer2"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 h-100 bg-white border-start border-4 border-success">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Đã hoàn thành</div>
                        <div class="fs-3 fw-bold text-success">@ViewBag.TongHoanThanh</div>
                        <div class="text-muted" style="font-size: 11px;">Lượt bảo dưỡng nghiệm thu</div>
                    </div>
                    <div class="bg-success-subtle text-success p-3 rounded-circle fs-4">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-6 col-lg-3">
            <div class="card border-0 shadow-sm p-3 h-100 bg-white border-start border-4 border-info">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-semibold text-uppercase">Tổng chi phí</div>
                        <div class="fs-4 fw-bold text-info">@(((decimal)ViewBag.TongChiPhiBaoDuong).ToString("N0")) đ</div>
                        <div class="text-muted" style="font-size: 11px;">Chi phí bảo dưỡng thực tế</div>
                    </div>
                    <div class="bg-info-subtle text-info p-3 rounded-circle fs-4">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TABS ĐIỀU HƯỚNG -->
    <ul class="nav nav-pills mb-4 bg-white p-2 rounded shadow-sm border" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold @(tab == "dangbaoduong" ? "active" : "")"
                    id="pills-dang-tab" data-bs-toggle="pill" data-bs-target="#pills-dang" type="button" role="tab">
                <i class="bi bi-clock-history"></i> Xe đang bảo dưỡng (@ViewBag.TongDangBaoDuong)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold @(tab == "canhbao" ? "active" : "")"
                    id="pills-canhbao-tab" data-bs-toggle="pill" data-bs-target="#pills-canhbao" type="button" role="tab">
                <i class="bi bi-exclamation-triangle-fill text-warning"></i> Cảnh báo đến hạn KM (@ViewBag.TongXeCanBaoDuong)
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-semibold @(tab == "lichsu" ? "active" : "")"
                    id="pills-lichsu-tab" data-bs-toggle="pill" data-bs-target="#pills-lichsu" type="button" role="tab">
                <i class="bi bi-journal-text"></i> Toàn bộ lịch sử bảo dưỡng
            </button>
        </li>
    </ul>

    <!-- NỘI DUNG TABS -->
    <div class="tab-content" id="pills-tabContent">
        <!-- TAB 1: XE ĐANG BẢO DƯỠNG -->
        <div class="tab-pane fade @(tab == "dangbaoduong" ? "show active" : "")" id="pills-dang" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Phương tiện</th>
                                    <th>Loại bảo dưỡng</th>
                                    <th>Ngày bắt đầu</th>
                                    <th>Số KM</th>
                                    <th>Gara / Xưởng</th>
                                    <th>Hạng mục sửa chữa</th>
                                    <th>Người phụ trách</th>
                                    <th class="text-end">Hành động</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    var dangBaoDuongList = Model.Where(m => m.TrangThai == QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants.TrangThaiBaoDuong.DangBaoDuong).ToList();
                                }
                                @if (dangBaoDuongList.Any())
                                {
                                    @foreach (var item in dangBaoDuongList)
                                    {
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-primary">@item.Xe?.TenXe</div>
                                                <span class="badge bg-dark font-monospace">@item.Xe?.BienSo</span>
                                            </td>
                                            <td>
                                                <span class="badge bg-warning text-dark">@item.LoaiBaoDuong</span>
                                            </td>
                                            <td>
                                                <div class="small fw-semibold">@item.NgayBatDau.ToString("dd/MM/yyyy")</div>
                                                <div class="text-muted small">@item.NgayBatDau.ToString("HH:mm")</div>
                                            </td>
                                            <td>@item.SoKmKhiBaoDuong.ToString("N0") km</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.GaraBaoDuong) ? "Gara liên kết" : item.GaraBaoDuong)</td>
                                            <td>
                                                <div class="small text-truncate" style="max-width: 250px;" title="@item.NoiDungBaoDuong">
                                                    @item.NoiDungBaoDuong
                                                </div>
                                            </td>
                                            <td>@(item.NguoiPhuTrach ?? "-")</td>
                                            <td class="text-end">
                                                <a asp-action="HoanThanh" asp-route-id="@item.MaBaoDuong"
                                                   class="btn btn-sm btn-success fw-semibold">
                                                    <i class="bi bi-check-lg"></i> Nghiệm thu hoàn tất
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center py-4 text-muted">
                                            <i class="bi bi-shield-check text-success fs-1 d-block mb-2"></i>
                                            Hiện tại không có phương tiện nào đang trong xưởng bảo dưỡng. Tất cả xe đều sẵn sàng!
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 2: CẢNH BÁO XE SẮP ĐẾN HẠN BẢO DƯỠNG ĐỊNH KỲ -->
        <div class="tab-pane fade @(tab == "canhbao" ? "show active" : "")" id="pills-canhbao" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <div class="alert alert-info border-0 mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        Hệ thống tự động theo dõi số KM hiện tại của từng phương tiện. Cứ mỗi chu kỳ <strong>5.000 KM</strong> (thay dầu nhớt, kiểm tra má phanh, lốp xe), hệ thống sẽ cảnh báo khi xe chạy được trên <strong>4.000 KM</strong> của chu kỳ đó.
                    </div>

                    <div class="row g-3">
                        @if (xeCanBaoDuong != null && xeCanBaoDuong.Any())
                        {
                            @foreach (var x in xeCanBaoDuong)
                            {
                                <div class="col-md-6 col-lg-4">
                                    <div class="border rounded-3 p-3 bg-white h-100 shadow-sm @(x.DangBaoDuong ? "border-warning" : "border-danger")">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 class="fw-bold text-dark mb-0">@x.Xe.TenXe</h6>
                                                <span class="badge bg-dark font-monospace mt-1">@x.Xe.BienSo</span>
                                            </div>
                                            @if (x.DangBaoDuong)
                                            {
                                                <span class="badge bg-warning text-dark">Đang bảo dưỡng</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">Cần bảo dưỡng</span>
                                            }
                                        </div>

                                        <div class="small text-muted my-2">
                                            <div>Loại xe: <strong>@x.Xe.LoaiXe?.TenLoaiXe</strong> | Năm SX: <strong>@x.Xe.NamSanXuat</strong></div>
                                            <div>Số KM hiện tại: <strong class="text-primary fs-6">@(((decimal)x.KmHienTai).ToString("N0")) km</strong></div>
                                            <div>Mốc định kỳ tiếp theo: <strong>@(((int)x.KmMocTiepTheo).ToString("N0")) km</strong> (còn @(((decimal)x.KmConLai).ToString("N0")) km)</div>
                                        </div>

                                        <div class="mt-3">
                                            <div class="d-flex justify-content-between small text-muted mb-1">
                                                <span>Tiến độ chu kỳ 5.000km:</span>
                                                <span class="fw-bold">@(((decimal)x.PhanTramChuKy).ToString("F0"))%</span>
                                            </div>
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar @(x.PhanTramChuKy >= 90 ? "bg-danger" : "bg-warning")"
                                                     role="progressbar" style="width: @(x.PhanTramChuKy)%"></div>
                                            </div>
                                        </div>

                                        <div class="mt-3 text-end">
                                            @if (!x.DangBaoDuong)
                                            {
                                                <a asp-action="TaoMoi" asp-route-maXe="@x.Xe.MaXe" class="btn btn-sm btn-outline-danger fw-semibold">
                                                    <i class="bi bi-wrench"></i> Đưa vào bảo dưỡng
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted small fst-italic">Đang xử lý trong xưởng</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-12 text-center py-4 text-muted">
                                <i class="bi bi-check-circle-fill text-success fs-1 d-block mb-2"></i>
                                Tất cả phương tiện đều đang ở trong ngưỡng vận hành an toàn!
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- TAB 3: TOÀN BỘ LỊCH SỬ BẢO DƯỠNG -->
        <div class="tab-pane fade @(tab == "lichsu" ? "show active" : "")" id="pills-lichsu" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-3 mb-4">
                <div class="card-body p-3">
                    <form method="get" class="row g-2">
                        <input type="hidden" name="tab" value="lichsu" />
                        <div class="col-md-4">
                            <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control"
                                   placeholder="Tìm biển số, tên xe, gara, nội dung..." />
                        </div>
                        <div class="col-md-3">
                            <select name="trangThai" asp-items="ViewBag.DanhSachTrangThai" class="form-select">
                                <option value="">-- Tất cả trạng thái --</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select name="loaiBaoDuong" asp-items="ViewBag.DanhSachLoai" class="form-select">
                                <option value="">-- Tất cả loại bảo dưỡng --</option>
                            </select>
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button type="submit" class="btn btn-primary w-100 fw-semibold">Lọc</button>
                            <a asp-action="Index" asp-route-tab="lichsu" class="btn btn-outline-secondary">Xóa</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã</th>
                                    <th>Phương tiện</th>
                                    <th>Loại bảo dưỡng</th>
                                    <th>Thời gian</th>
                                    <th>Số KM</th>
                                    <th>Chi phí (VNĐ)</th>
                                    <th>Gara / Xưởng</th>
                                    <th>Trạng thái</th>
                                    <th class="text-end">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Any())
                                {
                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="fw-bold">#BD-@item.MaBaoDuong</td>
                                            <td>
                                                <div class="fw-bold text-primary">@item.Xe?.TenXe</div>
                                                <span class="badge bg-dark font-monospace">@item.Xe?.BienSo</span>
                                            </td>
                                            <td><span class="badge bg-light text-dark border">@item.LoaiBaoDuong</span></td>
                                            <td>
                                                <div class="small">Từ: @item.NgayBatDau.ToString("dd/MM/yyyy")</div>
                                                @if (item.NgayHoanThanh.HasValue)
                                                {
                                                    <div class="small text-success">Đến: @item.NgayHoanThanh.Value.ToString("dd/MM/yyyy")</div>
                                                }
                                            </td>
                                            <td>@item.SoKmKhiBaoDuong.ToString("N0") km</td>
                                            <td class="fw-bold text-danger">@item.ChiPhi.ToString("N0") đ</td>
                                            <td>@(item.GaraBaoDuong ?? "-")</td>
                                            <td>
                                                @if (item.TrangThai == QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants.TrangThaiBaoDuong.DangBaoDuong)
                                                {
                                                    <span class="badge bg-warning text-dark">Đang bảo dưỡng</span>
                                                }
                                                else if (item.TrangThai == QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants.TrangThaiBaoDuong.DaHoanThanh)
                                                {
                                                    <span class="badge bg-success">Đã hoàn thành</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@item.TrangThai</span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                @if (item.TrangThai == QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants.TrangThaiBaoDuong.DangBaoDuong)
                                                {
                                                    <a asp-action="HoanThanh" asp-route-id="@item.MaBaoDuong"
                                                       class="btn btn-sm btn-success">
                                                        Nghiệm thu
                                                    </a>
                                                }
                                                <form asp-action="Xoa" asp-route-id="@item.MaBaoDuong" method="post" class="d-inline"
                                                      onsubmit="return confirm('Bạn có chắc muốn xóa bản ghi bảo dưỡng này?');">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center py-4 text-muted">
                                            Không tìm thấy dữ liệu bảo dưỡng nào phù hợp.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@* ==============================================================
   Kết thúc Code của SV4
   ============================================================== *@
