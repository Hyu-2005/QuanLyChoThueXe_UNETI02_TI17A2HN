@model QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Entities.LoaiXe

@{
    ViewData["Title"] = "Chi tiet loai xe";
}

<h2>Chi tiet loai xe</h2>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Ma loai xe</dt>
            <dd class="col-sm-9">@Model.MaLoaiXe</dd>

            <dt class="col-sm-3">Ten loai xe</dt>
            <dd class="col-sm-9">@Model.TenLoaiXe</dd>

            <dt class="col-sm-3">So cho</dt>
            <dd class="col-sm-9">@Model.SoCho</dd>

            <dt class="col-sm-3">Mo ta</dt>
            <dd class="col-sm-9">@(Model.MoTa ?? "-")</dd>

            <dt class="col-sm-3">Trang thai</dt>
            <dd class="col-sm-9">
                @if (Model.TrangThai)
                {
                    <span class="badge bg-success">Hoat dong</span>
                }
                else
                {
                    <span class="badge bg-secondary">Ngung</span>
                }
            </dd>
        </dl>

        <h4 class="mt-4">Danh sach xe thuoc loai nay (@Model.Xes.Count xe)</h4>
        @if (Model.Xes.Any())
        {
            <table class="table table-sm table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>Bien so</th>
                        <th>Ten xe</th>
                        <th>Tinh trang</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var xe in Model.Xes)
                    {
                        <tr>
                            <td>@xe.BienSo</td>
                            <td>@xe.TenXe</td>
                            <td>@xe.TinhTrang</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">Chua co xe nao thuoc loai nay</p>
        }
    </div>
</div>

<a asp-action="Edit" asp-route-id="@Model.MaLoaiXe" class="btn btn-warning">Sua</a>
<a asp-action="Index" class="btn btn-secondary">Quay lai</a>