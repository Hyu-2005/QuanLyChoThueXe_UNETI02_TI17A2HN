                                                    <svg width="16" height="16" viewBox="0 0 24 24"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                                                        <polyline points="14 2 14 8 20 8" />
                                                        <line x1="9" y1="15" x2="15" y2="15" />
                                                    </svg>
                                                </span>
                                                Kiểm tra giấy tờ
                                            </a>
                                        </li>
                                        @* ==============================================================
                                           Kết thúc Code của SV3
                                           ============================================================== *@
                                    </ul>
                                </li>

                                <!-- THỐNG KÊ -->
                                <li class="nav-item">
                                    <a class="nav-link @ActiveClass("ThongKe")"
                                       asp-controller="ThongKe" asp-action="Index">
                                        Thống kê
                                    </a>
                                </li>
                            }

                            @if (laKhachHang)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @ActiveClass("Home")"
                                       asp-controller="Home" asp-action="Index">
                                        Trang chủ
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @ActiveClass("Xe")"
                                       asp-controller="Xe" asp-action="Index">
                                        Xem xe
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @ActiveClass("DatXe", "TimXeTrong")"
                                       asp-controller="DatXe" asp-action="TimXeTrong">
                                        Tìm xe trống
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @ActiveClass("DatXe", "DonCuaToi")"
                                       asp-controller="DatXe" asp-action="DonCuaToi">
                                        Đơn của tôi
                                    </a>
                                </li>
                                @* ==============================================================
                                   Bắt Đầu Code của SV3: Vũ Tiến Đạt
                                   file: Views/Shared/_Layout.cshtml
                                   nội dung: Thêm menu "Giấy tờ của tôi" cho khách hàng (tải và theo dõi trạng thái giấy tờ CCCD, GPLX).
                                   sinh viên thực hiện: Vũ Tiến Đạt - 23103100119 - SV3
                                   ============================================================== *@
                                <li class="nav-item">
                                    <a class="nav-link @ActiveClass("GiayTo")"
                                       asp-controller="GiayTo" asp-action="CuaToi">
                                        Giấy tờ của tôi
                                    </a>
                                </li>
                                @* ==============================================================
                                   Kết thúc Code của SV3
                                   ============================================================== *@
                            }
                        </ul>

                        <!-- RIGHT SIDE -->
                        <ul class="nav-menu" style="flex: 0 0 auto;">
                            @if (daDangNhap)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle user-trigger"
                                       data-bs-toggle="dropdown" href="#" role="button">
                                        <span class="user-avatar">@chuCaiDau</span>
                                        <span class="user-text">
                                            <div class="name">@hoTen</div>
                                            <div class="role">@vaiTroText</div>
                                        </span>
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li class="dropdown-header">@hoTen</li>
                                        <li>
                                            <a class="dropdown-item"
                                               asp-controller="TaiKhoan" asp-action="DoiMatKhau">
                                                <span class="icon">
                                                    <svg width="16" height="16" viewBox="0 0 24 24"
                                                         fill="none" stroke="currentColor" stroke-width="2">
                                                        <rect x="3" y="11" width="18" height="11" rx="2" />
                                                        <path d="M7 11V7a5 5 0 0110 0v4" />
                                                    </svg>
                                                </span>
                                                Đổi mật khẩu
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form asp-controller="TaiKhoan" asp-action="DangXuat"
                                                  method="post" class="m-0">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="dropdown-item text-danger w-100 text-start border-0 bg-transparent">
                                                    <span class="icon">
                                                        <svg width="16" height="16" viewBox="0 0 24 24"
                                                             fill="none" stroke="currentColor" stroke-width="2">
                                                            <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4" />
                                                            <polyline points="16 17 21 12 16 7" />
                                                            <line x1="21" y1="12" x2="9" y2="12" />
                                                        </svg>
                                                    </span>
                                                    Đăng xuất
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                @* ==============================================================
                                   Bắt Đầu Code của SV3: Vũ Tiến Đạt
                                   file: Views/Shared/_Layout.cshtml
                                   nội dung: Thêm link "Đăng ký" khi chưa đăng nhập để khách hàng tự tạo tài khoản.
                                   sinh viên thực hiện: Vũ Tiến Đạt - 23103100119 - SV3
                                   ============================================================== *@
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="DangKy" asp-action="Index">
                                        Đăng ký
                                    </a>
                                </li>
                                @* ==============================================================
                                   Kết thúc Code của SV3
                                   ============================================================== *@
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="TaiKhoan" asp-action="DangNhap"
                                       style="background: rgba(59,130,246,.18); color: #fff;">
                                        Đăng nhập
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    @if (hideChrome)
    {
        <div class="app-main">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <div class="app-main">
            <div class="app-content">
                <div class="container-fluid">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <strong>Thành công.</strong> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Lỗi.</strong> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <main role="main">
                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>

        <footer class="app-footer">
            <div class="footer-inner">
                <div>
                    <span class="brand">© 2026 Quản Lý Cho Thuê Xe</span>
                    <span class="divider">·</span>
                    <span>UNETI02</span>
                    <span class="divider">·</span>
                    <span>Lớp TI17A2HN</span>
                </div>
                <div class="footer-links">
                    <a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a>
                    <a href="#">Hỗ trợ</a>
                    <a href="#">Liên hệ</a>
                </div>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
       <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>