@*
    ==============================================================
    _Layout.cshtml - Khung giao diện chung theo mẫu VIRELLO
    Họ và tên: Vũ Tiến Đạt - MSSV: 23103100119 - SV3
    Nội dung: Header kính mờ + menu theo vai trò (Admin/Nhân viên/Khách hàng),
              footer, font Oswald + Inter, hiệu ứng reveal/parallax.
    Lưu ý: giữ nguyên toàn bộ liên kết menu của các module (kể cả phần SV4: Bảo dưỡng xe).
    Mặc định MỌI trang đều dùng nền tối VIRELLO. Trang nào cần giữ nền sáng (ví dụ biên bản in) thì đặt ViewData["Dark"] = false.
    Các tuỳ chọn khác:
        ViewData["Dark"] = true;        // nền đen
        ViewData["FullWidth"] = true;   // tràn màn hình, không bọc container
    ==============================================================
*@
@using Microsoft.AspNetCore.Http
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Helpers
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants
@inject IHttpContextAccessor HttpContextAccessor

@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var daDangNhap = session?.DaDangNhap() ?? false;
    var hoTen = session?.GetString(SessionKeys.HoTen) ?? "";
    var vaiTro = session?.GetVaiTro() ?? "";
    var laQuanTri = session?.LaQuanTri() ?? false;
    var laKhachHang = session?.LaKhachHang() ?? false;

    var vaiTroText = vaiTro switch
    {
        "Admin" => "Quản trị viên",
        "NhanVien" => "Nhân viên",
        "KhachHang" => "Khách hàng",
        _ => vaiTro
    };
    var chuCaiDau = !string.IsNullOrEmpty(hoTen) ? hoTen[0].ToString().ToUpper() : "?";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Tên thương hiệu hiện ở logo và footer (đổi ở đây nếu muốn)
    var thuongHieu = "VIRELLO";

    // Ẩn navbar/footer (trang đăng nhập)
    var hideChrome = ViewData["HideChrome"] as bool? ?? false;
    // Trang dùng nền tối kiểu VIRELLO / tràn màn hình
    var trangToi = ViewData["Dark"] as bool? ?? true;
    var toanManHinh = ViewData["FullWidth"] as bool? ?? false;

    // Tính sẵn các giá trị rồi mới đưa vào thuộc tính (tránh lỗi "malformed tag helper")
    var bodyClass = "vr-body " + (trangToi ? "vr-dark" : "vr-light") + (hideChrome ? " chrome-hidden" : "");
    var bsTheme = trangToi ? "dark" : "light";

    var currentTrangThai = HttpContextAccessor.HttpContext?.Request.Query["trangThai"].ToString() ?? "";

    string ActiveClass(string controller, string? action = null, string? expectedTrangThai = null)
    {
        if (currentController != controller) return "";
        if (action != null && currentAction != action) return "";

        if (expectedTrangThai != null)
            return currentTrangThai == expectedTrangThai ? "active" : "";

        if (controller == "DatXe" && action == "Index" && !string.IsNullOrEmpty(currentTrangThai))
            return "";

        return "active";
    }

    // Danh sách liên kết cho menu mobile (phẳng, theo vai trò)
    var mobile = new List<(string Nhan, string Ctl, string Act, string? TrangThai)>();
    mobile.Add(("Trang chủ", "Home", "Index", null));
    if (laQuanTri)
    {
        mobile.Add(("Loại xe", "LoaiXe", "Index", null));
        mobile.Add(("Hãng xe", "HangXe", "Index", null));
        mobile.Add(("Xe", "Xe", "Index", null));
        mobile.Add(("Bảng giá thuê", "BangGiaThue", "Index", null));
        mobile.Add(("Đơn đặt xe", "DatXe", "Index", null));
        mobile.Add(("Bàn giao xe", "DatXe", "Index", TrangThaiDatXe.DaDuyet));
        mobile.Add(("Trả xe", "DatXe", "Index", TrangThaiDatXe.DangThue));
        mobile.Add(("Bảo dưỡng xe", "BaoDuong", "Index", null));
        mobile.Add(("Thanh toán", "ThanhToan", "Index", null));
        mobile.Add(("Danh sách khách hàng", "KhachHang", "Index", null));
        mobile.Add(("Kiểm tra giấy tờ", "GiayTo", "Index", null));
        mobile.Add(("Thống kê", "ThongKe", "Index", null));
    }
    else if (laKhachHang)
    {
        mobile.Add(("Xem xe", "Xe", "Index", null));
        mobile.Add(("Tìm xe trống", "DatXe", "TimXeTrong", null));
        mobile.Add(("Đơn của tôi", "DatXe", "DonCuaToi", null));
        mobile.Add(("Giấy tờ của tôi", "GiayTo", "CuaToi", null));
    }
    else
    {
        mobile.Add(("Đăng ký", "DangKy", "Index", null));
        mobile.Add(("Đăng nhập", "TaiKhoan", "DangNhap", null));
    }
}

<!DOCTYPE html>
<html lang="vi" data-bs-theme="@bsTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Cho Thuê Xe</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@@300;400;500;600;700&family=Oswald:wght@@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/virello.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/virello-skin.css" asp-append-version="true" />
</head>
<body class="@bodyClass">

    @if (!hideChrome)
    {
        <!-- ============================================================ -->
        <!-- HEADER (kính mờ)                                             -->
        <!-- ============================================================ -->
        <header class="vr-header">
            <div class="vr-header-inner">

                <!-- Logo -->
                <a class="vr-logo" asp-controller="Home" asp-action="Index">
                    <svg viewBox="0 0 100 100" aria-hidden="true">
                        <path d="M10 15 L45 85 L55 85 L90 15 L70 15 L50 60 L30 15 Z" />
                        <path class="vr-logo-inner" d="M35 15 L50 48 L65 15 Z" />
                    </svg>
                    <span class="vr-logo-text">@thuongHieu</span>
                </a>

                <!-- Menu desktop -->
                <nav class="vr-nav" aria-label="Menu chính">
                    <a class="@ActiveClass("Home")" asp-controller="Home" asp-action="Index">Trang chủ</a>

                    @if (laQuanTri)
                    {
                        <!-- QUẢN LÝ DANH MỤC -->
                        <div class="vr-dd @ActiveClass("LoaiXe")@ActiveClass("HangXe")@ActiveClass("Xe")@ActiveClass("BangGiaThue")">
                            <button type="button" class="vr-dd-btn">Danh mục <i class="fa-solid fa-chevron-down"></i></button>
                            <div class="vr-dd-menu">
                                <div class="vr-dd-head">Danh mục xe</div>
                                <a class="@ActiveClass("LoaiXe")" asp-controller="LoaiXe" asp-action="Index">Loại xe</a>
                                <a class="@ActiveClass("HangXe")" asp-controller="HangXe" asp-action="Index">Hãng xe</a>
                                <a class="@ActiveClass("Xe")" asp-controller="Xe" asp-action="Index">Xe</a>
                                <a class="@ActiveClass("BangGiaThue")" asp-controller="BangGiaThue" asp-action="Index">Bảng giá thuê</a>
                            </div>
                        </div>

                        <!-- NGHIỆP VỤ -->
                        <div class="vr-dd @ActiveClass("DatXe")@ActiveClass("BaoDuong")@ActiveClass("ThanhToan")">
                            <button type="button" class="vr-dd-btn">Nghiệp vụ <i class="fa-solid fa-chevron-down"></i></button>
                            <div class="vr-dd-menu">
                                <div class="vr-dd-head">Xử lý đơn</div>
                                <a class="@ActiveClass("DatXe", "Index")" asp-controller="DatXe" asp-action="Index">Đơn đặt xe</a>
                                <a class="@ActiveClass("DatXe", "Index", TrangThaiDatXe.DaDuyet)"
                                   asp-controller="DatXe" asp-action="Index"
                                   asp-route-trangThai="@TrangThaiDatXe.DaDuyet">Bàn giao xe</a>
                                <a class="@ActiveClass("DatXe", "Index", TrangThaiDatXe.DangThue)"
                                   asp-controller="DatXe" asp-action="Index"
                                   asp-route-trangThai="@TrangThaiDatXe.DangThue">Trả xe</a>
                                @* ==============================================================
                                   Bắt Đầu Code của SV4: Nguyễn Hoàng Đức Hiếu
                                   file: Views/Shared/_Layout.cshtml
                                   nội dung: STT 11 - Thêm menu "Bảo dưỡng xe" vào menu Nghiệp vụ/Vận hành cho Admin/Nhân viên
                                   sinh viên thực hiện: Nguyễn Hoàng Đức Hiếu - 23103100116 - SV4
                                   ============================================================== *@
                                <a class="@ActiveClass("BaoDuong")" asp-controller="BaoDuong" asp-action="Index">Bảo dưỡng xe</a>
                                @* ==============================================================
                                   Kết thúc Code của SV4
                                   ============================================================== *@
                                <div class="vr-dd-sep"></div>
                                <div class="vr-dd-head">Tài chính</div>
                                <a class="@ActiveClass("ThanhToan")" asp-controller="ThanhToan" asp-action="Index">Thanh toán</a>
                            </div>
                        </div>

                        <!-- KHÁCH HÀNG -->
                        <div class="vr-dd @ActiveClass("KhachHang")@ActiveClass("GiayTo")">
                            <button type="button" class="vr-dd-btn">Khách hàng <i class="fa-solid fa-chevron-down"></i></button>
                            <div class="vr-dd-menu">
                                <a class="@ActiveClass("KhachHang")" asp-controller="KhachHang" asp-action="Index">Danh sách khách hàng</a>
                                @* ==============================================================
                                   Bắt Đầu Code của SV3: Vũ Tiến Đạt
                                   file: Views/Shared/_Layout.cshtml
                                   nội dung: Menu "Kiểm tra giấy tờ" cho Admin/Nhân viên (xác minh hoặc từ chối giấy tờ khách hàng tải lên).
                                   sinh viên thực hiện: Vũ Tiến Đạt - 23103100119 - SV3
                                   ============================================================== *@
                                <a class="@ActiveClass("GiayTo")" asp-controller="GiayTo" asp-action="Index">Kiểm tra giấy tờ</a>
                                @* ==============================================================
                                   Kết thúc Code của SV3
                                   ============================================================== *@
                            </div>
                        </div>

                        <a class="@ActiveClass("ThongKe")" asp-controller="ThongKe" asp-action="Index">Thống kê</a>
                    }
                    else if (laKhachHang)
                    {
                        <a class="@ActiveClass("Xe")" asp-controller="Xe" asp-action="Index">Xem xe</a>
                        <a class="@ActiveClass("DatXe", "TimXeTrong")" asp-controller="DatXe" asp-action="TimXeTrong">Tìm xe trống</a>
                        <a class="@ActiveClass("DatXe", "DonCuaToi")" asp-controller="DatXe" asp-action="DonCuaToi">Đơn của tôi</a>
                        @* ==============================================================
                           Bắt Đầu Code của SV3: Vũ Tiến Đạt
                           file: Views/Shared/_Layout.cshtml
                           nội dung: Menu "Giấy tờ của tôi" cho khách hàng (tải và theo dõi trạng thái giấy tờ CCCD, GPLX).
                           sinh viên thực hiện: Vũ Tiến Đạt - 23103100119 - SV3
                           ============================================================== *@
                        <a class="@ActiveClass("GiayTo")" asp-controller="GiayTo" asp-action="CuaToi">Giấy tờ của tôi</a>
                        @* ==============================================================
                           Kết thúc Code của SV3
                           ============================================================== *@
                    }
                    else
                    {
                        @* ==============================================================
                           Bắt Đầu Code của SV3: Vũ Tiến Đạt
                           file: Views/Shared/_Layout.cshtml
                           nội dung: Link "Đăng ký" khi chưa đăng nhập để khách hàng tự tạo tài khoản.
                           sinh viên thực hiện: Vũ Tiến Đạt - 23103100119 - SV3
                           ============================================================== *@
                        <a class="@ActiveClass("DangKy")" asp-controller="DangKy" asp-action="Index">Đăng ký</a>
                        @* ==============================================================
                           Kết thúc Code của SV3
                           ============================================================== *@
                    }
                </nav>

                <!-- Hành động bên phải -->
                <div class="vr-actions">
                    @if (laKhachHang)
                    {
                        <a class="vr-btn-outline" asp-controller="DatXe" asp-action="TimXeTrong">Đặt xe ngay</a>
                    }
                    else if (!daDangNhap)
                    {
                        <a class="vr-btn-outline" asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a>
                    }

                    @if (daDangNhap)
                    {
                        <div class="vr-dd">
                            <div class="vr-user" tabindex="0">
                                <span class="vr-avatar">@chuCaiDau</span>
                                <span class="vr-user-text">
                                    <span class="vr-user-name d-block">@hoTen</span>
                                    <span class="vr-user-role d-block">@vaiTroText</span>
                                </span>
                            </div>
                            <div class="vr-dd-menu right">
                                <div class="vr-dd-head">@hoTen</div>
                                <a asp-controller="TaiKhoan" asp-action="DoiMatKhau">Đổi mật khẩu</a>
                                <div class="vr-dd-sep"></div>
                                <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post" class="m-0">
                                    <button type="submit" class="vr-dd-link">Đăng xuất</button>
                                </form>
                            </div>
                        </div>
                    }

                    <button type="button" id="vrMobileBtn" class="vr-burger" aria-label="Mở menu" aria-expanded="false">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
            </div>

            <!-- Menu mobile -->
            <div id="vrMobileMenu" class="vr-mobile">
                @foreach (var m in mobile)
                {
                    <a class="@ActiveClass(m.Ctl, m.Act, m.TrangThai)"
                       href="@Url.Action(m.Act, m.Ctl, m.TrangThai == null ? null : new { trangThai = m.TrangThai })">@m.Nhan</a>
                }
            </div>
        </header>
    }

    @if (hideChrome)
    {
        <div class="vr-main">
            <main role="main">
                @RenderBody()
            </main>
        </div>
    }
    else if (toanManHinh)
    {
        <div class="vr-main">
            @if (TempData["Success"] != null || TempData["Error"] != null)
            {
                <div class="vr-alerts">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <strong>Thành công.</strong> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Lỗi.</strong> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                </div>
            }
            <main role="main">
                @RenderBody()
            </main>
        </div>
    }
    else
    {
        <div class="vr-main">
            <div class="app-content">
                <div class="container-fluid">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show">
                            <strong>Thành công.</strong> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show">
                            <strong>Lỗi.</strong> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <main role="main">
                        @RenderBody()
                    </main>
                </div>
            </div>
        </div>
    }

    @if (!hideChrome)
    {
        <!-- ============================================================ -->
        <!-- FOOTER                                                       -->
        <!-- ============================================================ -->
        <footer class="vr-footer">
            <div class="vr-footer-grid">
                <div>
                    <div class="vr-footer-brand">@thuongHieu</div>
                    <p class="vr-footer-note">
                        Hệ thống quản lý cho thuê xe.<br />
                        Tìm xe trống, đặt xe và theo dõi đơn thuê trực tuyến.
                    </p>
                </div>
                <div>
                    <h5>Liên kết nhanh</h5>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                        @if (laKhachHang)
                        {
                            <li><a asp-controller="Xe" asp-action="Index">Xem xe</a></li>
                            <li><a asp-controller="DatXe" asp-action="TimXeTrong">Tìm xe trống</a></li>
                            <li><a asp-controller="DatXe" asp-action="DonCuaToi">Đơn của tôi</a></li>
                        }
                        else if (laQuanTri)
                        {
                            <li><a asp-controller="DatXe" asp-action="Index">Đơn đặt xe</a></li>
                            <li><a asp-controller="Xe" asp-action="Index">Quản lý xe</a></li>
                            <li><a asp-controller="ThongKe" asp-action="Index">Thống kê</a></li>
                        }
                        else
                        {
                            <li><a asp-controller="TaiKhoan" asp-action="DangNhap">Đăng nhập</a></li>
                            <li><a asp-controller="DangKy" asp-action="Index">Đăng ký</a></li>
                        }
                    </ul>
                </div>
                <div>
                    <h5>Hỗ trợ</h5>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Privacy">Chính sách bảo mật</a></li>
                        @if (laKhachHang)
                        {
                            <li><a asp-controller="GiayTo" asp-action="CuaToi">Giấy tờ của tôi</a></li>
                        }
                    </ul>
                </div>
                <div>
                    <h5>Dự án</h5>
                    <ul>
                        <li><i class="fa-solid fa-diagram-project"></i> Đề tài 20</li>
                        <li><i class="fa-solid fa-users"></i> Nhóm UNETI02</li>
                        <li><i class="fa-solid fa-graduation-cap"></i> Lớp TI17A2HN</li>
                    </ul>
                </div>
            </div>
            <div class="vr-footer-bottom">
                © 2026 @thuongHieu · QUẢN LÝ CHO THUÊ XE · UNETI02 · TI17A2HN
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/virello.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
