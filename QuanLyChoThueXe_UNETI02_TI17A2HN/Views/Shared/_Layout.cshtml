@using Microsoft.AspNetCore.Http
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Helpers
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants
@inject IHttpContextAccessor HttpContextAccessor

@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var daDangNhap = session?.DaDangNhap() ?? false;
    var hoTen = session?.GetString(SessionKeys.HoTen) ?? "";
    var vaiTro = session?.GetVaiTro() ?? "";
    var laQuanTri = session?.LaQuanTri() ?? false;
    var laKhachHang = session?.LaKhachHang() ?? false;

    var vaiTroText = vaiTro switch
    {
        "Admin" => "Quản trị viên",
        "NhanVien" => "Nhân viên",
        "KhachHang" => "Khách hàng",
        _ => vaiTro
    };
    var chuCaiDau = !string.IsNullOrEmpty(hoTen) ? hoTen[0].ToString().ToUpper() : "?";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string ActiveClass(string controller, string? action = null)
    {
        if (currentController != controller) return "";
        if (action == null) return "active";
        return currentAction == action ? "active" : "";
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Cho Thuê Xe</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        html, body { height: 100%; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: #f5f7fa;
            color: #0f172a;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* NAVBAR */
        .app-navbar {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            box-shadow: 0 2px 8px rgba(15,23,42,.08);
            padding: 10px 0;
        }
        .app-navbar .navbar-brand {
            font-weight: 800;
            font-size: 18px;
            letter-spacing: -0.3px;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .app-navbar .navbar-brand .logo {
            width: 34px; height: 34px;
            background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
            border-radius: 9px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 16px;
            font-weight: 800;
            box-shadow: 0 4px 10px rgba(59,130,246,.35);
        }
        .app-navbar .nav-link {
            color: rgba(255,255,255,.78);
            font-size: 14px;
            font-weight: 500;
            padding: 8px 14px !important;
            border-radius: 8px;
            transition: all .15s;
            margin: 0 2px;
        }
        .app-navbar .nav-link:hover {
            color: #fff;
            background: rgba(255,255,255,.08);
        }
        .app-navbar .nav-link.active {
            color: #fff;
            background: rgba(59,130,246,.22);
            font-weight: 600;
        }
        .app-navbar .dropdown-menu {
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            box-shadow: 0 8px 24px rgba(15,23,42,.12);
            padding: 6px;
            margin-top: 8px;
            min-width: 220px;
        }
        .app-navbar .dropdown-item {
            font-size: 14px;
            padding: 8px 14px;
            border-radius: 7px;
            color: #334155;
            transition: all .12s;
        }
        .app-navbar .dropdown-item:hover {
            background: #eff6ff;
            color: #1d4ed8;
        }
        .app-navbar .dropdown-item.active {
            background: #eff6ff;
            color: #1d4ed8;
            font-weight: 600;
        }

        /* USER BADGE */
        .user-trigger {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 12px 6px 6px !important;
            border-radius: 999px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.1);
        }
        .user-trigger:hover { background: rgba(255,255,255,.14); }
        .user-avatar {
            width: 30px; height: 30px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 700;
            font-size: 13px;
            flex-shrink: 0;
        }
        .user-text { line-height: 1.15; }
        .user-text .name {
            font-size: 13px;
            font-weight: 700;
            color: #fff;
        }
        .user-text .role {
            font-size: 11px;
            color: rgba(255,255,255,.6);
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        /* MAIN */
        .app-main {
            flex: 1;
            padding: 0;
        }

        /* FOOTER */
        .app-footer {
            background: #fff;
            border-top: 1px solid #e5e7eb;
            padding: 20px 0;
            margin-top: 40px;
            font-size: 13px;
            color: #64748b;
            text-align: center;
        }
        .app-footer .brand {
            font-weight: 700;
            color: #1e293b;
        }

        /* ALERTS */
        .alert {
            border-radius: 10px;
            border: none;
            font-size: 14px;
            padding: 12px 16px;
            box-shadow: 0 1px 3px rgba(15,23,42,.05);
        }
        .alert-success { background: #f0fdf4; color: #166534; border-left: 4px solid #10b981; }
        .alert-danger  { background: #fef2f2; color: #991b1b; border-left: 4px solid #ef4444; }
        .alert-warning { background: #fffbeb; color: #92400e; border-left: 4px solid #f59e0b; }
        .alert-info    { background: #eff6ff; color: #1e40af; border-left: 4px solid #3b82f6; }

        /* Nếu trang con dùng layout riêng thì ẩn padding */
        .login-fullscreen .app-main { padding: 0 !important; }
    </style>
</head>
<body>

    <header>
        <nav class="navbar navbar-expand-lg app-navbar">
            <div class="container-fluid px-4">

                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <span class="logo">Q</span>
                    <span>Quản Lý Cho Thuê Xe</span>
                </a>

                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbarMain" aria-controls="navbarMain"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMain">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4">

                        @if (laQuanTri)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @ActiveClass("LoaiXe")"
                                   data-bs-toggle="dropdown" href="#" role="button">
                                    Quản lý danh mục
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item @ActiveClass("LoaiXe")"
                                           asp-controller="LoaiXe" asp-action="Index">
                                            Loại xe
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @ActiveClass("HangXe")"
                                           asp-controller="HangXe" asp-action="Index">
                                            Hãng xe
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @ActiveClass("Xe")"
                                           asp-controller="Xe" asp-action="Index">
                                            Xe
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @ActiveClass("BangGiaThue")"
                                           asp-controller="BangGiaThue" asp-action="Index">
                                            Bảng giá thuê
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle @ActiveClass("DatXe")"
                                   data-bs-toggle="dropdown" href="#" role="button">
                                    Nghiệp vụ
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item @ActiveClass("KhachHang")"
                                           asp-controller="KhachHang" asp-action="Index">
                                            Khách hàng
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @ActiveClass("DatXe")"
                                           asp-controller="DatXe" asp-action="Index">
                                            Đơn đặt xe
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @ActiveClass("BanGiaoXe")"
                                           asp-controller="BanGiaoXe" asp-action="Index">
                                            Bàn giao xe
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @ActiveClass("TraXe")"
                                           asp-controller="TraXe" asp-action="Index">
                                            Trả xe
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item @ActiveClass("ThanhToan")"
                                           asp-controller="ThanhToan" asp-action="Index">
                                            Thanh toán
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("ThongKe")"
                                   asp-controller="ThongKe" asp-action="Index">
                                    Thống kê
                                </a>
                            </li>
                        }

                        @if (laKhachHang)
                        {
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("Home")"
                                   asp-controller="Home" asp-action="Index">
                                    Trang chủ
                                </a>
                            </li>
                            <li class="nav-item">
    <a class="nav-link @ActiveClass("Xe")"
       asp-controller="Xe" asp-action="Index">
        Xem xe
    </a>
</li>
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("DatXe", "TimXeTrong")"
                                   asp-controller="DatXe" asp-action="TimXeTrong">
                                    Tìm xe trống
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @ActiveClass("DatXe", "DonCuaToi")"
                                   asp-controller="DatXe" asp-action="DonCuaToi">
                                    Đơn của tôi
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav mb-2 mb-lg-0">
                        @if (daDangNhap)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle user-trigger" data-bs-toggle="dropdown"
                                   href="#" role="button">
                                    <span class="user-avatar">@chuCaiDau</span>
                                    <span class="user-text text-start">
                                        <div class="name">@hoTen</div>
                                        <div class="role">@vaiTroText</div>
                                    </span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="TaiKhoan" asp-action="DoiMatKhau">
                                            Đổi mật khẩu
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form asp-controller="TaiKhoan" asp-action="DangXuat"
                                              method="post" class="m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="dropdown-item text-danger fw-semibold w-100 text-start border-0 bg-transparent">
                                                Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="TaiKhoan" asp-action="DangNhap">
                                    Đăng nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="app-main">
        <div class="container-fluid px-4 mt-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <strong>Thành công.</strong> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <strong>Lỗi.</strong> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <main role="main">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="app-footer">
        <div class="container-fluid px-4">
            <span class="brand">&copy; 2026 Quản Lý Cho Thuê Xe</span>
            &nbsp;·&nbsp; UNETI02 &nbsp;·&nbsp; Lớp TI17A2HN
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>