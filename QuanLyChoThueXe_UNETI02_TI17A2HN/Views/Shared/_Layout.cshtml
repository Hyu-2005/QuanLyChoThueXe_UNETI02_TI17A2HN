@using Microsoft.AspNetCore.Http
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Helpers
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants
@inject IHttpContextAccessor HttpContextAccessor

@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var daDangNhap = session?.DaDangNhap() ?? false;
    var hoTen = session?.GetString(SessionKeys.HoTen) ?? "";
    var vaiTro = session?.GetVaiTro() ?? "";
    var laQuanTri = session?.LaQuanTri() ?? false;
    var laKhachHang = session?.LaKhachHang() ?? false;

    var vaiTroText = vaiTro switch
    {
        "Admin" => "Quản trị viên",
        "NhanVien" => "Nhân viên",
        "KhachHang" => "Khách hàng",
        _ => vaiTro
    };
    var chuCaiDau = !string.IsNullOrEmpty(hoTen) ? hoTen[0].ToString().ToUpper() : "?";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // Ẩn navbar/footer
    var hideChrome = ViewData["HideChrome"] as bool? ?? false;

    // ✅ TÍNH CLASS RA BIẾN TRƯỚC — tránh lỗi "malformed body tag helper"
    var bodyClass = hideChrome ? "chrome-hidden" : "";

    var currentTrangThai = HttpContextAccessor.HttpContext?.Request.Query["trangThai"].ToString() ?? "";

    string ActiveClass(string controller, string? action = null, string? expectedTrangThai = null)
    {
        if (currentController != controller) return "";
        if (action != null && currentAction != action) return "";

        if (expectedTrangThai != null)
            return currentTrangThai == expectedTrangThai ? "active" : "";

        if (controller == "DatXe" && action == "Index" && !string.IsNullOrEmpty(currentTrangThai))
            return "";

        return "active";
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Cho Thuê Xe</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <style>
        /* ============================================================
           RESET & BASE
           ============================================================ */
        *, *::before, *::after { box-sizing: border-box; }

        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
                         "Helvetica Neue", Arial, sans-serif;
            font-size: 14px;
            line-height: 1.5;
            background: #f5f7fa;
            color: #0f172a;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* ============================================================
           KHI ẨN CHROME (trang đăng nhập/đăng ký)
           ============================================================ */
        body.chrome-hidden { background: #fff; }
        body.chrome-hidden .app-main {
            flex: 1;
            padding: 0 !important;
            margin: 0 !important;
            min-height: 100vh;
        }

        /* ============================================================
           NAVBAR
           ============================================================ */
        .app-navbar {
            background: linear-gradient(135deg, #0b1220 0%, #0f172a 50%, #1e293b 100%);
            box-shadow:
                0 1px 0 rgba(255,255,255,.05) inset,
                0 4px 16px rgba(15,23,42,.15);
            padding: 0;
            border-bottom: 1px solid rgba(148,163,184,.08);
            position: sticky;
            top: 0;
            z-index: 1030;
            backdrop-filter: blur(10px);
        }

        .app-navbar .navbar-inner {
            display: flex;
            align-items: center;
            gap: 24px;
            padding: 12px 28px;
            max-width: 100%;
        }

        /* Logo */
        .app-navbar .navbar-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            font-weight: 800;
            font-size: 17px;
            letter-spacing: -0.4px;
            color: #fff;
            text-decoration: none;
            white-space: nowrap;
            transition: opacity .15s;
            margin: 0;
            padding: 0;
        }
        .app-navbar .navbar-brand:hover {
            opacity: .9;
            color: #fff;
        }
        .app-navbar .navbar-brand .logo {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 17px;
            font-weight: 800;
            box-shadow:
                0 6px 14px rgba(37,99,235,.4),
                0 0 0 1px rgba(255,255,255,.1) inset;
            flex-shrink: 0;
        }
        .app-navbar .navbar-brand .brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
        }
        .app-navbar .navbar-brand .brand-text .brand-name {
            font-size: 15px;
            font-weight: 800;
            color: #fff;
            letter-spacing: -0.3px;
        }
        .app-navbar .navbar-brand .brand-text .brand-sub {
            font-size: 10.5px;
            font-weight: 500;
            color: rgba(255,255,255,.5);
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-top: 1px;
        }

        /* Nav links */
        .app-navbar .nav-menu {
            display: flex;
            align-items: center;
            gap: 4px;
            list-style: none;
            margin: 0;
            padding: 0;
            flex: 1;
        }
        .app-navbar .nav-menu .nav-item {
            position: relative;
        }
        .app-navbar .nav-link {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            color: rgba(255,255,255,.72);
            font-size: 13.5px;
            font-weight: 500;
            padding: 9px 14px !important;
            border-radius: 8px;
            transition: all .15s ease;
            text-decoration: none;
            white-space: nowrap;
            line-height: 1.2;
        }
        .app-navbar .nav-link:hover {
            color: #fff;
            background: rgba(255,255,255,.06);
        }
        .app-navbar .nav-link.active {
            color: #fff;
            background: rgba(59,130,246,.18);
            font-weight: 600;
            box-shadow: 0 0 0 1px rgba(59,130,246,.3) inset;
        }
        .app-navbar .nav-link .caret {
            width: 10px;
            height: 10px;
            opacity: .6;
            transition: transform .2s;
        }
        .app-navbar .nav-item.show .nav-link .caret,
        .app-navbar .dropdown-toggle.show .caret {
            transform: rotate(180deg);
        }

        /* Dropdown */
        .app-navbar .dropdown-menu {
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            box-shadow:
                0 12px 32px rgba(15,23,42,.12),
                0 4px 8px rgba(15,23,42,.06);
            padding: 6px;
            margin-top: 10px;
            min-width: 240px;
            animation: dropdownFade .15s ease;
        }
        @@keyframes dropdownFade {
            from { opacity: 0; transform: translateY(-4px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .app-navbar .dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13.5px;
            font-weight: 500;
            padding: 9px 12px;
            border-radius: 8px;
            color: #334155;
            transition: all .12s;
            text-decoration: none;
        }
        .app-navbar .dropdown-item:hover {
            background: #eff6ff;
            color: #1d4ed8;
        }
        .app-navbar .dropdown-item.active {
            background: #eff6ff;
            color: #1d4ed8;
            font-weight: 600;
        }
        .app-navbar .dropdown-item .icon {
            width: 18px;
            height: 18px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            opacity: .75;
            flex-shrink: 0;
        }
        .app-navbar .dropdown-header {
            font-size: 10.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: #94a3b8;
            padding: 8px 12px 4px;
        }

        /* User trigger */
        .app-navbar .user-trigger {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 6px 14px 6px 6px !important;
            border-radius: 999px;
            background: rgba(255,255,255,.06);
            border: 1px solid rgba(255,255,255,.1);
            transition: all .15s;
            margin-left: auto;
        }
        .app-navbar .user-trigger:hover {
            background: rgba(255,255,255,.12);
            border-color: rgba(255,255,255,.18);
        }
        .app-navbar .user-trigger.active {
            background: rgba(255,255,255,.12);
        }
        .app-navbar .user-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #3b82f6 0%, #60a5fa 100%);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-weight: 700;
            font-size: 13px;
            flex-shrink: 0;
            box-shadow: 0 0 0 2px rgba(59,130,246,.2);
        }
        .app-navbar .user-text {
            line-height: 1.2;
            text-align: left;
        }
        .app-navbar .user-text .name {
            font-size: 13px;
            font-weight: 700;
            color: #fff;
            letter-spacing: -0.2px;
        }
        .app-navbar .user-text .role {
            font-size: 10.5px;
            color: rgba(255,255,255,.55);
            text-transform: uppercase;
            letter-spacing: 0.6px;
            font-weight: 600;
            margin-top: 1px;
        }

        /* Toggle (mobile) */
        .app-navbar .navbar-toggler {
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.1);
            padding: 8px 10px;
            border-radius: 8px;
        }
        .app-navbar .navbar-toggler-icon {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 30 30'%3e%3cpath stroke='rgba(255,255,255,0.7)' stroke-linecap='round' stroke-miterlimit='10' stroke-width='2' d='M4 7h22M4 15h22M4 23h22'/%3e%3c/svg%3e");
        }

        /* Mobile collapse */
        .app-navbar .navbar-collapse {
            flex-basis: 100%;
            flex-grow: 1;
        }

        /* ============================================================
           MAIN CONTENT
           ============================================================ */
        .app-main {
            flex: 1;
            padding: 0;
        }
        .app-content {
            padding: 0;
        }
        .app-content .container-fluid {
            padding: 24px 28px 0;
        }

        /* ============================================================
           FOOTER
           ============================================================ */
        .app-footer {
            background: #fff;
            border-top: 1px solid #e5e7eb;
            padding: 24px 0;
            margin-top: 48px;
            font-size: 13px;
            color: #64748b;
        }
        .app-footer .footer-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            padding: 0 28px;
        }
        .app-footer .brand {
            font-weight: 700;
            color: #0f172a;
        }
        .app-footer .divider {
            color: #cbd5e1;
            margin: 0 8px;
        }
        .app-footer .footer-links {
            display: flex;
            gap: 20px;
            align-items: center;
        }
        .app-footer .footer-links a {
            color: #64748b;
            text-decoration: none;
            font-size: 13px;
            transition: color .15s;
        }
        .app-footer .footer-links a:hover {
            color: #2563eb;
        }

        /* ============================================================
           ALERTS (dùng chung)
           ============================================================ */
        .alert {
            border-radius: 12px;
            border: none;
            font-size: 14px;
            font-weight: 500;
            padding: 14px 18px;
            box-shadow: 0 1px 3px rgba(15,23,42,.05);
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 16px;
        }
        .alert strong:first-child {
            font-weight: 700;
        }
        .alert-success {
            background: #f0fdf4;
            color: #166534;
            border-left: 4px solid #10b981;
        }
        .alert-danger {
            background: #fef2f2;
            color: #991b1b;
            border-left: 4px solid #ef4444;
        }
        .alert-warning {
            background: #fffbeb;
            color: #92400e;
            border-left: 4px solid #f59e0b;
        }
        .alert-info {
            background: #eff6ff;
            color: #1e40af;
            border-left: 4px solid #3b82f6;
        }

        /* ============================================================
           RESPONSIVE
           ============================================================ */
        @@media (max-width: 991.98px) {
            .app-navbar .navbar-inner {
                padding: 10px 16px;
                flex-wrap: wrap;
            }
            .app-navbar .navbar-brand .brand-text .brand-sub {
                display: none;
            }
            .app-navbar .navbar-collapse {
                margin-top: 12px;
                padding: 12px 0 4px;
                border-top: 1px solid rgba(255,255,255,.08);
            }
            .app-navbar .nav-menu {
                flex-direction: column;
                align-items: stretch;
                gap: 2px;
            }
            .app-navbar .nav-link {
                padding: 10px 14px !important;
                justify-content: flex-start;
                width: 100%;
            }
            .app-navbar .dropdown-menu {
                margin-top: 4px;
                box-shadow: 0 4px 12px rgba(0,0,0,.08);
            }
            .app-navbar .user-trigger {
                margin-left: 0;
                margin-top: 8px;
                width: 100%;
                justify-content: flex-start;
            }
            .app-footer .footer-inner {
                flex-direction: column;
                text-align: center;
                padding: 0 16px;
            }
            .app-content .container-fluid {
                padding: 16px 16px 0;
            }
        }
    </style>
</head>
