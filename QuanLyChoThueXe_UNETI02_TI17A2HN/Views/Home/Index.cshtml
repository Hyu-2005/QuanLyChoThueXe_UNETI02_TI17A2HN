@*
    Index.cshtml - Trang chủ (Landing page)
    Nội dung: Landing chuyên nghiệp cho khách chưa đăng nhập
              + Dashboard theo vai trò nếu đã đăng nhập
    Sinh viên thực hiện: [Tên SV phụ trách Home]
*@
@using Microsoft.AspNetCore.Http
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Helpers
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Trang chủ";

    var session = HttpContextAccessor.HttpContext?.Session;
    var daDangNhap = session?.DaDangNhap() ?? false;
    var hoTen = session?.GetString(SessionKeys.HoTen) ?? "";
    var vaiTro = session?.GetVaiTro() ?? "";
    var laQuanTri = vaiTro == VaiTro.Admin || vaiTro == VaiTro.NhanVien;
    var laKhachHang = vaiTro == VaiTro.KhachHang;
}

@if (!daDangNhap)
{
    <!-- ============================================================ -->
    <!-- LANDING PAGE - KHÁCH CHƯA ĐĂNG NHẬP                          -->
    <!-- ============================================================ -->
    <div class="lp-shell">

        <!-- Background decorations -->
        <div class="lp-bg lp-bg-1"></div>
        <div class="lp-bg lp-bg-2"></div>
        <div class="lp-bg lp-bg-3"></div>

        <!-- ================= HERO SECTION ================= -->
        <section class="lp-hero">
            <div class="lp-hero-grid">

                <!-- LEFT -->
                <div class="lp-left">
                    <div class="lp-badge">
                        <span class="lp-badge-dot"></span>
                        Nền tảng thuê xe hàng đầu
                    </div>

                    <h1 class="lp-title">
                        Hệ thống quản lý<br />
                        <span class="lp-title-gradient">cho thuê xe</span>
                    </h1>

                    <p class="lp-lead">
                        Giải pháp toàn diện giúp bạn tìm kiếm, đặt thuê và quản lý xe
                        một cách dễ dàng, nhanh chóng và minh bạch.
                    </p>

                    <div class="lp-meta-row">
                        <div class="lp-meta-item">
                            <div class="lp-meta-value">20</div>
                            <div class="lp-meta-label">Đề tài</div>
                        </div>
                        <div class="lp-meta-divider"></div>
                        <div class="lp-meta-item">
                            <div class="lp-meta-value">UNETI02</div>
                            <div class="lp-meta-label">Nhóm</div>
                        </div>
                        <div class="lp-meta-divider"></div>
                        <div class="lp-meta-item">
                            <div class="lp-meta-value">TI17A2HN</div>
                            <div class="lp-meta-label">Lớp</div>
                        </div>
                    </div>

                    <div class="lp-actions">
                        <a asp-controller="TaiKhoan" asp-action="DangNhap"
                           class="lp-btn lp-btn-primary">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4" />
                                <polyline points="10 17 15 12 10 7" />
                                <line x1="15" y1="12" x2="3" y2="12" />
                            </svg>
                            Đăng nhập ngay
                        </a>

                        <a asp-controller="Xe" asp-action="Index"
                           class="lp-btn lp-btn-ghost">
                            Khám phá xe
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <line x1="5" y1="12" x2="19" y2="12" />
                                <polyline points="12 5 19 12 12 19" />
                            </svg>
                        </a>
                    </div>
                </div>

                <!-- RIGHT - HERO IMAGE -->
                <div class="lp-right">
                    <div class="lp-image-wrapper">
                        <div class="lp-image-glow"></div>
                        <div class="lp-image-frame">
                            <img src="https://images.unsplash.com/photo-1621007947382-bb3c3994e3fb?w=1600&q=80"
                                 alt="Xe cho thuê" />
                            <div class="lp-image-overlay"></div>
                        </div>

                        <!-- Floating cards -->
                        <div class="lp-float lp-float-1">
                            <div class="lp-float-icon" style="background: #dbeafe; color: #2563eb;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2.4"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12" />
                                </svg>
                            </div>
                            <div>
                                <div class="lp-float-label">Đặt xe nhanh</div>
                                <div class="lp-float-sub">Chỉ 2 phút</div>
                            </div>
                        </div>

                        <div class="lp-float lp-float-2">
                            <div class="lp-float-icon" style="background: #dcfce7; color: #16a34a;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                                     stroke="currentColor" stroke-width="2.4"
                                     stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z" />
                                </svg>
                            </div>
                            <div>
                                <div class="lp-float-label">An toàn</div>
                                <div class="lp-float-sub">100% bảo hiểm</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- ================= FEATURES ================= -->
        <section class="lp-features-section">
            <div class="lp-features-header">
                <span class="lp-section-label">TÍNH NĂNG NỔI BẬT</span>
                <h2 class="lp-section-title">Mọi thứ bạn cần trong một hệ thống</h2>
            </div>

            <div class="lp-features-grid">
                <div class="lp-feature-card">
                    <div class="lp-feature-icon" style="background: linear-gradient(135deg,#dbeafe,#bfdbfe); color:#2563eb;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 17h14M5 17v-4l2-5h10l2 5v4M5 17v3h2v-3m10 0v3h2v-3" />
                            <circle cx="7.5" cy="14.5" r="1" />
                            <circle cx="16.5" cy="14.5" r="1" />
                        </svg>
                    </div>
                    <h3>Quản lý xe thông minh</h3>
                    <p>Theo dõi toàn bộ đội xe, tình trạng bảo dưỡng và lịch sử khai thác trong một giao diện.</p>
                </div>

                <div class="lp-feature-card">
                    <div class="lp-feature-icon" style="background: linear-gradient(135deg,#dcfce7,#bbf7d0); color:#16a34a;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <rect x="6" y="3" width="12" height="18" rx="2" />
                            <path d="M9 7h6M9 11h6M9 15h4" />
                        </svg>
                    </div>
                    <h3>Đặt xe trực tuyến</h3>
                    <p>Tìm xe trống theo thời gian thực, đặt xe chỉ với vài cú click, không cần chờ đợi.</p>
                </div>

                <div class="lp-feature-card">
                    <div class="lp-feature-icon" style="background: linear-gradient(135deg,#fef3c7,#fde68a); color:#d97706;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="1" x2="12" y2="23" />
                            <path d="M17 5H9.5a3.5 3.5 0 000 7h5a3.5 3.5 0 010 7H6" />
                        </svg>
                    </div>
                    <h3>Thanh toán linh hoạt</h3>
                    <p>Hỗ trợ thanh toán tại quầy và trực tuyến qua VNPay, MoMo, ZaloPay, Banking QR.</p>
                </div>

                <div class="lp-feature-card">
                    <div class="lp-feature-icon" style="background: linear-gradient(135deg,#e0e7ff,#c7d2fe); color:#4f46e5;">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 2l8 4v6c0 5-3.5 9-8 10-4.5-1-8-5-8-10V6l8-4z" />
                            <path d="M9 12l2 2 4-4" />
                        </svg>
                    </div>
                    <h3>Minh bạch & an toàn</h3>
                    <p>Xác minh giấy tờ, hợp đồng rõ ràng, bảo mật thông tin khách hàng tuyệt đối.</p>
                </div>
            </div>
        </section>

        <!-- ================= CTA ================= -->
        <section class="lp-cta">
            <div class="lp-cta-inner">
                <div class="lp-cta-content">
                    <h2>Sẵn sàng bắt đầu hành trình?</h2>
                    <p>Đăng ký tài khoản miễn phí và trải nghiệm dịch vụ thuê xe chuyên nghiệp ngay hôm nay.</p>
                </div>
                <div class="lp-cta-actions">
                    <a asp-controller="DangKy" asp-action="Index" class="lp-cta-btn lp-cta-btn-primary">
                        Đăng ký miễn phí
                    </a>
                    <a asp-controller="TaiKhoan" asp-action="DangNhap" class="lp-cta-btn lp-cta-btn-outline">
                        Đăng nhập
                    </a>
                </div>
            </div>
        </section>

    </div>
}
else if (laKhachHang)
{
    <!-- ============================================================ -->
    <!-- TRANG CHỦ KHÁCH HÀNG ĐÃ ĐĂNG NHẬP                            -->
    <!-- ============================================================ -->
    <div class="kh-shell">
        <div class="kh-hero">
            <div class="kh-hero-content">
                <div class="kh-greeting">
                    <span class="kh-wave">👋</span>
                    Xin chào, <strong>@hoTen</strong>!
                </div>
                <h1 class="kh-title">Bạn muốn thuê xe gì hôm nay?</h1>
                <p class="kh-subtitle">
                    Tìm xe trống, đặt xe và theo dõi đơn thuê chỉ trong vài bước.
                </p>
                <div class="kh-hero-actions">
                    <a asp-controller="DatXe" asp-action="TimXeTrong" class="kh-btn kh-btn-primary">
                        Tìm xe trống
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2.4"
                             stroke-linecap="round" stroke-linejoin="round">
                            <line x1="5" y1="12" x2="19" y2="12" />
                            <polyline points="12 5 19 12 12 19" />
                        </svg>
                    </a>
                    <a asp-controller="DatXe" asp-action="DonCuaToi" class="kh-btn kh-btn-ghost">
                        Đơn của tôi
                    </a>
                </div>
            </div>
            <div class="kh-hero-visual">
                <div class="kh-blob"></div>
                <div class="kh-emoji">🚗</div>
            </div>
        </div>

        <div class="kh-features">
            <a asp-controller="Xe" asp-action="Index" class="kh-card">
                <div class="kh-card-icon" style="background:#dbeafe;color:#2563eb;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 17h14M5 17v-4l2-5h10l2 5v4M5 17v3h2v-3m10 0v3h2v-3" />
                    </svg>
                </div>
                <h3>Xem danh sách xe</h3>
                <p>Khám phá các xe đang sẵn sàng với đầy đủ thông tin và giá cả</p>
                <span class="kh-card-link">
                    Xem ngay
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </span>
            </a>

            <a asp-controller="DatXe" asp-action="TimXeTrong" class="kh-card">
                <div class="kh-card-icon" style="background:#dcfce7;color:#16a34a;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8" />
                        <line x1="21" y1="21" x2="16.65" y2="16.65" />
                    </svg>
                </div>
                <h3>Tìm xe trống</h3>
                <p>Chọn thời gian nhận trả, hệ thống tự lọc xe chưa có lịch trùng</p>
                <span class="kh-card-link">
                    Tìm ngay
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </span>
            </a>

            <a asp-controller="DatXe" asp-action="DonCuaToi" class="kh-card">
                <div class="kh-card-icon" style="background:#fef3c7;color:#d97706;">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                    </svg>
                </div>
                <h3>Đơn của tôi</h3>
                <p>Theo dõi trạng thái đơn đặt xe và lịch sử thuê của bạn</p>
                <span class="kh-card-link">
                    Xem đơn
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2.5">
                        <polyline points="9 18 15 12 9 6" />
                    </svg>
                </span>
            </a>
        </div>
    </div>
}
else if (laQuanTri)
{
    <!-- ============================================================ -->
    <!-- TRANG CHỦ ADMIN/NHÂN VIÊN                                    -->
    <!-- ============================================================ -->
    <div class="admin-shell">
        <div class="admin-hero">
            <div>
                <div class="admin-greeting">Xin chào, @hoTen!</div>
                <h1 class="admin-title">Bảng điều khiển hệ thống</h1>
                <p class="admin-subtitle">
                    Quản lý toàn diện hoạt động cho thuê xe của bạn
                </p>
            </div>
            <div class="admin-hero-badge">
                @(vaiTro == VaiTro.Admin ? "QUẢN TRỊ VIÊN" : "NHÂN VIÊN")
            </div>
        </div>

        <div class="admin-grid">
            <a asp-controller="Xe" asp-action="Index" class="admin-card admin-card-blue">
                <div class="admin-card-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 17h14M5 17v-4l2-5h10l2 5v4M5 17v3h2v-3m10 0v3h2v-3" />
                    </svg>
                </div>
                <div class="admin-card-label">Quản lý danh mục</div>
                <div class="admin-card-desc">
                    Loại xe, Hãng xe, Xe, Bảng giá thuê
                </div>
                <div class="admin-card-link">Truy cập →</div>
            </a>

            <a asp-controller="DatXe" asp-action="Index" class="admin-card admin-card-green">
                <div class="admin-card-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                    </svg>
                </div>
                <div class="admin-card-label">Nghiệp vụ</div>
                <div class="admin-card-desc">
                    Đơn đặt xe, Bàn giao, Trả xe, Thanh toán
                </div>
                <div class="admin-card-link">Truy cập →</div>
            </a>

            <a asp-controller="KhachHang" asp-action="Index" class="admin-card admin-card-amber">
                <div class="admin-card-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2" />
                        <circle cx="12" cy="7" r="4" />
                    </svg>
                </div>
                <div class="admin-card-label">Khách hàng</div>
                <div class="admin-card-desc">
                    Thông tin khách hàng và giấy tờ xác minh
                </div>
                <div class="admin-card-link">Truy cập →</div>
            </a>

            <a asp-controller="ThongKe" asp-action="Index" class="admin-card admin-card-purple">
                <div class="admin-card-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2"
                         stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="20" x2="18" y2="10" />
                        <line x1="12" y1="20" x2="12" y2="4" />
                        <line x1="6" y1="20" x2="6" y2="14" />
                    </svg>
                </div>
                <div class="admin-card-label">Thống kê</div>
                <div class="admin-card-desc">
                    Doanh thu, lượt thuê, hiệu suất khai thác
                </div>
                <div class="admin-card-link">Truy cập →</div>
            </a>
        </div>
    </div>
}

<style>
    /* ============================================================
       LANDING PAGE
       ============================================================ */
    .lp-shell {
        position: relative;
        margin: -24px -12px 0;
        padding: 0;
        overflow: hidden;
        background: #fff;
        min-height: calc(100vh - 84px);
    }

    /* Background blobs */
    .lp-bg {
        position: absolute;
        border-radius: 50%;
        pointer-events: none;
        z-index: 0;
        filter: blur(100px);
    }
    .lp-bg-1 {
        top: -180px; left: -180px;
        width: 560px; height: 560px;
        background: radial-gradient(circle, rgba(191,219,254,.55) 0%, transparent 70%);
    }
    .lp-bg-2 {
        top: 30%; right: -200px;
        width: 620px; height: 620px;
        background: radial-gradient(circle, rgba(199,210,254,.4) 0%, transparent 70%);
    }
    .lp-bg-3 {
        bottom: -200px; left: 30%;
        width: 500px; height: 500px;
        background: radial-gradient(circle, rgba(219,234,254,.5) 0%, transparent 70%);
    }

    /* ================= HERO ================= */
    .lp-hero {
        position: relative;
        z-index: 1;
        padding: 96px 48px 80px;
    }
    .lp-hero-grid {
        max-width: 1400px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
        gap: 72px;
        align-items: center;
    }

    /* LEFT */
    .lp-left { max-width: 580px; }

    .lp-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 14px;
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 999px;
        font-size: 12.5px;
        font-weight: 600;
        color: #1e40af;
        margin-bottom: 24px;
        letter-spacing: 0.1px;
    }
    .lp-badge-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,.15);
        animation: badgePulse 2s ease-in-out infinite;
    }
    @@keyframes badgePulse {
        0%, 100% { box-shadow: 0 0 0 3px rgba(37,99,235,.15); }
        50%      { box-shadow: 0 0 0 6px rgba(37,99,235,.05); }
    }

    .lp-title {
        font-size: 60px;
        font-weight: 800;
        line-height: 1.05;
        letter-spacing: -2px;
        color: #0f172a;
        margin: 0 0 24px 0;
    }
    .lp-title-gradient {
        background: linear-gradient(135deg, #2563eb 0%, #3b82f6 50%, #60a5fa 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        display: inline-block;
    }

    .lp-lead {
        font-size: 18px;
        color: #64748b;
        line-height: 1.65;
        margin: 0 0 32px 0;
        max-width: 520px;
    }

    /* Meta stats */
    .lp-meta-row {
        display: flex;
        align-items: center;
        gap: 24px;
        margin-bottom: 36px;
        padding: 20px 0;
        border-top: 1px solid #f1f5f9;
        border-bottom: 1px solid #f1f5f9;
    }
    .lp-meta-item {
        display: flex;
        flex-direction: column;
    }
    .lp-meta-value {
        font-size: 20px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -0.6px;
        line-height: 1;
    }
    .lp-meta-label {
        font-size: 11px;
        font-weight: 600;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-top: 4px;
    }
    .lp-meta-divider {
        width: 1px;
        height: 32px;
        background: #e2e8f0;
    }

    /* Actions */
    .lp-actions {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
    }

    .lp-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        height: 54px;
        padding: 0 30px;
        border-radius: 12px;
        font-size: 15.5px;
        font-weight: 700;
        text-decoration: none;
        transition: all .2s ease;
        letter-spacing: -0.1px;
        white-space: nowrap;
        border: 1.5px solid transparent;
    }

    .lp-btn-primary {
        background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
        color: #fff;
        box-shadow:
            0 10px 24px rgba(37,99,235,.28),
            0 2px 4px rgba(37,99,235,.15);
    }
    .lp-btn-primary:hover {
        color: #fff;
        transform: translateY(-2px);
        box-shadow:
            0 16px 36px rgba(37,99,235,.4),
