@using Microsoft.AspNetCore.Http
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Helpers
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Trang chủ";

    var session = HttpContextAccessor.HttpContext?.Session;
    var daDangNhap = session?.DaDangNhap() ?? false;
    var hoTen = session?.GetString(SessionKeys.HoTen) ?? "";
    var vaiTro = session?.GetVaiTro() ?? "";
    var laQuanTri = vaiTro == VaiTro.Admin || vaiTro == VaiTro.NhanVien;
    var laKhachHang = vaiTro == VaiTro.KhachHang;
}

@if (!daDangNhap)
{
    <!-- ============================================================ -->
    <!-- CHUA DANG NHAP - HERO CHUNG                                  -->
    <!-- ============================================================ -->
    <div class="guest-shell">
        <div class="guest-hero">
            <h1>Hệ thống quản lý cho thuê xe</h1>
            <p>Đề tài 20 - Nhóm UNETI02 - Lớp TI17A2HN</p>
            <p class="sub">Vui lòng đăng nhập để sử dụng hệ thống.</p>
            <a asp-controller="TaiKhoan" asp-action="DangNhap"
               class="btn btn-light btn-lg px-5 fw-bold"
               style="border-radius:10px">
                Đăng nhập
            </a>
        </div>
    </div>
}
else if (laKhachHang)
{
    <!-- ============================================================ -->
    <!-- TRANG CHU KHACH HANG                                         -->
    <!-- ============================================================ -->
    <div class="kh-shell">

        <!-- HERO CHAO MUNG -->
        <div class="kh-hero">
            <div>
                <h1>Xin chào, @hoTen!</h1>
                <p>Bạn muốn thuê xe gì hôm nay? Tìm xe trống và đặt xe chỉ trong vài bước.</p>
            </div>
            <a asp-controller="DatXe" asp-action="TimXeTrong" class="kh-hero-btn">
                Tìm xe trống →
            </a>
        </div>

        <!-- 3 THE TINH NANG -->
        <div class="kh-features">
            <a asp-controller="Xe" asp-action="Index" class="feature-card">
                <div class="feature-icon">1</div>
                <h3>Xem danh sách xe</h3>
                <p>Khám phá các xe đang sẵn sàng cho thuê với đầy đủ thông tin và giá cả</p>
            </a>

            <a asp-controller="DatXe" asp-action="TimXeTrong" class="feature-card">
                <div class="feature-icon">2</div>
                <h3>Tìm xe trống</h3>
                <p>Chọn thời gian nhận trả, hệ thống sẽ hiển thị xe chưa có lịch trùng</p>
            </a>

            <a asp-controller="DatXe" asp-action="DonCuaToi" class="feature-card">
                <div class="feature-icon">3</div>
                <h3>Đơn của tôi</h3>
                <p>Theo dõi trạng thái đơn đặt xe và lịch sử thuê của bạn</p>
            </a>
        </div>

        <!-- CAM KET -->
        <div class="kh-commitment">
            <div class="commit-item">
                <div class="commit-num">100%</div>
                <div class="commit-lbl">Xe đời mới, bảo dưỡng định kỳ</div>
            </div>
            <div class="commit-item">
                <div class="commit-num">24/7</div>
                <div class="commit-lbl">Hỗ trợ khách hàng mọi lúc</div>
            </div>
            <div class="commit-item">
                <div class="commit-num">5 phút</div>
                <div class="commit-lbl">Đặt xe nhanh chóng, đơn giản</div>
            </div>
        </div>
    </div>
}
else if (laQuanTri)
{
    <!-- ============================================================ -->
    <!-- TRANG CHU ADMIN / NHAN VIEN                                  -->
    <!-- ============================================================ -->
    <div class="admin-shell">

        <!-- HERO CHAO MUNG -->
        <div class="admin-hero">
            <div>
                <h1>Xin chào, @hoTen!</h1>
                <p>Bảng điều khiển hệ thống quản lý cho thuê xe</p>
            </div>
            <div class="admin-badge">
                @(vaiTro == VaiTro.Admin ? "Quản trị viên" : "Nhân viên")
            </div>
        </div>

        <!-- 4 THE THONG KE -->
        <div class="admin-stats">
            <div class="stat-card accent-blue">
                <div class="lbl">Quản lý danh mục</div>
                <h3>Loại xe, Hãng xe, Xe, Bảng giá</h3>
                <a asp-controller="Xe" asp-action="Index" class="stat-link">Xem ngay →</a>
            </div>

            <div class="stat-card accent-green">
                <div class="lbl">Nghiệp vụ</div>
                <h3>Đơn đặt xe, Bàn giao, Trả xe, Thanh toán</h3>
                <a asp-controller="DatXe" asp-action="Index" class="stat-link">Xem ngay →</a>
            </div>

            <div class="stat-card accent-amber">
                <div class="lbl">Khách hàng</div>
                <h3>Quản lý thông tin khách hàng thuê xe</h3>
                <a asp-controller="KhachHang" asp-action="Index" class="stat-link">Xem ngay →</a>
            </div>

            <div class="stat-card accent-slate">
                <div class="lbl">Thống kê</div>
                <h3>Doanh thu, lượt thuê, hiệu suất khai thác</h3>
                <a asp-controller="ThongKe" asp-action="Index" class="stat-link">Xem ngay →</a>
            </div>
        </div>

    </div>
}

<style>
    /* ===== GUEST ===== */
    .guest-shell {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 24px;
    }
    .guest-hero {
        text-align: center;
        max-width: 720px;
    }
    .guest-hero h1 {
        font-size: 42px;
        font-weight: 800;
        color: #0f172a;
        letter-spacing: -1px;
        margin: 0 0 12px 0;
    }
    .guest-hero p {
        font-size: 16px;
        color: #64748b;
        margin: 0 0 8px 0;
    }
    .guest-hero .sub {
        font-size: 15px;
        color: #94a3b8;
        margin: 20px 0 24px 0;
    }

    /* ===== KHACH HANG ===== */
    .kh-shell {
        max-width: 1280px;
        margin: 0 auto;
        padding: 8px 0;
    }
    .kh-hero {
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: #fff;
        border-radius: 16px;
        padding: 40px 36px;
        margin-bottom: 32px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        flex-wrap: wrap;
        position: relative;
        overflow: hidden;
    }
    .kh-hero::before {
        content: "";
        position: absolute;
        top: -80px; right: -80px;
        width: 280px; height: 280px;
        background: rgba(255,255,255,.08);
        border-radius: 50%;
    }
    .kh-hero h1 {
        font-size: 32px;
        font-weight: 800;
        letter-spacing: -0.6px;
        margin: 0 0 8px 0;
    }
    .kh-hero p {
        font-size: 15px;
        opacity: .9;
        margin: 0;
        max-width: 520px;
    }
    .kh-hero-btn {
        display: inline-block;
        background: #fff;
        color: #1e40af;
        padding: 14px 32px;
        border-radius: 12px;
        font-size: 15px;
        font-weight: 700;
        text-decoration: none;
        box-shadow: 0 6px 20px rgba(0,0,0,.15);
        transition: all .2s;
        position: relative;
        z-index: 1;
    }
    .kh-hero-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 28px rgba(0,0,0,.22);
        color: #1e40af;
    }

    .kh-features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 32px;
    }
    .feature-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 28px 24px;
        text-decoration: none;
        transition: all .2s;
        display: block;
    }
    .feature-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 28px rgba(15,23,42,.08);
        border-color: #cbd5e1;
    }
    .feature-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);
        color: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: 800;
        margin-bottom: 16px;
        box-shadow: 0 4px 12px rgba(59,130,246,.25);
    }
    .feature-card h3 {
        font-size: 17px;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 8px 0;
        letter-spacing: -0.2px;
    }
    .feature-card p {
        font-size: 13px;
        color: #64748b;
        margin: 0;
        line-height: 1.6;
    }

    .kh-commitment {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 28px 32px;
    }
    .commit-item {
        text-align: center;
    }
    .commit-num {
        font-size: 28px;
        font-weight: 800;
        color: #1d4ed8;
        letter-spacing: -0.8px;
        margin-bottom: 6px;
    }
    .commit-lbl {
        font-size: 13px;
        color: #64748b;
    }

    /* ===== ADMIN ===== */
    .admin-shell {
        max-width: 1280px;
        margin: 0 auto;
        padding: 8px 0;
    }
    .admin-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        color: #fff;
        border-radius: 16px;
        padding: 36px 36px;
        margin-bottom: 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }
    .admin-hero h1 {
        font-size: 30px;
        font-weight: 800;
        letter-spacing: -0.6px;
        margin: 0 0 6px 0;
    }
    .admin-hero p {
        font-size: 14px;
        opacity: .8;
        margin: 0;
    }
    .admin-badge {
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
        padding: 8px 20px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .3px;
    }

    .admin-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }
    .stat-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 28px 28px;
        transition: all .2s;
        border-left: 4px solid #3b82f6;
    }
    .stat-card:hover {
        box-shadow: 0 12px 28px rgba(15,23,42,.08);
        transform: translateY(-2px);
    }
    .stat-card.accent-blue { border-left-color: #3b82f6; }
    .stat-card.accent-green { border-left-color: #10b981; }
    .stat-card.accent-amber { border-left-color: #f59e0b; }
    .stat-card.accent-slate { border-left-color: #64748b; }

    .stat-card .lbl {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #64748b;
        margin-bottom: 10px;
    }
    .stat-card h3 {
        font-size: 17px;
        font-weight: 700;
        color: #0f172a;
        margin: 0 0 16px 0;
        line-height: 1.4;
    }
    .stat-link {
        color: #1d4ed8;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
    }
    .stat-link:hover { text-decoration: underline; }

    @@media (max-width: 768px) {
        .kh-features,
        .kh-commitment,
        .admin-stats { grid-template-columns: 1fr; }
        .kh-hero h1 { font-size: 24px; }
        .guest-hero h1 { font-size: 30px; }
    }
</style>