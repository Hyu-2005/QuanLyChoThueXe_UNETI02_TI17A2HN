@*
    ==============================================================
    Index.cshtml - Trang chủ VIRELLO (Bản hoàn chỉnh)
    - Hiệu ứng Reveal, Bộ sưu tập xe, Khuyến mãi
    - Bản đồ Google Maps có Ghim đỏ (Miễn phí, không cần API Key)
    ==============================================================
*@
@using System.Globalization
@using Microsoft.AspNetCore.Http
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Helpers
@using QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Constants
@model QuanLyChoThueXe_UNETI02_TI17A2HN.ViewModels.Home.HomeIndexVM
@inject IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Trang chủ";
    ViewData["Dark"] = true;
    ViewData["FullWidth"] = true;

    var session = HttpContextAccessor.HttpContext?.Session;
    var daDangNhap = session?.DaDangNhap() ?? false;
    var hoTen = session?.GetString(SessionKeys.HoTen) ?? "";
    var vaiTro = session?.GetVaiTro() ?? "";
    var laQuanTri = vaiTro == VaiTro.Admin || vaiTro == VaiTro.NhanVien;
    var laKhachHang = vaiTro == VaiTro.KhachHang;

    var vi = new CultureInfo("vi-VN");
    var cacLoai = Model.XeNoiBat
        .Select(x => x.TenLoaiXe)
        .Where(t => !string.IsNullOrEmpty(t))
        .Distinct()
        .ToList();

    // LẤY DỮ LIỆU KHUYẾN MÃI TỪ VIEWBAG
    var khuyenMais = ViewBag.KhuyenMai as List<QuanLyChoThueXe_UNETI02_TI17A2HN.Models.Entities.MaGiamGia>;

    var anhNen = "https://images.unsplash.com/photo-1617814076367-b759c7d7e738?q=80&w=2070&auto=format&fit=crop";
    var anhGioiThieu = "https://images.unsplash.com/photo-1563720223185-11003d516935?w=800&auto=format&fit=crop&q=80";
    var ngayNhanMacDinh = DateTime.Now.AddDays(1).ToString("yyyy-MM-ddTHH:00");
    var ngayTraMacDinh = DateTime.Now.AddDays(3).ToString("yyyy-MM-ddTHH:00");
}

<style>
    /* Custom CSS cho Thẻ thông tin cửa hàng */
    .info-card-map {
        background: #121212;
        border: 1px solid rgba(255,255,255,.1);
        border-radius: 16px;
        padding: 32px;
        height: 100%;
        box-shadow: 0 20px 40px rgba(0,0,0,0.6);
        display: flex;
        flex-direction: column;
        position: relative;
        overflow: hidden;
    }
    /* Dải màu đỏ trang trí ở góc thẻ */
    .info-card-map::before {
        content: "";
        position: absolute;
        top: 0; left: 0; width: 100%; height: 4px;
        background: linear-gradient(90deg, #E50914, #ff4d4d);
    }
    .icon-box {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(229,9,20,.1);
        color: #E50914;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
        transition: all 0.3s ease;
    }
    .info-row:hover .icon-box {
        background: #E50914;
        color: #fff;
        transform: scale(1.05);
    }
    
    /* CSS cho khung chứa Bản đồ Google */
    .google-map-wrapper {
        width: 100%;
        height: 100%;
        min-height: 450px;
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,.1);
        box-shadow: 0 20px 40px rgba(0,0,0,0.6);
        overflow: hidden;
        background: #121212; /* Nền tối phòng trường hợp iframe chưa tải kịp */
    }
    .google-map-wrapper iframe {
        width: 100%;
        height: 100%;
        border: 0;
        display: block;
    }
</style>

<!-- ============================================================ -->
<!-- HERO                                                         -->
<!-- ============================================================ -->
<section id="home" class="vr-hero">
    <div id="vrHeroBg" class="vr-hero-bg">
        <img src="@anhNen" alt="Xe sang" />
    </div>
    <div class="vr-hero-slice"></div>

    <div class="vr-hero-content">
        @if (laQuanTri)
        {
            <div class="vr-reveal">
                <div class="vr-slogan"><b>—</b> XIN CHÀO, @hoTen.ToUpper() <b>—</b></div>
                <h1 class="vr-hero-title">
                    BẢNG ĐIỀU KHIỂN<br />
                    <span class="vr-grad-text">HỆ THỐNG</span>
                </h1>
            </div>
            <p class="vr-hero-text vr-reveal" style="margin-top:32px; transition-delay:.1s;">
                Quản lý toàn diện hoạt động cho thuê xe: danh mục, đơn đặt xe, khách hàng, thanh toán và thống kê.
            </p>
            <div class="vr-hero-actions vr-reveal" style="transition-delay:.2s;">
                <a asp-controller="DatXe" asp-action="Index" class="vr-btn-red vr-pulse">
                    Xử lý đơn đặt xe <i class="fa-solid fa-arrow-right"></i>
                </a>
                <a href="#dashboard" class="vr-btn-ghost">Xem chức năng</a>
            </div>
        }
        else
        {
            <div class="vr-reveal">
                @if (laKhachHang)
                {
                    <div class="vr-slogan"><b>—</b> XIN CHÀO, @hoTen.ToUpper() <b>—</b></div>
                }
                <h1 class="vr-hero-title">
                    HỆ THỐNG QUẢN LÝ<br />
                    <span class="vr-grad-text">CHO THUÊ XE</span>
                </h1>
                @if (!laKhachHang)
                {
                    <div class="vr-slogan"><b>—</b> ĐẶT XE NHANH CHÓNG · THỦ TỤC MINH BẠCH <b>—</b></div>
                }
            </div>
            <p class="vr-hero-text vr-reveal" style="@(laKhachHang ? "margin-top:32px; " : "")transition-delay:.1s;">
                Tìm xe trống theo lịch, đặt xe trực tuyến, xác minh giấy tờ và theo dõi đơn thuê trong một hệ thống duy nhất.
            </p>
            <div class="vr-hero-actions vr-reveal" style="transition-delay:.2s;">
                @if (laKhachHang)
                {
                    <a href="#" data-vr-open="vrQuickModal" class="vr-btn-red vr-pulse">
                        Tìm xe trống ngay <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a asp-controller="DatXe" asp-action="DonCuaToi" class="vr-btn-ghost">Đơn của tôi</a>
                }
                else
                {
                    <a asp-controller="TaiKhoan" asp-action="DangNhap" class="vr-btn-red vr-pulse">
                        Đăng nhập để đặt xe <i class="fa-solid fa-arrow-right"></i>
                    </a>
                    <a href="#fleet" class="vr-btn-ghost">Xem bộ sưu tập xe</a>
                }
            </div>
        }
    </div>
</section>

@if (laQuanTri)
{
    <!-- ============================================================ -->
    <!-- BẢNG ĐIỀU KHIỂN (Admin / Nhân viên)                          -->
    <!-- ============================================================ -->
    <section id="dashboard" class="vr-section dark">
        <div class="vr-wrap">
            <div class="vr-head vr-reveal">
                <span class="vr-label">— @(vaiTro == VaiTro.Admin ? "QUẢN TRỊ VIÊN" : "NHÂN VIÊN") —</span>
                <h2 class="vr-h2">Chức năng quản lý</h2>
                <p class="vr-sub">Truy cập nhanh các phân hệ chính của hệ thống.</p>
            </div>

            <div class="vr-tiles">
                <a asp-controller="Xe" asp-action="Index" class="vr-tile vr-reveal">
                    <div class="vr-feat-ico"><i class="fa-solid fa-car-side"></i></div>
                    <h3>Quản lý danh mục</h3>
                    <p>Loại xe, Hãng xe, Xe, Bảng giá thuê</p>
                    <span class="vr-tile-go">Truy cập →</span>
                </a>
                <a asp-controller="DatXe" asp-action="Index" class="vr-tile vr-reveal" style="transition-delay:.1s;">
                    <div class="vr-feat-ico"><i class="fa-solid fa-clipboard-list"></i></div>
                    <h3>Nghiệp vụ</h3>
                    <p>Đơn đặt xe, Bàn giao, Trả xe, Thanh toán</p>
                    <span class="vr-tile-go">Truy cập →</span>
                </a>
                <a asp-controller="KhachHang" asp-action="Index" class="vr-tile vr-reveal" style="transition-delay:.2s;">
                    <div class="vr-feat-ico"><i class="fa-solid fa-users"></i></div>
                    <h3>Khách hàng</h3>
                    <p>Thông tin khách hàng và giấy tờ xác minh</p>
                    <span class="vr-tile-go">Truy cập →</span>
                </a>
                <a asp-controller="ThongKe" asp-action="Index" class="vr-tile vr-reveal" style="transition-delay:.3s;">
                    <div class="vr-feat-ico"><i class="fa-solid fa-chart-line"></i></div>
                    <h3>Thống kê</h3>
                    <p>Doanh thu, lượt thuê, hiệu suất khai thác</p>
                    <span class="vr-tile-go">Truy cập →</span>
                </a>
            </div>
        </div>
    </section>
}
else
{
    <!-- ============================================================ -->
    <!-- BỘ SƯU TẬP XE (dữ liệu thật)                                 -->
    <!-- ============================================================ -->
    <section id="fleet" class="vr-section dark">
        <div class="vr-wrap">
            <div class="vr-head vr-reveal">
                <span class="vr-label">— BỘ SƯU TẬP XE —</span>
                <h2 class="vr-h2">Xe đang sẵn sàng</h2>
                <p class="vr-sub">Những mẫu xe đang sẵn sàng cho thuê cùng đơn giá theo ngày.</p>

                @if (cacLoai.Count > 1)
                {
                    <div class="vr-filters">
                        <button type="button" class="vr-filter-btn active" data-filter="all">Tất cả xe</button>
                        @foreach (var loai in cacLoai)
                        {
                            <button type="button" class="vr-filter-btn" data-filter="@loai">@loai</button>
                        }
                    </div>
                }
            </div>

            <div class="vr-grid">
                @if (Model.XeNoiBat.Any())
                {
                    var stt = 0;
                    foreach (var xe in Model.XeNoiBat)
                    {
                        var delay = (stt % 3) * 0.1;
                        stt++;
                        <article class="vr-card vr-reveal" data-loai="@xe.TenLoaiXe"
                                 style="transition-delay:@(delay.ToString("0.0", CultureInfo.InvariantCulture))s;">
                            <div class="vr-card-img">
                                <i class="fa-solid fa-car-side"></i>
                                @if (!string.IsNullOrEmpty(xe.AnhXe))
                                {
                                    <img src="@xe.AnhXe" alt="@xe.TenXe" loading="lazy" onerror="this.style.display='none'" />
                                }
                                @if (!string.IsNullOrEmpty(xe.TenLoaiXe))
                                {
                                    <span class="vr-badge">@xe.TenLoaiXe</span>
                                }
                                <div class="vr-price"><b>@xe.DonGiaNgay.ToString("N0", vi)đ</b> / ngày</div>
                            </div>
                            <div class="vr-card-body">
                                <h3 class="vr-card-title">@xe.TenXe</h3>
                                <p class="vr-card-desc">@xe.TenHangXe@(string.IsNullOrEmpty(xe.MauSac) ? "" : " · " + xe.MauSac)</p>
                                <div class="vr-stats">
                                    <div><i class="fa-solid fa-users"></i>@xe.SoCho chỗ</div>
                                    <div><i class="fa-regular fa-calendar"></i>Năm @xe.NamSanXuat</div>
                                    <div><i class="fa-solid fa-circle-check"></i>Sẵn sàng</div>
                                </div>
                                <a asp-controller="DatXe" asp-action="DatXe" asp-route-maXe="@xe.MaXe" class="vr-card-btn">Đặt xe ngay</a>
                            </div>
                        </article>
                    }
                }
                else
                {
                    <div class="vr-empty">Hiện chưa có xe nào sẵn sàng. Vui lòng quay lại sau.</div>
                }
            </div>
        </div>
    </section>

    <!-- ============================================================ -->
    <!-- CHƯƠNG TRÌNH KHUYẾN MÃI                                      -->
    <!-- ============================================================ -->
    @if (khuyenMais != null && khuyenMais.Any())
    {
        <section id="promotions" class="vr-section black" style="padding: 60px 0;">
            <div class="vr-wrap">
                <div class="vr-head vr-reveal">
                    <span class="vr-label">— ƯU ĐÃI ĐẶC BIỆT —</span>
                    <h2 class="vr-h2">Khuyến mãi đang diễn ra</h2>
                    <p class="vr-sub">Nhập mã khi thanh toán để nhận ưu đãi.</p>
                </div>
                <div class="row g-4">
                    @foreach (var km in khuyenMais)
                    {
                        <div class="col-md-4">
                            <div class="p-4 h-100" style="background: linear-gradient(135deg, #1c1c1c, #0a0a0a); border-left: 4px solid #E50914; border-radius: 12px; display: flex; flex-direction: column; box-shadow: 0 10px 20px rgba(0,0,0,0.3); transition: transform 0.2s;" onmouseover="this.style.transform='translateY(-5px)'" onmouseout="this.style.transform='translateY(0)'">
                                <h5 class="text-white fw-bold mb-2">@km.TenChuongTrinh</h5>
                                <p class="text-muted small mb-3">@km.MoTa</p>
                                <div class="d-flex justify-content-between align-items-center mt-auto">
                                    <span class="badge bg-danger fs-6 px-3 py-2" style="letter-spacing: 1px;">@km.Code</span>
                                    <span class="text-warning small">HSD: @km.NgayKetThuc.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }

    <!-- ============================================================ -->
    <!-- GIỚI THIỆU                                                   -->
    <!-- ============================================================ -->
    <section id="about" class="vr-section black">
        <div class="vr-wrap">
            <div class="vr-about">
                <div class="vr-frame vr-reveal">
                    <div class="vr-frame-img">
                        <img src="@anhGioiThieu" alt="Chi tiết xe" />
                    </div>
                    <div class="vr-frame-glow"></div>
                </div>

                <div class="vr-reveal" style="transition-delay:.2s;">
                    <span class="vr-label">— VÌ SAO CHỌN CHÚNG TÔI —</span>
                    <h2 class="vr-h2 md">Thuê xe minh bạch,<br />theo dõi từng bước</h2>
                    <p class="vr-p">
                        Khách hàng tự đăng ký tài khoản, tải CCCD và giấy phép lái xe để nhân viên kiểm tra,
                        sau đó tìm xe trống theo đúng khung giờ cần thuê. Mọi đơn thuê đều được theo dõi
                        từ lúc đặt xe, bàn giao, trả xe đến thanh toán.
                    </p>

                    <div class="vr-feat">
                        <div class="vr-feat-ico"><i class="fa-solid fa-shield-halved"></i></div>
                        <div>
                            <h4>Xác minh giấy tờ rõ ràng</h4>
                            <p>CCCD và GPLX được nhân viên kiểm tra trước khi cho thuê xe.</p>
                        </div>
                    </div>
                    <div class="vr-feat">
                        <div class="vr-feat-ico"><i class="fa-solid fa-calendar-check"></i></div>
                        <div>
                            <h4>Không trùng lịch thuê</h4>
                            <p>Hệ thống tự loại các xe đã có đơn trong khoảng thời gian bạn chọn.</p>
                        </div>
                    </div>
                    <div class="vr-feat">
                        <div class="vr-feat-ico"><i class="fa-solid fa-receipt"></i></div>
                        <div>
                            <h4>Theo dõi đơn trực tuyến</h4>
                            <p>Xem trạng thái đơn và lịch sử thuê của bạn bất cứ lúc nào.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ============================================================ -->
    <!-- BẢN ĐỒ VỊ TRÍ CỬA HÀNG (GOOGLE MAPS - CÓ GHIM ĐỎ)            -->
    <!-- ============================================================ -->
    <section id="map-location" class="vr-section dark" style="padding: 80px 0; border-top: 1px solid rgba(255,255,255,.05); background: #0a0a0a;">
        <div class="vr-wrap">
            <div class="vr-head vr-reveal text-center" style="margin-bottom: 50px;">
                <span class="vr-label">— VỊ TRÍ CỬA HÀNG —</span>
                <h2 class="vr-h2">Ghé thăm UNETI Car Rental</h2>
                <p class="vr-sub">Chúng tôi luôn sẵn sàng phục vụ bạn tại địa chỉ dưới đây.</p>
            </div>

            <div class="row g-4 align-items-stretch justify-content-center">
                <!-- CỘT TRÁI: THÔNG TIN CỬA HÀNG -->
                <div class="col-lg-4">
                    <div class="info-card-map">
                        <h4 class="text-white fw-bold mb-4">Trụ sở chính</h4>
                        
                        <div class="d-flex align-items-start gap-3 mb-4 info-row">
                            <div class="icon-box">
                                <i class="fa-solid fa-location-dot"></i>
                            </div>
                            <div>
                                <h6 class="text-white mb-1">Địa chỉ</h6>
                                <p class="text-muted small mb-0">218 Lĩnh Nam, P. Hoàng Mai, Q. Hoàng Mai, TP. Hà Nội (Trường ĐH Kinh tế - Kỹ thuật Công nghiệp)</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start gap-3 mb-4 info-row">
                            <div class="icon-box">
                                <i class="fa-solid fa-phone"></i>
                            </div>
                            <div>
                                <h6 class="text-white mb-1">Hotline</h6>
                                <p class="text-muted small mb-0">1900 6868</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start gap-3 mb-4 info-row">
                            <div class="icon-box">
                                <i class="fa-regular fa-clock"></i>
                            </div>
                            <div>
                                <h6 class="text-white mb-1">Giờ mở cửa</h6>
                                <p class="text-muted small mb-0">Thứ 2 - Chủ Nhật<br />07:00 AM - 22:00 PM</p>
                            </div>
                        </div>

                        <div class="mt-auto pt-3">
                            <a href="https://www.google.com/maps/dir/?api=1&destination=20.980583356782315,105.87587610445243" target="_blank" class="vr-btn-red full text-decoration-none text-center d-block py-3">
                                <i class="fa-solid fa-diamond-turn-right me-2"></i> Lấy chỉ đường
                            </a>
                        </div>
                    </div>
                </div>

                <!-- CỘT PHẢI: BẢN ĐỒ GOOGLE MAPS -->
                <div class="col-lg-8">
                    <div class="google-map-wrapper">
                        <!-- Link nhúng Google Maps có Ghim đỏ chính xác -->
                        <iframe 
                            src="https://maps.google.com/maps?q=20.980583356782315,105.87587610445243&hl=vi&z=16&output=embed" 
                            allowfullscreen="" 
                            loading="lazy" 
                            referrerpolicy="no-referrer-when-downgrade">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>
}

@if (laKhachHang)
{
    <!-- ============================================================ -->
    <!-- MODAL: TÌM XE TRỐNG NHANH                                    -->
    <!-- ============================================================ -->
    <div id="vrQuickModal" class="vr-modal" aria-hidden="true">
        <div class="vr-modal-box">
            <button type="button" class="vr-modal-close" data-vr-close aria-label="Đóng">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <span class="vr-label">— TÌM XE TRỐNG —</span>
            <h3 class="vr-modal-title">Đặt xe nhanh</h3>

            <form asp-controller="DatXe" asp-action="TimXeTrong" method="post">
                <div class="vr-two">
                    <div class="vr-field">
                        <label for="qNhan">Thời gian nhận</label>
                        <input id="qNhan" name="ThoiGianNhan" type="datetime-local" class="vr-input" value="@ngayNhanMacDinh" required />
                    </div>
                    <div class="vr-field">
                        <label for="qTra">Thời gian trả</label>
                        <input id="qTra" name="ThoiGianTra" type="datetime-local" class="vr-input" value="@ngayTraMacDinh" required />
                    </div>
                </div>
                <button type="submit" class="vr-btn-red full">Tìm xe trống</button>
            </form>
        </div>
    </div>
}

@section Scripts {
    <!-- Không cần script khởi tạo bản đồ vì Google Maps iframe tự xử lý -->
}